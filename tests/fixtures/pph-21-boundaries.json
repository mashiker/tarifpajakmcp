    {
      "id": "nonresident-no-treaty",
      "description": "Nonresident without treaty: fixed 20% (UU PPh Pasal 26). Conditional rule with condition resident=false and treaty=no.",
      "date": "2024-06-01",
      "request": { "conceptId": "concept-pph-21-recipient-nonresident", "facts": { "resident": false, "treaty": "none" } },
