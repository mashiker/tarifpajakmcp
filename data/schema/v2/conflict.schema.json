{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V2 declared source conflict",
  "type": "object",
  "required": ["id", "kind", "ruleIds", "description"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["rate", "interval", "condition", "scope"] },
    "ruleIds": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "minLength": 1 },
    "declaredAt": { "type": "string", "format": "date" }
  },
  "additionalProperties": true
}
