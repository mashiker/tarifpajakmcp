    {
      "id": "pajak-daerah-hotel",
      "category": "Pajak Daerah",
      "taxType": "Pajak Daerah",
      "transactionType": "Pajak Hotel",
      "description": "Pajak atas pelayanan hotel. UU 1/2022 hanya menetapkan tarif maksimum 10% (tidak ada tarif minimum); besaran pastinya ditetapkan Perda.",
      "rate": {
        "type": "percentage",
        "value": 10,
        "effectiveRate": "Tarif maksimum 10% (Pasal 58 UU 1/2022); Perda menetapkan s.d. 10%, umumnya 10% hotel berbintang"
      },
      "taxBase": "Penerimaan hotel",
      "payer": "WP Daerah",
      "recipient": "Pemerintah Daerah",
      "withholder": null,
      "effectiveFrom": "2022-01-01",
      "effectiveTo": null,
      "status": "berlaku",
      "legalBasis": [
        {
          "regulation": "UU 1/2022 (HKPD)",
          "article": "Pasal 58 ayat (1)",
          "sourceUrl": "https://peraturan.bpk.go.id/Details/189054/uu-no-1-tahun-2022"
        }
      ],
      "supersedes": [],
      "supersededBy": [],
      "notes": "Tarif maksimum 10% dari penerimaan. UU 1/2022 tidak menetapkan minimum; tarif ditetapkan Perda dalam koridor maksimum tersebut. Ketentuan PBJT UU 1/2022 berlaku penuh sejak 5 Januari 2023.",
      "examples": [
        {
          "scenario": "Hotel bintang 4 Rp 2.000.000/malam",
          "calculation": "10%×2jt",
          "result": "Pajak=R200.000"
        }
      ],
      "tags": [
        "pajak-daerah",
        "hotel"
      ],
      "lastVerified": "2026-05-28"
    },
