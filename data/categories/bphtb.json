          "regulation": "UU 1/2022 (HKPD)",
          "article": "Pasal 78-82",
          "sourceUrl": "https://peraturan.bpk.go.id/Details/189054/uu-no-1-tahun-2022"
        }
      ],
      "supersedes": [],
      "supersededBy": [],
      "notes": "NPOPTKP = Rp 80.000.000 (perorangan) atau Rp 80.000.000 × jumlah penerima hak (waris). NPOP minimum = NJOP. Tarif 5% × (NPOP - NPOPTKP).",
      "examples": [
        {
          "scenario": "Membeli rumah NPOP Rp 1.000.000.000",
          "calculation": "5% × (1.000.000.000 - 80.000.000)",
          "result": "BPHTB = Rp 46.000.000"
        }
      ],
