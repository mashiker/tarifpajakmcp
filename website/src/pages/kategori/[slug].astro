---
import BaseLayout from '../../layouts/Base.astro';
import fs from 'fs';
import path from 'path';
import { buildDatabaseDataset } from '../../lib/dataset.ts';

// Task 9: emit routes for BOTH the legacy v1 category slugs (byte-stable) and
// the v2-only category slugs that the new database surfaces (pph-final-umkm,
// pph-special-regimes). The v2-only routes render an index/navigation page that
// deep-links to the v2 detail URLs, while the v1 routes keep their existing
// detailed entry rendering unchanged.
export function getStaticPaths() {
  const raw = JSON.parse(fs.readFileSync(path.resolve('public/api.json'), 'utf-8'));
  const v1Slugs = new Set(
    raw.categories.map((c: any) => c.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-')),
  );
  // Load the v2 corpus to discover v2-only category slugs.
  const corpus = JSON.parse(fs.readFileSync(path.resolve('public/api/v2/rules-corpus.json'), 'utf-8'));
  const dataset = buildDatabaseDataset(corpus);
  const v2OnlySlugs = dataset.categories
    .map((c: { slug: string }) => c.slug)
    .filter((s: string) => !v1Slugs.has(s));
  const paths: { params: { slug: string } }[] = [
    ...raw.categories.map((c: any) => ({ params: { slug: c.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-') } })),
    ...v2OnlySlugs.map((s: string) => ({ params: { slug: s } })),
  ];
  return paths;
}
const api = JSON.parse(fs.readFileSync(path.resolve('public/api.json'), 'utf-8'));
const slug = Astro.params.slug!;
function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-'); }
const category = api.categories.find((c: any) => toSlug(c.taxType) === slug);

// V2-only category fallback: render an index/navigation page that deep-links to
// the v2 detail URLs. This handles pph-final-umkm and pph-special-regimes
// (Task 9 BPPU/category index requirement) without disturbing the byte-stable
// v1 category pages. The actual rendering happens in the template body via a
// conditional, because Astro frontmatter cannot return JSX.
const corpus = JSON.parse(fs.readFileSync(path.resolve('public/api/v2/rules-corpus.json'), 'utf-8'));
const dataset = buildDatabaseDataset(corpus);
const v2Category = dataset.categories.find((c: { slug: string }) => c.slug === slug);
const v2RowsForCategory = dataset.rows.filter((r: { category: string }) => r.category === slug);
const isV2OnlyCategory = !category && !!v2Category;
const v2CatName = v2Category?.name ?? slug;
const v2CatDesc = (() => {
  const c = corpus.data.categories.find((x: { slug: string }) => x.slug === slug);
  return c?.description ?? '';
})();
// Group v2 rows by concept id so each concept appears once with its chronology.
const v2ConceptIds = [...new Set(v2RowsForCategory.map((r: { id: string }) => r.id))].sort();
const v2RowsByConcept = new Map<string, typeof v2RowsForCategory>();
for (const r of v2RowsForCategory) {
  const arr = v2RowsByConcept.get(r.id) ?? [];
  arr.push(r);
  v2RowsByConcept.set(r.id, arr);
}
if (!category && !isV2OnlyCategory) return Astro.redirect('/404');

const sb: Record<string, string> = { berlaku: 'badge-berlaku', dicabut: 'badge-dicabut', diubah: 'badge-diubah', belum_berlaku: 'badge-belum-berlaku' };
const sl: Record<string, string> = { berlaku: 'Berlaku', dicabut: 'Dicabut', diubah: 'Diubah', belum_berlaku: 'Belum' };

function fmtRate(r: any, entry?: any): string {
  if (r.type === 'percentage') return `${r.value}%`;
  if (r.type === 'range') return `${r.value[0]}–${r.value[1]}%`;
  if (r.type === 'progressive' && r.brackets) {
    if (r.brackets.length > 10) {
      const rates = r.brackets.map((b: any) => b.rate);
      const min = Math.min(...rates);
      const max = Math.max(...rates);
      return `${min}%–${max}% (${r.brackets.length} lapisan)`;
    }
    return r.brackets.map((b: any) => `${b.rate}%`).join('/');
  }
  return String(r.value);
}

const activeCount = category ? category.entries.filter((e: any) => e.status === 'berlaku').length : 0;
const totalBppu = category ? category.entries.reduce((s: number, e: any) => s + (e.bppuKode?.length || 0), 0) : 0;
const allSlugs = api.categories.map((c: any) => toSlug(c.taxType));
const ci = allSlugs.indexOf(slug);
const prev = ci > 0 ? api.categories[ci - 1] : null;
const next = ci < api.categories.length - 1 ? api.categories[ci + 1] : null;
---

{isV2OnlyCategory ? (
  <BaseLayout title={`${v2CatName} - Tarif Pajak`} activeNav="home" wide={true} fullWidth={true} canonicalPath={`/kategori/${slug}`}>
    <nav class="v2cat-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Database</a>
      <span aria-hidden="true">›</span>
      <span class="v2cat-breadcrumb-current">{v2CatName}</span>
    </nav>
    <header class="v2cat-header">
      <div>
        <h1 class="v2cat-title">{v2CatName}</h1>
        <p class="v2cat-subtitle">{v2Category!.count} aturan · {v2ConceptIds.length} konsep</p>
        {v2CatDesc && <p class="v2cat-desc">{v2CatDesc}</p>}
      </div>
      <a href={`/?category=${encodeURIComponent(slug)}`} class="v2cat-filter-link">Buka di database &rarr;</a>
    </header>
    <ul class="v2cat-list">
      {v2ConceptIds.map((cid: string) => {
        const rules = v2RowsByConcept.get(cid)!;
        const first = rules[0];
        const latest = rules[rules.length - 1];
        return (
          <li class="v2cat-item">
            <a href={`/tarif/${encodeURIComponent(cid)}`} class="v2cat-item-link">
              <span class="v2cat-item-name">{first.name}</span>
              <span class="v2cat-item-rate">{first.rate}</span>
              <span class="v2cat-item-chronology">{rules.length} aturan dalam kronologi</span>
              <span class="v2cat-item-interval">
                {first.validFrom.slice(0, 10)} → {latest.validToExclusive ? latest.validToExclusive.slice(0, 10) : 'sekarang'}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <style is:inline>
      .v2cat-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; font-size: 0.75rem; color: var(--ink-tertiary, var(--text-tertiary)); margin-bottom: 0.75rem; }
      .v2cat-breadcrumb a { color: var(--ink-secondary, #44545a); text-decoration: none; }
      .v2cat-breadcrumb a:hover { color: #0E5E58; text-decoration: underline; }
      .v2cat-breadcrumb-current { color: var(--ink, #132A2A); font-weight: 600; }
      .v2cat-header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start; justify-content: space-between; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule, #D9E0DC); }
      .v2cat-title { font-size: 1.375rem; font-weight: 700; color: var(--ink, #132A2A); margin: 0; letter-spacing: -0.01em; }
      .v2cat-subtitle { font-size: 0.75rem; color: var(--ink-tertiary, var(--text-tertiary)); margin: 0.25rem 0 0; font-family: 'IBM Plex Mono', monospace; }
      .v2cat-desc { font-size: 0.8125rem; color: var(--ink-secondary, #44545a); margin: 0.5rem 0 0; line-height: 1.5; max-width: 70ch; }
      .v2cat-filter-link { display: inline-block; padding: 0.375rem 0.75rem; border: 1px solid var(--rule, #D9E0DC); border-radius: 0.5rem; background: var(--surface, #FFFFFF); color: #0E5E58; text-decoration: none; font-size: 0.75rem; font-weight: 600; flex-shrink: 0; }
      .v2cat-filter-link:hover { border-color: #0E5E58; text-decoration: underline; }
      .v2cat-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
      .v2cat-item { border: 1px solid var(--rule, #D9E0DC); border-radius: 0.5rem; background: var(--surface, #FFFFFF); }
      .v2cat-item-link { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 0.75rem; padding: 0.625rem 0.875rem; text-decoration: none; color: inherit; }
      .v2cat-item-link:hover { background: var(--surface-alt, #EFF1EC); }
      .v2cat-item-name { flex: 1 1 18rem; font-weight: 600; color: var(--ink, #132A2A); font-size: 0.875rem; }
      .v2cat-item-rate { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: #0E5E58; font-size: 0.875rem; }
      .v2cat-item-chronology { font-size: 0.6875rem; color: var(--ink-tertiary, var(--text-tertiary)); font-family: 'IBM Plex Mono', monospace; }
      .v2cat-item-interval { font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; color: var(--ink-secondary, #44545a); }
      :global(html.dark) .v2cat-item { background: var(--surface); border-color: var(--border); }
      :global(html.dark) .v2cat-item-link:hover { background: var(--surface-alt); }
      :global(html.dark) .v2cat-title, :global(html.dark) .v2cat-item-name { color: var(--text); }
      :global(html.dark) .v2cat-subtitle, :global(html.dark) .v2cat-item-interval { color: var(--text-secondary); }
      @media (prefers-reduced-motion: reduce) { .v2cat-filter-link, .v2cat-item-link { transition: none; } }
    </style>
  </BaseLayout>
) : (
  <BaseLayout title={`${category.taxType} - Tarif Pajak`} canonicalPath={`/kategori/${slug}`}>
  <nav class="flex items-center gap-1.5 text-xs mb-6 text-[var(--text-tertiary)]">
    <a href="/" class="hover:text-[var(--text)] transition-colors">Beranda</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-[var(--text)] font-medium">{category.taxType}</span>
  </nav>

  <div class="flex items-start justify-between gap-4 mb-6 flex-wrap">
    <div>
      <h1 class="text-xl font-bold text-[var(--text)] tracking-tight">{category.taxType}</h1>
      <p class="text-sm text-[var(--text-secondary)] mt-1 max-w-2xl">{category.description}</p>
    </div>
    <div class="shrink-0 flex gap-2">
      <span class="bg-[var(--accent-soft)] text-[var(--accent)] px-3 py-1.5 rounded-xl text-xs font-semibold ring-1 ring-[var(--accent)]/20">{activeCount} aktif</span>
      <span class="bg-[var(--surface-alt)] text-[var(--text-secondary)] px-3 py-1.5 rounded-xl text-xs font-semibold ring-1 ring-[var(--border)]">{category.entries.length} total</span>
    </div>
  </div>
  {totalBppu > 0 && (
    <a href="/kode-objek-pajak" class="inline-flex items-center gap-1.5 text-xs text-[var(--text)] hover:underline font-medium mb-6">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path></svg>
      {totalBppu} kode BPPU terkait
    </a>
  )}

  {category.serviceTypes?.services && (
    <details class="card mb-6" open={category.serviceTypes.services.length <= 15}>
      <summary class="px-4 py-3 bg-[var(--surface-alt)] rounded-t-2xl border-b border-[var(--border)] flex items-center justify-between cursor-pointer hover:bg-[var(--surface-alt)] transition-colors">
        <span class="text-sm font-semibold text-[var(--text)]">{category.serviceTypes.services.length} Jenis Jasa</span>
        <a href={category.serviceTypes.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-[11px] text-[var(--text)] hover:underline font-mono">{category.serviceTypes.source} ↗</a>
      </summary>
      <div class="p-4 max-h-60 overflow-y-auto custom-scrollbar">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1">
          {category.serviceTypes.services.map((s: any) => (
            <div class="flex gap-1.5 py-0.5"><span class="text-[var(--text-tertiary)] font-mono text-[11px] min-w-[1.5rem] shrink-0">{s.code}.</span><span class="text-sm text-[var(--text-secondary)]">{s.name}</span></div>
          ))}
        </div>
      </div>
    </details>
  )}

  <div class="space-y-3">
    {category.entries.map((entry: any, idx: number) => {
      const isOpen = entry.status === 'berlaku' || idx < 3;
      return (
      <details class="card overflow-hidden group" open={isOpen}>
        <summary class="px-4 py-3 hover:bg-[var(--surface-alt)] transition-colors">
          <div class="flex items-center justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <h3 class="text-sm sm:text-base font-semibold text-[var(--text)]">{entry.transactionType}</h3>
                <span class={`badge ${sb[entry.status] || 'badge-belum-berlaku'}`}>{sl[entry.status]}</span>
              </div>
              <div class="flex items-center gap-4 text-xs text-[var(--text-tertiary)] flex-wrap">
                <span class="rate-value text-base">{fmtRate(entry.rate)}</span>
                <span class="font-mono">{entry.effectiveFrom} → {entry.effectiveTo || 'sekarang'}</span>
                {entry.bppuKode?.length > 0 && <span class="text-[var(--text)] font-mono">{entry.bppuKode.length} BPPU</span>}
              </div>
            </div>
            <svg class="w-4 h-4 text-[var(--text-tertiary)] shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </summary>
        <div class="px-4 pb-4 border-t border-[var(--border)]">
          <p class="text-sm text-[var(--text-secondary)] mt-3 mb-4">{entry.description}</p>
          {entry.id?.startsWith('pph-21-ter-') && (
            <a href="/ter-pph-21" class="inline-flex items-center gap-2 bg-[var(--surface-alt)] border border-[var(--border)] text-[var(--text)] rounded-2xl px-4 py-2.5 text-xs font-medium hover:bg-[var(--surface-alt)] transition-colors mb-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
              Lihat tabel lengkap dengan kalkulator TER →
            </a>
          )}

          <div class="bg-[var(--surface-alt)] rounded-2xl p-4 mb-4">
            <div class="flex items-baseline gap-3 flex-wrap">
              <span class="rate-value-lg">{fmtRate(entry.rate)}</span>
              {entry.rate.effectiveRate && (
                <span class="text-xs text-[var(--text-tertiary)] bg-[var(--surface)] px-2.5 py-1 rounded-xl border border-[var(--border)]">Tarif efektif: {entry.rate.effectiveRate}</span>
              )}
            </div>
            <div class="text-sm text-[var(--text-tertiary)] mt-2">Dasar pengenaan: <span class="text-[var(--text)]">{entry.taxBase}</span></div>
          </div>

          {entry.rate.brackets && (
            <div class="mb-4 border border-[var(--border)] rounded-2xl overflow-hidden">
              <table class="data-table">
                <thead><tr><th>Lapisan</th><th class="text-right">Batas Bawah</th><th class="text-right">Batas Atas</th><th class="text-right">Tarif</th></tr></thead>
                <tbody>
                  {entry.rate.brackets.map((b: any, i: number) => (
                    <tr>
                      <td class="text-[var(--text-secondary)]">{i + 1}</td>
                      <td class="text-right font-mono">Rp {(b.min / 1e6).toLocaleString('id')} jt</td>
                      <td class="text-right font-mono">{b.max ? `Rp ${(b.max / 1e6).toLocaleString('id')} jt` : '∞'}</td>
                      <td class="text-right"><span class="rate-value">{b.rate}%</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
            <div><div class="text-[11px] text-[var(--text-tertiary)] mb-0.5 font-medium uppercase">Wajib Pajak</div><div class="text-sm text-[var(--text)]">{entry.payer}</div></div>
            <div><div class="text-[11px] text-[var(--text-tertiary)] mb-0.5 font-medium uppercase">Penerima</div><div class="text-sm text-[var(--text)]">{entry.recipient}</div></div>
            {entry.withholder && <div><div class="text-[11px] text-[var(--text-tertiary)] mb-0.5 font-medium uppercase">Pemotong</div><div class="text-sm text-[var(--text)]">{entry.withholder}</div></div>}
            <div><div class="text-[11px] text-[var(--text-tertiary)] mb-0.5 font-medium uppercase">Berlaku</div><div class="text-sm text-[var(--text)] font-mono">{entry.effectiveFrom} → {entry.effectiveTo || 'sekarang'}</div></div>
          </div>

          {entry.bppuKode?.length > 0 && (
            <div class="border-t border-[var(--border)] pt-4 mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-[var(--text)]">Kode BPPU ({entry.bppuKode.length})</span>
                <a href="/kode-objek-pajak" class="text-[11px] text-[var(--text)] hover:underline">Lihat semua ↗</a>
              </div>
              {entry.bppuKode.length <= 12 ? (
                <div class="flex flex-wrap gap-1.5">
                  {entry.bppuKode.map((b: any) => (
                    <span class="inline-flex items-center gap-1.5 bg-[var(--surface-alt)] border border-[var(--border)] rounded-xl px-2.5 py-1 text-xs">
                      <span class="font-mono font-bold text-[var(--text)]">{b.kode}</span>
                      <span class="text-[var(--text-tertiary)] font-mono">{b.tarif}%</span>
                    </span>
                  ))}
                </div>
              ) : (
                <div class="border border-[var(--border)] rounded-2xl overflow-hidden max-h-64 overflow-y-auto custom-scrollbar">
                  <table class="data-table">
                    <thead><tr><th>Kode</th><th>Nama</th><th class="text-right">Tarif</th></tr></thead>
                    <tbody>
                      {entry.bppuKode.map((b: any) => (
                        <tr><td class="font-mono font-bold text-[var(--text)] whitespace-nowrap">{b.kode}</td><td class="cell-wrap text-sm" style="white-space:normal;max-width:350px">{b.nama}</td><td class="text-right"><span class="rate-value">{b.tarif}%</span></td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}

          <div class="border-t border-[var(--border)] pt-4">
            <div class="text-[11px] text-[var(--text-tertiary)] mb-1.5 font-bold uppercase tracking-wider">Dasar Hukum</div>
            <div class="flex flex-wrap gap-1.5">
              {entry.legalBasis.map((lb: any) => (
                <a href={lb.sourceUrl || lb.pasalUrl || '#'} target="_blank" rel="noopener noreferrer" class="tag">
                  <span class="text-[var(--text)] font-semibold">{lb.regulation}</span>
                  <span class="text-[var(--text-tertiary)]">{lb.article}</span>
                  {(lb.sourceUrl || lb.pasalUrl) && <span class="text-[var(--text-tertiary)]">↗</span>}
                </a>
              ))}
            </div>
          </div>

          {entry.notes && (
            <div class="mt-4 flex gap-2.5 bg-amber-50 dark:bg-amber-900/20 border border-amber-200/60 dark:border-amber-800/40 rounded-2xl p-4">
              <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div class="text-sm text-amber-800 dark:text-amber-200">{entry.notes.substring(0, 500)}{entry.notes.length > 500 ? '...' : ''}</div>
            </div>
          )}

          {entry.examples?.length > 0 && (
            <div class="mt-4 border-t border-[var(--border)] pt-4">
              <div class="text-[11px] text-[var(--text-tertiary)] mb-2 font-bold uppercase tracking-wider">Contoh Perhitungan</div>
              <div class="space-y-2">
                {entry.examples.map((ex: any) => (
                  <div class="bg-[var(--accent-soft)] border border-[var(--accent)]/20 rounded-2xl p-4">
                    <div class="text-sm font-medium text-[var(--text)] mb-1">{ex.scenario}</div>
                    <div class="text-xs text-[var(--accent)] mb-1.5">{ex.calculation}</div>
                    <div class="text-sm text-[var(--accent)] font-bold font-mono">→ {ex.result}</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </details>
    );})}
  </div>

  <div class="mt-8 flex justify-between gap-4">
    {prev ? <a href={`/kategori/${toSlug(prev.taxType)}`} class="btn-secondary"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>{prev.taxType}</a> : <div></div>}
    {next ? <a href={`/kategori/${toSlug(next.taxType)}`} class="btn-secondary">{next.taxType}<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a> : <div></div>}
  </div>
</BaseLayout>
)}
