---
import BaseLayout from '../../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const raw = JSON.parse(fs.readFileSync(path.resolve('public/api.json'), 'utf-8'));
  return raw.categories.map((c: any) => ({
    params: { slug: c.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-') }
  }));
}

const apiPath = path.resolve('public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));
const slug = Astro.params.slug!;

function toSlug(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
}

const category = api.categories.find((c: any) => toSlug(c.taxType) === slug);
if (!category) return Astro.redirect('/404');

const statusBadge: Record<string, string> = {
  'berlaku': 'badge-berlaku', 'dicabut': 'badge-dicabut', 'diubah': 'badge-diubah', 'belum_berlaku': 'badge-belum-berlaku',
};
const statusLabel: Record<string, string> = {
  'berlaku': '✓ Berlaku', 'dicabut': '✗ Dicabut', 'diubah': '⟳ Diubah', 'belum_berlaku': '○ Belum',
};

function formatRate(rate: any): string {
  if (rate.type === 'percentage') return `${rate.value}%`;
  if (rate.type === 'range') return `${rate.value[0]}%–${rate.value[1]}%`;
  if (rate.type === 'progressive' && rate.brackets) return rate.brackets.map((b: any) => `${b.rate}%`).join('/');
  return String(rate.value);
}

const totalBppu = category.entries.reduce((sum: number, e: any) => sum + (e.bppuKode?.length || 0), 0);
const activeCount = category.entries.filter((e: any) => e.status === 'berlaku').length;
const allSlugs = api.categories.map((c: any) => toSlug(c.taxType));
const currentIndex = allSlugs.indexOf(slug);
const prevCat = currentIndex > 0 ? api.categories[currentIndex - 1] : null;
const nextCat = currentIndex < api.categories.length - 1 ? api.categories[currentIndex + 1] : null;
---

<BaseLayout title={`${category.taxType} - Tarif Pajak`}>
  <nav class="flex items-center gap-2 text-[11px] mb-3">
    <a href="/" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">Beranda</a>
    <svg class="w-3 h-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-gray-700 dark:text-gray-300 font-medium">{category.taxType}</span>
  </nav>

  <!-- Header -->
  <div class="flex items-center justify-between gap-3 mb-4">
    <div>
      <h1 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-50">{category.taxType}</h1>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 max-w-xl">{category.description}</p>
    </div>
    <div class="flex gap-1.5 shrink-0">
      <span class="bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 px-2 py-0.5 rounded text-[11px] font-medium">{activeCount} aktif</span>
      <span class="bg-gray-100 dark:bg-gray-800 text-gray-500 px-2 py-0.5 rounded text-[11px] font-medium">{category.entries.length} total</span>
    </div>
  </div>
  {totalBppu > 0 && (
    <a href="/kode-objek-pajak" class="inline-flex items-center gap-1 text-[11px] text-brand-600 dark:text-brand-400 hover:underline font-mono mb-3">→ {totalBppu} kode BPPU terkait</a>
  )}

  <!-- Service Types -->
  {category.serviceTypes && category.serviceTypes.services && (
    <details class="card mb-4" open={category.serviceTypes.services.length <= 20}>
      <summary class="bg-gray-50 dark:bg-gray-800 px-4 py-2.5 cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-750 transition-colors flex items-center justify-between text-xs font-semibold text-gray-700 dark:text-gray-300">
        <span>{category.serviceTypes.services.length} Jenis Jasa</span>
        <a href={category.serviceTypes.sourceUrl} target="_blank" class="text-[10px] text-brand-600 dark:text-brand-400 hover:underline font-mono">{category.serviceTypes.source} ↗</a>
      </summary>
      <div class="p-3 max-h-52 overflow-y-auto custom-scrollbar">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-0.5">
          {category.serviceTypes.services.map((svc: any) => (
            <div class="flex items-start gap-1 py-0.5">
              <span class="text-gray-400 font-mono text-[10px] min-w-[1.5rem] shrink-0">{svc.code}.</span>
              <span class="text-xs text-gray-600 dark:text-gray-400">{svc.name}</span>
            </div>
          ))}
        </div>
      </div>
    </details>
  )}

  <!-- Entries -->
  <div class="space-y-2">
    {category.entries.map((entry: any, idx: number) => {
      const isOpen = idx < 5 || entry.status === 'berlaku';
      return (
      <details class="card overflow-hidden group" open={isOpen}>
        <summary class="px-4 py-3 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
          <div class="flex items-center justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-gray-900 dark:text-gray-100">{entry.transactionType}</span>
                <span class={`badge ${statusBadge[entry.status] || 'badge-belum-berlaku'} text-[10px]`}>{statusLabel[entry.status]}</span>
              </div>
              <div class="flex items-center gap-3 mt-1">
                <span class="rate-value text-sm">{formatRate(entry.rate)}</span>
                <span class="text-[10px] text-gray-400 font-mono">{entry.effectiveFrom}{entry.effectiveTo ? ` → ${entry.effectiveTo}` : ' → sekarang'}</span>
                {entry.bppuKode && entry.bppuKode.length > 0 && (
                  <span class="text-[10px] text-brand-600 dark:text-brand-400 font-mono">{entry.bppuKode.length} BPPU</span>
                )}
              </div>
            </div>
            <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </summary>
        <div class="px-4 pb-4 border-t border-gray-100 dark:border-gray-800 pt-3">
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">{entry.description}</p>

          <!-- Rate Box -->
          <div class="bg-gray-50 dark:bg-gray-800 rounded-md p-3 mb-3">
            <div class="flex items-baseline gap-2">
              <span class="rate-value-lg">{formatRate(entry.rate)}</span>
              {entry.rate.effectiveRate && (
                <span class="text-[10px] text-gray-400 bg-white dark:bg-gray-900 px-1.5 py-0.5 rounded border border-gray-200 dark:border-gray-700">
                  efektif: {entry.rate.effectiveRate}
                </span>
              )}
            </div>
            <div class="text-[11px] text-gray-400 mt-1">Dasar: {entry.taxBase}</div>
          </div>

          <!-- Brackets -->
          {entry.rate.brackets && (
            <div class="mb-3 overflow-x-auto custom-scrollbar border border-gray-200 dark:border-gray-700 rounded-md">
              <table class="data-table text-xs">
                <thead><tr><th>Lapis</th><th class="text-right">Bawah</th><th class="text-right">Atas</th><th class="text-right">Tarif</th></tr></thead>
                <tbody>
                  {entry.rate.brackets.map((b: any, i: number) => (
                    <tr>
                      <td class="text-gray-500">{i + 1}</td>
                      <td class="text-right font-mono">Rp {(b.min / 1000000).toLocaleString('id')} jt</td>
                      <td class="text-right font-mono">{b.max ? `Rp ${(b.max / 1000000).toLocaleString('id')} jt` : '∞'}</td>
                      <td class="text-right"><span class="rate-value">{b.rate}%</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <!-- Details -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs mb-3">
            <div><div class="text-[10px] text-gray-400">Wajib Pajak</div><div class="text-gray-700 dark:text-gray-300">{entry.payer}</div></div>
            <div><div class="text-[10px] text-gray-400">Penerima</div><div class="text-gray-700 dark:text-gray-300">{entry.recipient}</div></div>
            {entry.withholder && <div><div class="text-[10px] text-gray-400">Pemotong</div><div class="text-gray-700 dark:text-gray-300">{entry.withholder}</div></div>}
            <div><div class="text-[10px] text-gray-400">Berlaku</div><div class="text-gray-700 dark:text-gray-300 font-mono">{entry.effectiveFrom}{entry.effectiveTo ? ` → ${entry.effectiveTo}` : ' → sekarang'}</div></div>
          </div>

          <!-- BPPU -->
          {entry.bppuKode && entry.bppuKode.length > 0 && (
            <div class="border-t border-gray-100 dark:border-gray-800 pt-3 mb-3">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-[11px] font-semibold text-gray-500">Kode BPPU ({entry.bppuKode.length})</span>
                <a href="/kode-objek-pajak" class="text-[10px] text-brand-600 dark:text-brand-400 hover:underline">Semua ↗</a>
              </div>
              {entry.bppuKode.length <= 10 ? (
                <div class="flex flex-wrap gap-1">
                  {entry.bppuKode.map((b: any) => (
                    <span class="inline-flex items-center gap-1 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded px-1.5 py-0.5 text-[11px] font-mono">
                      <span class="text-gray-900 dark:text-gray-100 font-medium">{b.kode}</span>
                      <span class="text-gray-400">{b.tarif}%</span>
                    </span>
                  ))}
                </div>
              ) : (
                <div class="overflow-x-auto custom-scrollbar border border-gray-200 dark:border-gray-700 rounded-md max-h-48">
                  <table class="data-table text-xs">
                    <thead><tr><th>Kode</th><th>Nama</th><th class="text-right">Tarif</th></tr></thead>
                    <tbody>
                      {entry.bppuKode.map((b: any) => (
                        <tr>
                          <td class="font-mono font-medium text-gray-900 dark:text-gray-100 whitespace-nowrap">{b.kode}</td>
                          <td class="cell-wrap" style="white-space:normal;max-width:300px;font-size:11px">{b.nama}</td>
                          <td class="text-right"><span class="rate-value">{b.tarif}%</span></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}

          <!-- Legal Basis -->
          <div class="border-t border-gray-100 dark:border-gray-800 pt-3">
            <div class="text-[10px] text-gray-400 mb-1 font-medium uppercase tracking-wide">Dasar Hukum</div>
            <div class="flex flex-wrap gap-1">
              {entry.legalBasis.map((lb: any) => (
                <a href={lb.sourceUrl || lb.pasalUrl || '#'} target="_blank" class="tag text-[10px]">
                  <span class="text-brand-600 dark:text-brand-400">{lb.regulation}</span>
                  <span class="text-gray-400">{lb.article}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Notes -->
          {entry.notes && (
            <div class="mt-3 text-xs text-gray-500 dark:text-gray-400 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-md p-2.5 flex gap-2">
              <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div>{entry.notes.substring(0, 400)}{entry.notes.length > 400 ? '...' : ''}</div>
            </div>
          )}

          <!-- Examples -->
          {entry.examples && entry.examples.length > 0 && (
            <div class="mt-3 border-t border-gray-100 dark:border-gray-800 pt-3">
              <div class="text-[10px] text-gray-400 mb-1.5 font-medium uppercase tracking-wide">Contoh Perhitungan</div>
              <div class="grid gap-2">
                {entry.examples.map((ex: any) => (
                  <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800/30 rounded-md p-2.5">
                    <div class="text-xs text-gray-700 dark:text-gray-300 mb-0.5">{ex.scenario}</div>
                    <div class="text-[11px] text-gray-500 mb-1">{ex.calculation}</div>
                    <div class="text-emerald-700 dark:text-emerald-400 font-semibold font-mono text-xs">→ {ex.result}</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </details>
    );})}
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex items-center justify-between gap-3">
    {prevCat ? (
      <a href={`/kategori/${toSlug(prevCat.taxType)}`} class="btn-secondary text-xs py-1.5">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        {prevCat.taxType}
      </a>
    ) : <div></div>}
    {nextCat ? (
      <a href={`/kategori/${toSlug(nextCat.taxType)}`} class="btn-secondary text-xs py-1.5">
        {nextCat.taxType}
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    ) : <div></div>}
  </div>
</BaseLayout>
