---
import BaseLayout from '../../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const raw = JSON.parse(fs.readFileSync(path.resolve('public/api.json'), 'utf-8'));
  return raw.categories.map((c: any) => ({
    params: { slug: c.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-') }
  }));
}

const apiPath = path.resolve('public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));
const slug = Astro.params.slug!;

function toSlug(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
}

const category = api.categories.find((c: any) => toSlug(c.taxType) === slug);
if (!category) return Astro.redirect('/404');

const statusBadge: Record<string, string> = {
  'berlaku': 'badge-berlaku', 'dicabut': 'badge-dicabut', 'diubah': 'badge-diubah', 'belum_berlaku': 'badge-belum-berlaku',
};
const statusLabel: Record<string, string> = {
  'berlaku': '✓ Berlaku', 'dicabut': '✗ Dicabut', 'diubah': '⟳ Diubah', 'belum_berlaku': '○ Belum',
};

function formatRate(rate: any): string {
  if (rate.type === 'percentage') return `${rate.value}%`;
  if (rate.type === 'range') return `${rate.value[0]}%–${rate.value[1]}%`;
  if (rate.type === 'progressive' && rate.brackets) return rate.brackets.map((b: any) => `${b.rate}%`).join(' / ');
  return String(rate.value);
}

const totalBppu = category.entries.reduce((sum: number, e: any) => sum + (e.bppuKode?.length || 0), 0);
const activeCount = category.entries.filter((e: any) => e.status === 'berlaku').length;

const allSlugs = api.categories.map((c: any) => toSlug(c.taxType));
const currentIndex = allSlugs.indexOf(slug);
const prevCat = currentIndex > 0 ? api.categories[currentIndex - 1] : null;
const nextCat = currentIndex < api.categories.length - 1 ? api.categories[currentIndex + 1] : null;
---

<BaseLayout title={`${category.taxType} - Tarif Pajak`}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs mb-4" aria-label="Breadcrumb">
    <a href="/" class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition">Beranda</a>
    <svg class="w-3 h-3 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-gray-900 dark:text-gray-100 font-medium">{category.taxType}</span>
  </nav>

  <!-- Category Header -->
  <div class="mb-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-50 mb-1">{category.taxType}</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 max-w-2xl">{category.description}</p>
      </div>
      <div class="shrink-0 flex gap-1.5">
        <span class="bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 px-2.5 py-1 rounded-md text-xs font-medium">{activeCount} aktif</span>
        <span class="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-2.5 py-1 rounded-md text-xs font-medium">{category.entries.length} total</span>
      </div>
    </div>
    {totalBppu > 0 && (
      <div class="mt-2">
        <a href="/kode-objek-pajak" class="inline-flex items-center gap-1 text-xs text-brand-600 dark:text-brand-400 hover:underline font-mono">
          → {totalBppu} kode BPPU terkait
        </a>
      </div>
    )}
  </div>

  <!-- Service Types -->
  {category.serviceTypes && category.serviceTypes.services && (
    <div class="card mb-6 overflow-hidden">
      <div class="bg-gray-50 dark:bg-gray-800 px-4 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
        <span class="text-xs font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wide">{category.serviceTypes.services.length} Jenis Jasa</span>
        <a href={category.serviceTypes.sourceUrl} target="_blank" class="text-[11px] text-brand-600 dark:text-brand-400 hover:underline font-mono">{category.serviceTypes.source} ↗</a>
      </div>
      <div class="p-4 max-h-64 overflow-y-auto custom-scrollbar">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1.5">
          {category.serviceTypes.services.map((svc: any) => (
            <div class="flex items-start gap-1.5 py-0.5">
              <span class="text-gray-400 font-mono text-[11px] min-w-[1.5rem] shrink-0">{svc.code}.</span>
              <span class="text-sm text-gray-600 dark:text-gray-400">{svc.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Entries -->
  <div class="space-y-3">
    {category.entries.map((entry: any) => (
      <article class="card overflow-hidden">
        <div class="p-4 sm:p-5">
          <!-- Entry Header -->
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex-1 min-w-0">
              <h2 class="text-base font-semibold text-gray-900 dark:text-gray-50">{entry.transactionType}</h2>
              <span class="text-[11px] text-gray-400 font-mono">{entry.id}</span>
            </div>
            <span class={`badge ${statusBadge[entry.status] || 'badge-belum-berlaku'} shrink-0`}>{statusLabel[entry.status] || entry.status}</span>
          </div>

          <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">{entry.description}</p>

          <!-- Rate Display -->
          <div class="bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-md p-3 mb-3">
            <div class="flex items-baseline gap-2">
              <span class="rate-value-lg">{formatRate(entry.rate)}</span>
              {entry.rate.effectiveRate && (
                <span class="text-[11px] text-gray-400 bg-white dark:bg-gray-900 px-1.5 py-0.5 rounded border border-gray-200 dark:border-gray-700">
                  efektif: {entry.rate.effectiveRate}
                </span>
              )}
            </div>
            <div class="text-xs text-gray-400 mt-1">Dasar pengenaan: {entry.taxBase}</div>
          </div>

          <!-- Progressive Brackets -->
          {entry.rate.brackets && (
            <div class="mb-3 overflow-x-auto custom-scrollbar border border-gray-200 dark:border-gray-700 rounded-md">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Lapisan</th>
                    <th class="text-right">Batas Bawah</th>
                    <th class="text-right">Batas Atas</th>
                    <th class="text-right">Tarif</th>
                  </tr>
                </thead>
                <tbody>
                  {entry.rate.brackets.map((b: any, i: number) => (
                    <tr>
                      <td class="text-gray-500">{i + 1}</td>
                      <td class="text-right font-mono text-sm">Rp {(b.min / 1000000).toLocaleString('id')} jt</td>
                      <td class="text-right font-mono text-sm">{b.max ? `Rp ${(b.max / 1000000).toLocaleString('id')} jt` : '∞'}</td>
                      <td class="text-right"><span class="rate-value">{b.rate}%</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <!-- Details Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm mb-3">
            <div>
              <div class="text-[11px] text-gray-400 mb-0.5">Wajib Pajak</div>
              <div class="text-gray-700 dark:text-gray-300 text-sm">{entry.payer}</div>
            </div>
            <div>
              <div class="text-[11px] text-gray-400 mb-0.5">Penerima</div>
              <div class="text-gray-700 dark:text-gray-300 text-sm">{entry.recipient}</div>
            </div>
            {entry.withholder && (
              <div>
                <div class="text-[11px] text-gray-400 mb-0.5">Pemotong</div>
                <div class="text-gray-700 dark:text-gray-300 text-sm">{entry.withholder}</div>
              </div>
            )}
            <div>
              <div class="text-[11px] text-gray-400 mb-0.5">Berlaku</div>
              <div class="text-gray-700 dark:text-gray-300 font-mono text-sm">{entry.effectiveFrom}{entry.effectiveTo ? ` → ${entry.effectiveTo}` : ' → sekarang'}</div>
            </div>
          </div>

          <!-- BPPU Codes -->
          {entry.bppuKode && entry.bppuKode.length > 0 && (
            <div class="border-t border-gray-100 dark:border-gray-800 pt-3 mb-3">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-gray-600 dark:text-gray-400">Kode BPPU ({entry.bppuKode.length})</span>
                <a href="/kode-objek-pajak" class="text-[11px] text-brand-600 dark:text-brand-400 hover:underline">Semua ↗</a>
              </div>
              {entry.bppuKode.length <= 10 ? (
                <div class="flex flex-wrap gap-1.5">
                  {entry.bppuKode.map((b: any) => (
                    <span class="inline-flex items-center gap-1 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded px-2 py-1 text-xs font-mono">
                      <span class="text-gray-900 dark:text-gray-100 font-medium">{b.kode}</span>
                      <span class="text-gray-400">{b.tarif}%</span>
                    </span>
                  ))}
                </div>
              ) : (
                <div class="overflow-x-auto custom-scrollbar border border-gray-200 dark:border-gray-700 rounded-md max-h-64">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Kode</th>
                        <th>Nama</th>
                        <th class="text-right">Tarif</th>
                      </tr>
                    </thead>
                    <tbody>
                      {entry.bppuKode.map((b: any) => (
                        <tr>
                          <td class="font-mono font-medium text-gray-900 dark:text-gray-100 whitespace-nowrap">{b.kode}</td>
                          <td class="cell-wrap" style="white-space:normal;max-width:400px">{b.nama}</td>
                          <td class="text-right"><span class="rate-value">{b.tarif}%</span></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}

          <!-- Legal Basis -->
          <div class="border-t border-gray-100 dark:border-gray-800 pt-3">
            <div class="text-[11px] text-gray-400 mb-1.5 font-medium uppercase tracking-wide">Dasar Hukum</div>
            <div class="flex flex-wrap gap-1.5">
              {entry.legalBasis.map((lb: any) => (
                <a href={lb.sourceUrl || lb.pasalUrl || '#'} target="_blank" class="tag">
                  <span class="text-brand-600 dark:text-brand-400">{lb.regulation}</span>
                  <span class="text-gray-400">{lb.article}</span>
                  {(lb.sourceUrl || lb.pasalUrl) && <span class="text-gray-300">↗</span>}
                </a>
              ))}
            </div>
          </div>

          <!-- Notes -->
          {entry.notes && (
            <div class="mt-3 text-sm text-gray-500 dark:text-gray-400 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-md p-3 flex gap-2">
              <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div class="text-sm">{entry.notes.substring(0, 500)}{entry.notes.length > 500 ? '...' : ''}</div>
            </div>
          )}

          <!-- Examples -->
          {entry.examples && entry.examples.length > 0 && (
            <div class="mt-3 border-t border-gray-100 dark:border-gray-800 pt-3">
              <div class="text-[11px] text-gray-400 mb-2 font-medium uppercase tracking-wide">Contoh Perhitungan</div>
              <div class="grid gap-2">
                {entry.examples.map((ex: any) => (
                  <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800/30 rounded-md p-3">
                    <div class="text-sm text-gray-700 dark:text-gray-300 mb-1">{ex.scenario}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400 mb-1">{ex.calculation}</div>
                    <div class="text-emerald-700 dark:text-emerald-400 font-semibold font-mono text-sm">→ {ex.result}</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <!-- Pagination -->
  <div class="mt-8 flex items-center justify-between gap-4">
    {prevCat ? (
      <a href={`/kategori/${toSlug(prevCat.taxType)}`} class="btn-secondary text-sm">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        {prevCat.taxType}
      </a>
    ) : <div></div>}
    {nextCat ? (
      <a href={`/kategori/${toSlug(nextCat.taxType)}`} class="btn-secondary text-sm">
        {nextCat.taxType}
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    ) : <div></div>}
  </div>
</BaseLayout>
