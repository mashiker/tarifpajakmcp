---
import BaseLayout from '../../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const raw = JSON.parse(fs.readFileSync(path.resolve('public/api.json'), 'utf-8'));
  return raw.categories.map((c: any) => ({ params: { slug: c.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-') } }));
}
const api = JSON.parse(fs.readFileSync(path.resolve('public/api.json'), 'utf-8'));
const slug = Astro.params.slug!;
function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-'); }
const category = api.categories.find((c: any) => toSlug(c.taxType) === slug);
if (!category) return Astro.redirect('/404');

const sb: Record<string, string> = { berlaku: 'badge-berlaku', dicabut: 'badge-dicabut', diubah: 'badge-diubah', belum_berlaku: 'badge-belum-berlaku' };
const sl: Record<string, string> = { berlaku: 'Berlaku', dicabut: 'Dicabut', diubah: 'Diubah', belum_berlaku: 'Belum' };

function fmtRate(r: any, entry?: any): string {
  if (r.type === 'percentage') return `${r.value}%`;
  if (r.type === 'range') return `${r.value[0]}–${r.value[1]}%`;
  if (r.type === 'progressive' && r.brackets) {
    // For TER entries with many brackets, show summary instead of all rates
    if (r.brackets.length > 10) {
      const rates = r.brackets.map((b: any) => b.rate);
      const min = Math.min(...rates);
      const max = Math.max(...rates);
      return `${min}%–${max}% (${r.brackets.length} lapisan)`;
    }
    return r.brackets.map((b: any) => `${b.rate}%`).join('/');
  }
  return String(r.value);
}

const activeCount = category.entries.filter((e: any) => e.status === 'berlaku').length;
const totalBppu = category.entries.reduce((s: number, e: any) => s + (e.bppuKode?.length || 0), 0);
const allSlugs = api.categories.map((c: any) => toSlug(c.taxType));
const ci = allSlugs.indexOf(slug);
const prev = ci > 0 ? api.categories[ci - 1] : null;
const next = ci < api.categories.length - 1 ? api.categories[ci + 1] : null;
---

<BaseLayout title={`${category.taxType} - Tarif Pajak`}>
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-1.5 text-xs mb-4 text-gray-400">
    <a href="/" class="hover:text-gray-600 dark:hover:text-gray-300 transition-colors">Beranda</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-gray-700 dark:text-gray-300 font-medium">{category.taxType}</span>
  </nav>

  <!-- Header -->
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-xl sm:text-2xl font-black text-gray-900 dark:text-gray-50 tracking-tight">{category.taxType}</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 max-w-2xl">{category.description}</p>
    </div>
    <div class="shrink-0 flex gap-2">
      <span class="bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 px-3 py-1 rounded-lg text-xs font-semibold">{activeCount} aktif</span>
      <span class="bg-gray-100 dark:bg-gray-800 text-gray-500 px-3 py-1 rounded-lg text-xs font-semibold">{category.entries.length} total</span>
    </div>
  </div>
  {totalBppu > 0 && (
    <a href="/kode-objek-pajak" class="inline-flex items-center gap-1.5 text-xs text-brand-600 dark:text-brand-400 hover:underline font-medium mb-4">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path></svg>
      {totalBppu} kode BPPU terkait
    </a>
  )}

  <!-- Service Types -->
  {category.serviceTypes?.services && (
    <details class="card mb-5" open={category.serviceTypes.services.length <= 15}>
      <summary class="px-5 py-3 bg-gray-50 dark:bg-gray-800/50 rounded-t-xl border-b border-gray-200 dark:border-gray-800 flex items-center justify-between cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
        <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">{category.serviceTypes.services.length} Jenis Jasa</span>
        <a href={category.serviceTypes.sourceUrl} target="_blank" class="text-[11px] text-brand-600 dark:text-brand-400 hover:underline font-mono">{category.serviceTypes.source} ↗</a>
      </summary>
      <div class="p-4 max-h-60 overflow-y-auto custom-scrollbar">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1">
          {category.serviceTypes.services.map((s: any) => (
            <div class="flex gap-1.5 py-0.5"><span class="text-gray-400 font-mono text-[11px] min-w-[1.5rem] shrink-0">{s.code}.</span><span class="text-sm text-gray-600 dark:text-gray-400">{s.name}</span></div>
          ))}
        </div>
      </div>
    </details>
  )}

  <!-- Entries -->
  <div class="space-y-2.5">
    {category.entries.map((entry: any, idx: number) => {
      const isOpen = entry.status === 'berlaku' || idx < 3;
      return (
      <details class="card overflow-hidden group" open={isOpen}>
        <summary class="px-5 py-4 hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors">
          <div class="flex items-center justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-gray-100">{entry.transactionType}</h3>
                <span class={`badge ${sb[entry.status] || 'badge-belum-berlaku'}`}>{sl[entry.status]}</span>
              </div>
              <div class="flex items-center gap-4 text-xs text-gray-400">
                <span class="rate-value text-base">{fmtRate(entry.rate)}</span>
                <span class="font-mono">{entry.effectiveFrom} → {entry.effectiveTo || 'sekarang'}</span>
                {entry.bppuKode?.length > 0 && <span class="text-brand-600 dark:text-brand-400 font-mono">{entry.bppuKode.length} BPPU</span>}
              </div>
            </div>
            <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </summary>
        <div class="px-5 pb-5 border-t border-gray-100 dark:border-gray-800">
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-3 mb-4">{entry.description}</p>
          {entry.id?.startsWith('pph-21-ter-') && (
            <a href="/ter-pph-21" class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800/40 text-blue-700 dark:text-blue-300 rounded-xl px-4 py-2.5 text-xs font-medium hover:bg-blue-100 dark:hover:bg-blue-900/30 transition-colors mb-4">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
              Lihat tabel lengkap dengan kalkulator TER →
            </a>
          )}

          <!-- Rate Display -->
          <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-5 mb-4">
            <div class="flex items-baseline gap-3 flex-wrap">
              <span class="rate-value-lg">{fmtRate(entry.rate)}</span>
              {entry.rate.effectiveRate && (
                <span class="text-xs text-gray-400 bg-white dark:bg-gray-900 px-2 py-1 rounded-lg border border-gray-200 dark:border-gray-700">Tarif efektif: {entry.rate.effectiveRate}</span>
              )}
            </div>
            <div class="text-sm text-gray-400 mt-2">Dasar pengenaan: <span class="text-gray-600 dark:text-gray-300">{entry.taxBase}</span></div>
          </div>

          <!-- Brackets -->
          {entry.rate.brackets && (
            <div class="mb-4 border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden">
              <table class="data-table">
                <thead><tr><th>Lapisan</th><th class="text-right">Batas Bawah</th><th class="text-right">Batas Atas</th><th class="text-right">Tarif</th></tr></thead>
                <tbody>
                  {entry.rate.brackets.map((b: any, i: number) => (
                    <tr>
                      <td class="text-gray-500">{i + 1}</td>
                      <td class="text-right font-mono">Rp {(b.min / 1e6).toLocaleString('id')} jt</td>
                      <td class="text-right font-mono">{b.max ? `Rp ${(b.max / 1e6).toLocaleString('id')} jt` : '∞'}</td>
                      <td class="text-right"><span class="rate-value">{b.rate}%</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <!-- Details Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
            <div><div class="text-[11px] text-gray-400 mb-0.5 font-medium uppercase">Wajib Pajak</div><div class="text-sm text-gray-700 dark:text-gray-300">{entry.payer}</div></div>
            <div><div class="text-[11px] text-gray-400 mb-0.5 font-medium uppercase">Penerima</div><div class="text-sm text-gray-700 dark:text-gray-300">{entry.recipient}</div></div>
            {entry.withholder && <div><div class="text-[11px] text-gray-400 mb-0.5 font-medium uppercase">Pemotong</div><div class="text-sm text-gray-700 dark:text-gray-300">{entry.withholder}</div></div>}
            <div><div class="text-[11px] text-gray-400 mb-0.5 font-medium uppercase">Berlaku</div><div class="text-sm text-gray-700 dark:text-gray-300 font-mono">{entry.effectiveFrom} → {entry.effectiveTo || 'sekarang'}</div></div>
          </div>

          <!-- BPPU -->
          {entry.bppuKode?.length > 0 && (
            <div class="border-t border-gray-100 dark:border-gray-800 pt-4 mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Kode BPPU ({entry.bppuKode.length})</span>
                <a href="/kode-objek-pajak" class="text-[11px] text-brand-600 dark:text-brand-400 hover:underline">Lihat semua ↗</a>
              </div>
              {entry.bppuKode.length <= 12 ? (
                <div class="flex flex-wrap gap-1.5">
                  {entry.bppuKode.map((b: any) => (
                    <span class="inline-flex items-center gap-1.5 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg px-2.5 py-1 text-xs">
                      <span class="font-mono font-bold text-gray-900 dark:text-gray-100">{b.kode}</span>
                      <span class="text-gray-400 font-mono">{b.tarif}%</span>
                    </span>
                  ))}
                </div>
              ) : (
                <div class="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden max-h-64 overflow-y-auto custom-scrollbar">
                  <table class="data-table">
                    <thead><tr><th>Kode</th><th>Nama</th><th class="text-right">Tarif</th></tr></thead>
                    <tbody>
                      {entry.bppuKode.map((b: any) => (
                        <tr><td class="font-mono font-bold text-gray-900 dark:text-gray-100 whitespace-nowrap">{b.kode}</td><td class="cell-wrap text-sm" style="white-space:normal;max-width:350px">{b.nama}</td><td class="text-right"><span class="rate-value">{b.tarif}%</span></td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}

          <!-- Legal Basis -->
          <div class="border-t border-gray-100 dark:border-gray-800 pt-4">
            <div class="text-[11px] text-gray-400 mb-1.5 font-bold uppercase tracking-wider">Dasar Hukum</div>
            <div class="flex flex-wrap gap-1.5">
              {entry.legalBasis.map((lb: any) => (
                <a href={lb.sourceUrl || lb.pasalUrl || '#'} target="_blank" class="tag">
                  <span class="text-brand-600 dark:text-brand-400 font-semibold">{lb.regulation}</span>
                  <span class="text-gray-400">{lb.article}</span>
                  {(lb.sourceUrl || lb.pasalUrl) && <span class="text-gray-300">↗</span>}
                </a>
              ))}
            </div>
          </div>

          <!-- Notes -->
          {entry.notes && (
            <div class="mt-4 flex gap-2.5 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/40 rounded-xl p-4">
              <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div class="text-sm text-amber-800 dark:text-amber-200">{entry.notes.substring(0, 500)}{entry.notes.length > 500 ? '...' : ''}</div>
            </div>
          )}

          <!-- Examples -->
          {entry.examples?.length > 0 && (
            <div class="mt-4 border-t border-gray-100 dark:border-gray-800 pt-4">
              <div class="text-[11px] text-gray-400 mb-2 font-bold uppercase tracking-wider">Contoh Perhitungan</div>
              <div class="space-y-2">
                {entry.examples.map((ex: any) => (
                  <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800/40 rounded-xl p-4">
                    <div class="text-sm font-medium text-emerald-900 dark:text-emerald-100 mb-1">{ex.scenario}</div>
                    <div class="text-xs text-emerald-700 dark:text-emerald-300 mb-1.5">{ex.calculation}</div>
                    <div class="text-sm text-emerald-800 dark:text-emerald-200 font-bold font-mono">→ {ex.result}</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </details>
    );})}
  </div>

  <!-- Nav -->
  <div class="mt-8 flex justify-between gap-4">
    {prev ? <a href={`/kategori/${toSlug(prev.taxType)}`} class="btn-secondary"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>{prev.taxType}</a> : <div></div>}
    {next ? <a href={`/kategori/${toSlug(next.taxType)}`} class="btn-secondary">{next.taxType}<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a> : <div></div>}
  </div>
</BaseLayout>
