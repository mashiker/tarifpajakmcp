---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

type BPPUCode = {
  kode: string;
  nama: string;
  tarif: number;
  entryId: string;
  entryType: string;
  categorySlug: string;
};

function toSlug(s: string): string {
  return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
}

const allBppu: BPPUCode[] = [];
const seenKode = new Set<string>();

api.categories.forEach((cat: any) => {
  const slug = toSlug(cat.taxType);
  cat.entries.forEach((entry: any) => {
    if (entry.bppuKode) {
      entry.bppuKode.forEach((b: any) => {
        if (!seenKode.has(b.kode)) {
          seenKode.add(b.kode);
          allBppu.push({
            kode: b.kode,
            nama: b.nama,
            tarif: b.tarif,
            entryId: entry.id,
            entryType: entry.transactionType,
            categorySlug: slug,
          });
        }
      });
    }
  });
});

allBppu.sort((a, b) => a.kode.localeCompare(b.kode));

const groups: Record<string, { label: string; items: BPPUCode[] }> = {};
const prefixLabels: Record<string, string> = {
  '22': 'PPh 22 — Penjualan/Pembelian Barang',
  '24': 'PPh 23/26 — Jasa, Dividen, Bunga, Royalti',
  '28': 'PPh 4(2) Final — Bunga, Sewa, Saham, Konstruksi',
  '29': 'PPh Lainnya — Charter Pesawat',
};

allBppu.forEach(item => {
  const prefix = item.kode.split('-')[0];
  if (!groups[prefix]) {
    groups[prefix] = { label: prefixLabels[prefix] || `Prefix ${prefix}`, items: [] };
  }
  groups[prefix].items.push(item);
});
---

<BaseLayout title="Kode Objek Pajak BPPU" activeNav="bppu">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-xs mb-4">
    <a href="/" class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition">Beranda</a>
    <svg class="w-3 h-3 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-gray-900 dark:text-gray-100 font-medium">Kode BPPU</span>
  </nav>

  <div class="flex items-center justify-between mb-4">
    <div>
      <h1 class="text-xl font-bold text-gray-900 dark:text-gray-100">Kode Objek Pajak BPPU</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
        {allBppu.length} kode · {Object.keys(groups).length} grup · Referensi untuk Bukti Pemotongan Pajak Unifikasi
      </p>
    </div>
  </div>

  <!-- Search & Filter -->
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <div class="relative flex-1 min-w-[200px] max-w-sm">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <input type="text" id="bppu-search" placeholder="Cari kode atau nama..." 
             class="search-input pl-9 py-2" />
    </div>
    <div class="flex gap-1">
      {Object.entries(groups).map(([prefix, group]) => (
        <button data-filter={prefix} class="filter-btn chip chip-default text-xs">
          {prefix}-xxx ({group.items.length})
        </button>
      ))}
      <button data-filter="all" class="filter-btn chip chip-active text-xs">
        Semua
      </button>
    </div>
  </div>

  <!-- Tables by group -->
  {Object.entries(groups).map(([prefix, group]) => (
    <div class="bppu-group mb-6" data-prefix={prefix}>
      <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">{group.label}</h2>
      <div class="card overflow-hidden">
        <div class="overflow-x-auto custom-scrollbar">
          <table class="data-table">
            <thead>
              <tr>
                <th style="width:120px">Kode</th>
                <th>Nama Objek Pajak</th>
                <th style="width:60px" class="text-right">Tarif</th>
                <th style="width:200px">Entry Terkait</th>
              </tr>
            </thead>
            <tbody>
              {group.items.map((item: BPPUCode) => (
                <tr>
                  <td class="font-mono font-semibold text-gray-900 dark:text-gray-100 whitespace-nowrap">{item.kode}</td>
                  <td class="cell-wrap text-sm" style="white-space:normal;max-width:none">{item.nama}</td>
                  <td class="text-right"><span class="rate-value">{item.tarif}%</span></td>
                  <td>
                    <a href={`/kategori/${item.categorySlug}`} class="text-xs text-brand-600 dark:text-brand-400 hover:underline truncate block">
                      {item.entryType.length > 35 ? item.entryType.substring(0, 35) + '...' : item.entryType}
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  ))}
</BaseLayout>

<script>
  const search = document.getElementById('bppu-search');
  const groups = document.querySelectorAll('.bppu-group');
  const filterBtns = document.querySelectorAll('.filter-btn');

  function filterTable() {
    const query = (search as HTMLInputElement)?.value.toLowerCase() || '';
    const activeFilter = document.querySelector('.filter-btn.chip-active')?.getAttribute('data-filter') || 'all';

    groups.forEach(group => {
      const prefix = group.getAttribute('data-prefix');
      const showByFilter = activeFilter === 'all' || activeFilter === prefix;
      
      if (!showByFilter) {
        (group as HTMLElement).style.display = 'none';
        return;
      }

      const rows = group.querySelectorAll('tbody tr');
      let hasVisible = false;
      rows.forEach(row => {
        const text = row.textContent?.toLowerCase() || '';
        const visible = !query || text.includes(query);
        (row as HTMLElement).style.display = visible ? '' : 'none';
        if (visible) hasVisible = true;
      });
      (group as HTMLElement).style.display = hasVisible ? '' : 'none';
    });
  }

  search?.addEventListener('input', filterTable);
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => { b.classList.remove('chip-active'); b.classList.add('chip-default'); });
      btn.classList.remove('chip-default');
      btn.classList.add('chip-active');
      filterTable();
    });
  });
</script>
