---
// /database canonicalizes to /. We never duplicate the table here.
// Strategy:
//   1. <link rel="canonical"> to /
//   2. <meta http-equiv="refresh"> as a no-JS fallback
//   3. JavaScript location.replace preserving the query string and hash so
//      deep links keep working and the back button is not polluted.

const target = '/';
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Database Tarif Pajak — Tarif Pajak ID</title>
  <meta name="description" content="Database tarif pajak Indonesia. Dialihkan ke /." />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={target} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <script is:inline>
    // Preserve any query string and hash the user arrived with. Use replace so
    // /database does not linger in the browser history.
    (function () {
      var qs = window.location.search || '';
      var hash = window.location.hash || '';
      window.location.replace('/' + qs + hash);
    })();
  </script>
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; background: #F7F8F4; color: #132A2A; margin: 0; padding: 2rem; }
    .redirect-card { max-width: 32rem; margin: 4rem auto; padding: 1.5rem; background: #FFFFFF; border: 1px solid #D9E0DC; border-radius: 0.75rem; }
    .redirect-title { font-size: 1.125rem; font-weight: 700; margin: 0 0 0.5rem; }
    .redirect-text { font-size: 0.875rem; color: #44545a; margin: 0 0 1rem; }
    .redirect-link { display: inline-block; padding: 0.5rem 0.875rem; background: #132A2A; color: #F7F8F4; text-decoration: none; border-radius: 0.5rem; font-size: 0.8125rem; font-weight: 600; }
  </style>
</head>
<body>
  <main class="redirect-card">
    <h1 class="redirect-title">Database telah dipindahkan</h1>
    <p class="redirect-text">
      Database tarif pajak sekarang berada di URL utama. Anda akan dialihkan otomatis.
    </p>
    <a class="redirect-link" href={target}>Buka database</a>
  </main>
</body>
</html>
