---
import BaseLayout from '../layouts/Base.astro';
---
<BaseLayout title="404 — Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan.">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <div class="text-6xl font-extrabold text-[var(--text-tertiary)] mb-4">404</div>
    <h1 class="text-xl font-bold text-[var(--text)] mb-2">Halaman Tidak Ditemukan</h1>
    <p class="text-sm text-[var(--text-secondary)] mb-8 max-w-md">Halaman yang Anda cari tidak ada atau sudah dipindahkan. Coba cari tarif pajak yang Anda butuhkan dari halaman utama.</p>
    <div class="flex items-center gap-3">
      <a href="/" class="btn-primary">← Kembali ke Beranda</a>
      <a href="/database" class="btn-secondary">Database</a>
    </div>
  </div>
</BaseLayout>
