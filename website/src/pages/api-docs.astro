---
import BaseLayout from '../layouts/Base.astro';
---

<BaseLayout title="API Reference" activeNav="api">
  <nav class="flex items-center gap-2 text-xs mb-6">
    <a href="/" class="text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition">Beranda</a>
    <svg class="w-3 h-3 text-slate-300 dark:text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-slate-900 dark:text-slate-100 font-medium">API Reference</span>
  </nav>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-2">API Reference</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">Pre-built static JSON API — fetch langsung dari CDN tanpa backend</p>
  </div>

  <div class="grid grid-cols-3 gap-3 mb-8">
    <div class="card p-4">
      <div class="text-[11px] text-slate-400 mb-1">Base URL</div>
      <code class="text-sm font-mono text-blue-600 dark:text-blue-400">/api/v1/</code>
    </div>
    <div class="card p-4">
      <div class="text-[11px] text-slate-400 mb-1">Format</div>
      <code class="text-sm font-mono text-slate-700 dark:text-slate-300">JSON static</code>
    </div>
    <div class="card p-4">
      <div class="text-[11px] text-slate-400 mb-1">Auth</div>
      <code class="text-sm font-mono text-slate-700 dark:text-slate-300">None — open</code>
    </div>
  </div>

  <div class="mb-8">
    <h2 class="section-heading mb-4">Endpoints</h2>
    
    {[
      { group: 'META', color: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300', endpoints: [
        { method: 'GET', path: '/api/v1/index.json', desc: 'API index' },
        { method: 'GET', path: '/api/v1/stats.json', desc: 'Statistik database' },
      ]},
      { group: 'ENTRIES', color: 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400', endpoints: [
        { method: 'GET', path: '/api/v1/entries/index.json', desc: 'Daftar semua entries (ringkasan)' },
        { method: 'GET', path: '/api/v1/entries/{id}.json', desc: 'Detail 1 entry lengkap' },
      ]},
      { group: 'CATEGORIES', color: 'bg-purple-50 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400', endpoints: [
        { method: 'GET', path: '/api/v1/categories/index.json', desc: 'Daftar semua kategori' },
        { method: 'GET', path: '/api/v1/categories/{slug}.json', desc: 'Entries dalam 1 kategori' },
      ]},
      { group: 'TEMPORAL', color: 'bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400', endpoints: [
        { method: 'GET', path: '/api/v1/by-year/{year}.json', desc: 'Entries berlaku di tahun tsb' },
      ]},
      { group: 'BPPU', color: 'bg-teal-50 text-teal-700 dark:bg-teal-900/30 dark:text-teal-400', endpoints: [
        { method: 'GET', path: '/api/v1/bppu/index.json', desc: 'Semua kode BPPU + mapping' },
        { method: 'GET', path: '/api/v1/bppu/{prefix}.json', desc: 'Kode BPPU per prefix' },
      ]},
      { group: 'TIMELINE', color: 'bg-rose-50 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400', endpoints: [
        { method: 'GET', path: '/api/v1/timeline/index.json', desc: 'Daftar timeline groups' },
        { method: 'GET', path: '/api/v1/timeline/{group}.json', desc: 'Rantai sejarah tarif' },
      ]},
      { group: 'SEARCH', color: 'bg-cyan-50 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-400', endpoints: [
        { method: 'GET', path: '/api/v1/search-index.json', desc: 'Inverted index (client-side search)' },
      ]},
      { group: 'REGULATIONS', color: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400', endpoints: [
        { method: 'GET', path: '/api/v1/regulations/index.json', desc: 'Daftar semua regulasi' },
        { method: 'GET', path: '/api/v1/regulations/{id}.json', desc: 'Detail regulasi + entries' },
      ]},
      { group: 'CALCULATOR', color: 'bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-400', endpoints: [
        { method: 'GET', path: '/api/v1/calculator/index.json', desc: 'Daftar kalkulator' },
        { method: 'GET', path: '/api/v1/calculator/{id}.json', desc: 'Data kalkulasi (brackets, PTKP)' },
      ]},
      { group: 'SPEC', color: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300', endpoints: [
        { method: 'GET', path: '/api/v1/openapi.json', desc: 'OpenAPI 3.0 specification' },
      ]},
    ].map((section: any) => (
      <div class="mb-4">
        <h3 class="text-xs font-semibold text-slate-600 dark:text-slate-400 mb-2 flex items-center gap-2">
          <span class={`px-2.5 py-1 rounded-md text-[10px] font-mono ${section.color}`}>{section.group}</span>
        </h3>
        <div class="card overflow-hidden">
          <table class="data-table">
            <thead><tr><th style="width:70px">Method</th><th>Endpoint</th><th>Deskripsi</th></tr></thead>
            <tbody>
              {section.endpoints.map((ep: any) => (
                <tr>
                  <td><span class="bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 px-2 py-0.5 rounded-md text-[10px] font-mono font-semibold">GET</span></td>
                  <td class="font-mono text-xs text-slate-900 dark:text-slate-100">{ep.path}</td>
                  <td class="text-sm text-slate-500 dark:text-slate-400">{ep.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>

  <div class="mb-8">
    <h2 class="section-heading mb-4">Try It</h2>
    <div class="card p-5">
      <div class="flex flex-wrap gap-2 mb-3">
        <select id="api-endpoint" class="border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2.5 text-sm font-mono bg-white dark:bg-slate-900 flex-1 min-w-[200px] focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none">
          <option value="/api/v1/index.json">GET /api/v1/index.json</option>
          <option value="/api/v1/stats.json">GET /api/v1/stats.json</option>
          <option value="/api/v1/entries/index.json">GET /api/v1/entries/index.json</option>
          <option value="/api/v1/categories/index.json">GET /api/v1/categories/index.json</option>
          <option value="/api/v1/by-year/2001.json">GET /api/v1/by-year/2001.json</option>
          <option value="/api/v1/timeline/pph-21-progressive.json">GET /api/v1/timeline/pph-21-progressive.json</option>
          <option value="/api/v1/calculator/pph-21.json">GET /api/v1/calculator/pph-21.json</option>
          <option value="/api/v1/bppu/index.json">GET /api/v1/bppu/index.json</option>
          <option value="/api/v1/openapi.json">GET /api/v1/openapi.json</option>
        </select>
        <button id="api-execute" class="btn-primary">Execute</button>
        <button id="api-copy-curl" class="btn-secondary">Copy curl</button>
      </div>
      <div id="api-response" class="code-block text-xs overflow-auto max-h-80">
        <span class="text-slate-400">Select an endpoint and click Execute...</span>
      </div>
    </div>
  </div>

  <div class="mb-8">
    <h2 class="section-heading mb-4">Contoh Use Case</h2>
    <div class="grid sm:grid-cols-2 gap-3">
      {[
        { q: 'Berapa tarif PPN tahun 2001?', cmd: 'curl /api/v1/by-year/2001.json', hint: '→ ppn-10pct: 10%' },
        { q: 'Berapa tarif PPh 23 jasa tahun 1999?', cmd: 'curl /api/v1/by-year/1999.json', hint: '→ pph-23-jasa-pre2001: 15%' },
        { q: 'Timeline lengkap PTKP?', cmd: 'curl /api/v1/timeline/pph-21-ptkp.json', hint: '→ 5 era: 960K → 54M' },
        { q: 'Data untuk kalkulasi PPh 21?', cmd: 'curl /api/v1/calculator/pph-21.json', hint: '→ brackets + PTKP values' },
      ].map((uc: any) => (
        <div class="card p-4">
          <div class="text-sm font-medium text-slate-900 dark:text-slate-100 mb-2">{uc.q}</div>
          <div class="code-block text-xs py-2">
            <span class="text-slate-400">$</span> {uc.cmd} <span class="text-slate-400">{uc.hint}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const sel = document.getElementById('api-endpoint') as HTMLSelectElement;
  const btn = document.getElementById('api-execute');
  const copyBtn = document.getElementById('api-copy-curl');
  const resp = document.getElementById('api-response');

  btn?.addEventListener('click', async () => {
    const url = sel.value;
    resp!.innerHTML = '<span class="text-slate-400">Loading...</span>';
    try {
      const r = await fetch(url);
      const data = await r.json();
      resp!.textContent = JSON.stringify(data, null, 2).substring(0, 5000);
    } catch (e: any) {
      resp!.textContent = 'Error: ' + e.message;
    }
  });

  copyBtn?.addEventListener('click', () => {
    const curl = `curl ${window.location.origin}${sel.value}`;
    navigator.clipboard.writeText(curl);
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.textContent = 'Copy curl'; }, 2000);
  });
</script>
