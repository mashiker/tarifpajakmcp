---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-'); }

const catIcons: Record<string, string> = {
  'pph-21': '💼', 'pph-22': '🏭', 'pph-23': '📋', 'pph-26': '🌍', 'pph-badan': '🏢',
  'pph-umkm': '🏪', 'pph-4-2-final': '✅', 'ppn': '🧾', 'ppnbm': '🏎️',
  'bea-meterai': '📄', 'pbb': '🏠', 'bphtb': '🏡', 'bea-masuk': '🚢', 'cukai': '🚬', 'pajak-daerah': '🏙️',
};

const categories = api.categories.map((cat: any) => {
  const slug = toSlug(cat.taxType);
  const active = cat.entries.filter((e: any) => e.status === 'berlaku').length;
  return { ...cat, slug, active };
});

type FE = { category: string; slug: string; type: string; id: string; status: string; rate: string; from: string; to: string; bppu: number; };
const entries: FE[] = [];
api.categories.forEach((cat: any) => {
  const slug = toSlug(cat.taxType);
  cat.entries.forEach((e: any) => {
    let r = '';
    if (e.rate.type === 'percentage') r = `${e.rate.value}%`;
    else if (e.rate.type === 'range') r = `${e.rate.value[0]}–${e.rate.value[1]}%`;
    else if (e.rate.type === 'progressive' && e.rate.brackets) r = e.rate.brackets.map((b: any) => `${b.rate}%`).join('/');
    else r = String(e.rate.value);
    entries.push({ category: cat.taxType, slug, type: e.transactionType, id: e.id, status: e.status, rate: r, from: e.effectiveFrom, to: e.effectiveTo || '—', bppu: e.bppuKode?.length || 0 });
  });
});
const so: Record<string, number> = { berlaku: 0, diubah: 1, belum_berlaku: 2, dicabut: 3 };
entries.sort((a, b) => (so[a.status] ?? 9) - (so[b.status] ?? 9));
const sb: Record<string, string> = { berlaku: 'badge-berlaku', dicabut: 'badge-dicabut', diubah: 'badge-diubah', belum_berlaku: 'badge-belum-berlaku' };
const sl: Record<string, string> = { berlaku: 'Berlaku', dicabut: 'Dicabut', diubah: 'Diubah', belum_berlaku: 'Belum' };
const activeEntries = entries.filter(e => e.status === 'berlaku');
const bppuTotal = new Set<string>();
api.categories.forEach((cat: any) => cat.entries.forEach((e: any) => e.bppuKode?.forEach((b: any) => bppuTotal.add(b.kode))));

const groupedEntries: Record<string, { slug: string; items: FE[] }> = {};
entries.forEach(e => {
  if (!groupedEntries[e.category]) groupedEntries[e.category] = { slug: e.slug, items: [] };
  groupedEntries[e.category].items.push(e);
});
---

<BaseLayout title="Beranda" activeNav="home">
  <!-- Hero -->
  <div class="text-center mb-10 pt-4">
    <div class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-4 ring-1 ring-blue-200/60 dark:ring-blue-800">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
      Database Terbuka · Regulasi Resmi
    </div>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4 leading-tight">
      Tarif Pajak<br class="sm:hidden" /> Indonesia
    </h1>
    <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-6 text-base sm:text-lg leading-relaxed">
      Referensi lengkap tarif pajak dari <strong class="text-slate-700 dark:text-slate-300">1983</strong> hingga sekarang. Bersumber dari regulasi resmi, gratis dan terbuka.
    </p>
    <div class="max-w-lg mx-auto relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <input id="hero-search" type="text" placeholder="Cari tarif pajak, misal: PPh 21, PPN, TER..." class="search-input text-sm py-3" aria-label="Cari tarif pajak" />
      <kbd class="hidden sm:inline-flex absolute right-4 top-1/2 -translate-y-1/2 text-[10px] text-slate-400 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-md px-1.5 py-0.5 font-mono pointer-events-none">⌘K</kbd>
      <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-2xl max-h-72 overflow-y-auto hidden z-50 custom-scrollbar"></div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-3xl mx-auto mb-10">
    <div class="stat-card"><div class="stat-value">{api.meta.stats.entries}</div><div class="stat-label">Jenis Tarif</div></div>
    <div class="stat-card"><div class="stat-value">{api.meta.stats.regulations}</div><div class="stat-label">Regulasi</div></div>
    <div class="stat-card"><div class="stat-value">{categories.length}</div><div class="stat-label">Kategori</div></div>
    <div class="stat-card"><div class="stat-value">{bppuTotal.size}</div><div class="stat-label">Kode BPPU</div></div>
  </div>

  <!-- TER Banner -->
  <section class="mb-10">
    <a href="/ter-pph-21" class="group flex items-center gap-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-2xl px-6 py-5 hover:shadow-xl hover:shadow-blue-600/15 transition-all">
      <div class="w-12 h-12 rounded-xl bg-white/15 flex items-center justify-center font-bold text-base shrink-0 backdrop-blur-sm">TER</div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-bold mb-0.5">Tabel TER PPh 21 — Lengkap dengan Kalkulator</div>
        <div class="text-xs text-blue-100">42 lapisan tarif untuk 3 kategori (A/B/C) berdasarkan PP 58/2023</div>
      </div>
      <svg class="w-5 h-5 opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </a>
  </section>

  <!-- Category Grid -->
  <section class="mb-10">
    <h2 class="section-heading mb-4">Kategori Pajak</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
      {categories.map((cat: any) => (
        <a href={`/kategori/${cat.slug}`} class="category-card flex flex-col items-center text-center p-4">
          <div class="text-2xl mb-2">{catIcons[cat.slug] || '📋'}</div>
          <div class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors leading-snug mb-1">{cat.taxType}</div>
          <div class="text-[11px] text-slate-400 font-mono">{cat.active} aktif · {cat.entries.length} total</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Rate Table -->
  <section class="mb-10">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <h2 class="section-heading">Tabel Tarif Lengkap</h2>
      <div class="flex gap-2">
        <button id="filter-berlaku" class="chip chip-active" data-status="berlaku"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Aktif ({activeEntries.length})</button>
        <button id="filter-semua" class="chip chip-default" data-status="all">Semua ({entries.length})</button>
      </div>
    </div>

    <!-- Desktop: full table -->
    <div class="hidden md:block card overflow-hidden">
      <div class="overflow-auto custom-scrollbar" style="max-height:65vh">
        <table class="data-table" id="main-table">
          <thead>
            <tr>
              <th>Kategori</th>
              <th>Jenis Transaksi</th>
              <th>Tarif</th>
              <th class="hidden lg:table-cell">Kode BPPU</th>
              <th>Status</th>
              <th class="hidden xl:table-cell">Masa Berlaku</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((e: FE) => (
              <tr data-status={e.status}>
                <td>
                  <a href={`/kategori/${e.slug}`} class="inline-flex items-center gap-1.5 hover:text-blue-700 dark:hover:text-blue-400 transition-colors">
                    <span class="text-sm font-medium">{e.category}</span>
                  </a>
                </td>
                <td>
                  <a href={`/kategori/${e.slug}`} class="text-sm text-slate-600 dark:text-slate-400 hover:text-blue-700 dark:hover:text-blue-400 transition-colors">{e.type}</a>
                  <div class="text-[10px] text-slate-400 font-mono mt-0.5">{e.id}</div>
                </td>
                <td><span class="rate-value text-sm">{e.rate}</span></td>
                <td class="hidden lg:table-cell">
                  {e.bppu > 0 ? <a href="/kode-objek-pajak" class="text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline">{e.bppu} kode</a> : <span class="text-slate-300 text-xs">—</span>}
                </td>
                <td><span class={`badge ${sb[e.status] || 'badge-belum-berlaku'}`}>{sl[e.status]}</span></td>
                <td class="hidden xl:table-cell"><span class="text-xs text-slate-500 font-mono whitespace-nowrap">{e.from} → {e.to}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile: grouped card list -->
    <div class="md:hidden space-y-4" id="mobile-list">
      {Object.entries(groupedEntries).map(([catName, group]: [string, { slug: string; items: FE[] }]) => (
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-lg">{catIcons[group.slug] || '📋'}</span>
            <a href={`/kategori/${group.slug}`} class="text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-blue-700 dark:hover:text-blue-400">{catName}</a>
            <span class="text-[10px] text-slate-400 font-mono">{group.items.length}</span>
          </div>
          <div class="space-y-2">
            {group.items.map((e: FE) => (
              <a href={`/kategori/${group.slug}`} data-status={e.status} class="mobile-card block bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-3 hover:border-blue-300 dark:hover:border-blue-700 active:scale-[0.98] transition-all">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate">{e.type}</div>
                    <div class="flex items-center gap-2 mt-1">
                      <span class="rate-value text-sm">{e.rate}</span>
                      <span class="text-[10px] text-slate-400 font-mono">{e.from} → {e.to}</span>
                    </div>
                  </div>
                  <span class={`badge ${sb[e.status] || 'badge-belum-berlaku'} text-[10px] shrink-0`}>{sl[e.status]}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Bottom -->
  <div class="grid sm:grid-cols-2 gap-4">
    <div class="card p-5">
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-3">API Terbuka</h3>
      <div class="code-block text-xs">curl https://tarif-pajak-id.pages.dev/api.json</div>
      <p class="text-xs text-slate-400 mt-2">JSON statis · Tanpa auth · Tanpa rate limit</p>
    </div>
    <div class="card p-5">
      <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-3">Sumber Regulasi</h3>
      <div class="flex flex-wrap gap-2">
        <a href="https://pasal.id" target="_blank" class="tag">Pasal.id ↗</a>
        <a href="https://peraturan.bpk.go.id" target="_blank" class="tag">JDIH BPK ↗</a>
        <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="tag">GitHub ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const fb = document.getElementById('filter-berlaku'), fs2 = document.getElementById('filter-semua'), t = document.getElementById('main-table');
  function setStatus(s: string) {
    t?.querySelectorAll('tbody tr').forEach(r => { (r as HTMLElement).style.display = (s === 'all' || r.dataset.status === s) ? '' : 'none'; });
    document.querySelectorAll('#mobile-list .mobile-card').forEach(c => { (c as HTMLElement).style.display = (s === 'all' || c.dataset.status === s) ? '' : 'none'; });
    if (s === 'berlaku') { fb?.classList.replace('chip-default', 'chip-active'); fs2?.classList.replace('chip-active', 'chip-default'); }
    else { fs2?.classList.replace('chip-default', 'chip-active'); fb?.classList.replace('chip-active', 'chip-default'); }
  }
  fb?.addEventListener('click', () => setStatus('berlaku'));
  fs2?.addEventListener('click', () => setStatus('all'));

  const inp = document.getElementById('hero-search') as HTMLInputElement, res = document.getElementById('hero-search-results');
  let db: ReturnType<typeof setTimeout>;
  inp?.addEventListener('input', () => { clearTimeout(db); db = setTimeout(async () => {
    if (inp.value.length < 2) { res?.classList.add('hidden'); return; }
    const d = await (await fetch('/api/v1/search-index.json')).json(), q = inp.value.toLowerCase(), m: string[] = [];
    for (const [k, ids] of Object.entries(d.keywords)) { if (k.includes(q)) for (const id of (ids as string[])) if (!m.includes(id)) m.push(id); }
    if (!m.length) { res?.classList.add('hidden'); return; }
    const fmt = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    if (res) { res.innerHTML = m.slice(0, 8).map(id => `<a href="/kategori/${id.split('-').slice(0,2).join('-')}" class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800 border-b border-slate-100 dark:border-slate-800 last:border-0"><div class="text-sm font-medium text-slate-900 dark:text-slate-100">${fmt(id)}</div><div class="text-[10px] text-slate-400 font-mono ml-auto">${id}</div></a>`).join(''); res.classList.remove('hidden'); }
  }, 200); });
  inp?.addEventListener('blur', () => setTimeout(() => res?.classList.add('hidden'), 200));
  document.addEventListener('keydown', e => { if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); inp?.focus(); } });
</script>
