---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, ''); }

const catMeta: Record<string, { icon: string; color: string; colorLight: string; darkBg: string }> = {
  'pph-21': { icon: '👤', color: 'text-blue-600 dark:text-blue-400', colorLight: 'bg-blue-50 dark:bg-blue-950/30', darkBg: 'from-blue-600 to-blue-700' },
  'pph-22': { icon: '🏭', color: 'text-violet-600 dark:text-violet-400', colorLight: 'bg-violet-50 dark:bg-violet-950/30', darkBg: 'from-violet-600 to-violet-700' },
  'pph-23': { icon: '📋', color: 'text-indigo-600 dark:text-indigo-400', colorLight: 'bg-indigo-50 dark:bg-indigo-950/30', darkBg: 'from-indigo-600 to-indigo-700' },
  'pph-26': { icon: '🌍', color: 'text-cyan-600 dark:text-cyan-400', colorLight: 'bg-cyan-50 dark:bg-cyan-950/30', darkBg: 'from-cyan-600 to-cyan-700' },
  'pph-badan': { icon: '🏢', color: 'text-emerald-600 dark:text-emerald-400', colorLight: 'bg-emerald-50 dark:bg-emerald-950/30', darkBg: 'from-emerald-600 to-emerald-700' },
  'pph-umkm': { icon: '🏪', color: 'text-amber-600 dark:text-amber-400', colorLight: 'bg-amber-50 dark:bg-amber-950/30', darkBg: 'from-amber-500 to-amber-600' },
  'pph-4-2-final': { icon: '✅', color: 'text-teal-600 dark:text-teal-400', colorLight: 'bg-teal-50 dark:bg-teal-950/30', darkBg: 'from-teal-600 to-teal-700' },
  'ppn': { icon: '💰', color: 'text-emerald-600 dark:text-emerald-400', colorLight: 'bg-emerald-50 dark:bg-emerald-950/30', darkBg: 'from-emerald-500 to-emerald-600' },
  'ppnbm': { icon: '🏷️', color: 'text-rose-600 dark:text-rose-400', colorLight: 'bg-rose-50 dark:bg-rose-950/30', darkBg: 'from-rose-500 to-rose-600' },
  'bea-meterai': { icon: '📄', color: 'text-orange-600 dark:text-orange-400', colorLight: 'bg-orange-50 dark:bg-orange-950/30', darkBg: 'from-orange-500 to-orange-600' },
  'pbb': { icon: '🏠', color: 'text-sky-600 dark:text-sky-400', colorLight: 'bg-sky-50 dark:bg-sky-950/30', darkBg: 'from-sky-500 to-sky-600' },
  'bphtb': { icon: '🏗️', color: 'text-lime-600 dark:text-lime-400', colorLight: 'bg-lime-50 dark:bg-lime-950/30', darkBg: 'from-lime-500 to-lime-600' },
  'bea-masuk': { icon: '🚢', color: 'text-slate-600 dark:text-slate-400', colorLight: 'bg-slate-100 dark:bg-slate-800', darkBg: 'from-slate-600 to-slate-700' },
  'cukai': { icon: '🍷', color: 'text-fuchsia-600 dark:text-fuchsia-400', colorLight: 'bg-fuchsia-50 dark:bg-fuchsia-950/30', darkBg: 'from-fuchsia-500 to-fuchsia-600' },
  'pajak-daerah': { icon: '🏛️', color: 'text-pink-600 dark:text-pink-400', colorLight: 'bg-pink-50 dark:bg-pink-950/30', darkBg: 'from-pink-500 to-pink-600' },
};

const categories = api.categories.map((cat: any) => {
  const slug = toSlug(cat.taxType);
  const active = cat.entries.filter((e: any) => e.status === 'berlaku').length;
  const meta = catMeta[slug] || { icon: '📊', color: 'text-slate-600 dark:text-slate-400', colorLight: 'bg-slate-100 dark:bg-slate-800', darkBg: 'from-slate-600 to-slate-700' };
  return { ...cat, slug, active, meta };
});

type FE = { category: string; slug: string; type: string; id: string; status: string; rate: string; from: string; to: string; bppu: number; basis: string; };
const entries: FE[] = [];
api.categories.forEach((cat: any) => {
  const slug = toSlug(cat.taxType);
  cat.entries.forEach((e: any) => {
    let r = '';
    if (e.rate.type === 'percentage') r = `${e.rate.value}%`;
    else if (e.rate.type === 'range') r = `${e.rate.value[0]}–${e.rate.value[1]}%`;
    else if (e.rate.type === 'progressive' && e.rate.brackets) {
      const rates = e.rate.brackets.map((b: any) => b.rate);
      r = e.rate.brackets.length > 8 ? `${Math.min(...rates)}–${Math.max(...rates)}%` : rates.map((x: number) => `${x}%`).join('/');
    }
    else r = String(e.rate.value);
    entries.push({ category: cat.taxType, slug, type: e.transactionType, id: e.id, status: e.status, rate: r, from: e.effectiveFrom, to: e.effectiveTo || 'sekarang', bppu: e.bppuKode?.length || 0, basis: e.taxBase || '—' });
  });
});
const so: Record<string, number> = { berlaku: 0, diubah: 1, belum_berlaku: 2, dicabut: 3 };
entries.sort((a, b) => (so[a.status] ?? 9) - (so[b.status] ?? 9));
const sb: Record<string, string> = { berlaku: 'badge-berlaku', dicabut: 'badge-dicabut', diubah: 'badge-diubah', belum_berlaku: 'badge-belum-berlaku' };
const sl: Record<string, string> = { berlaku: 'Berlaku', dicabut: 'Dicabut', diubah: 'Diubah', belum_berlaku: 'Belum' };
const activeEntries = entries.filter(e => e.status === 'berlaku');
const bppuTotal = new Set<string>();
api.categories.forEach((cat: any) => cat.entries.forEach((e: any) => e.bppuKode?.forEach((b: any) => bppuTotal.add(b.kode))));
const popular = ['PPh 21 TER', 'PPh 23 jasa', 'PPN 12%', 'UMKM 0,5%', 'Kode BPPU 24-104'];
---

<BaseLayout title="Database Tarif Pajak Indonesia" activeNav="home" description="Database tarif pajak Indonesia terbuka: PPh, PPN, BPPU, TER PPh 21, regulasi resmi, dan API JSON statis untuk developer.">

  <!-- ====== HERO ====== -->
  <section class="hero-gradient relative overflow-hidden -mx-4 -mt-8 px-4 pt-12 pb-16 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 lg:pt-20 lg:pb-24">
    <div class="absolute inset-0 hero-grid-bg pointer-events-none"></div>

    <div class="relative mx-auto max-w-3xl text-center animate-in">
      <!-- Eyebrow -->
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-200/80 bg-emerald-50/80 dark:border-emerald-800/40 dark:bg-emerald-950/30 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-300 backdrop-blur-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Open database · sumber regulasi resmi Indonesia
      </div>

      <!-- Headline -->
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl leading-[1.1]">
        Semua tarif pajak Indonesia,<br class="hidden sm:block"/>
        <span class="gradient-text">satu tempat.</span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Database referensi untuk konsultan, developer, dan finance team — tarif aktif, timeline historis, kode BPPU, TER PPh 21, dan API siap pakai.
      </p>

      <!-- Search -->
      <div class="mt-8 max-w-xl mx-auto animate-in animate-in-delay-1">
        <div class="search-panel relative">
          <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          <input id="hero-search" type="text" placeholder="Cari: PPh 23 jasa, PPN 12%, TER A, kode 24-104..." class="h-14 w-full rounded-2xl border border-slate-200/80 bg-white dark:border-slate-700 dark:bg-slate-900 pl-12 pr-20 text-sm shadow-lg shadow-slate-900/[.04] outline-none transition-all duration-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 dark:focus:border-emerald-500" aria-label="Cari tarif pajak" />
          <kbd class="absolute right-4 top-1/2 hidden -translate-y-1/2 rounded-lg border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-[11px] text-slate-400 dark:border-slate-700 dark:bg-slate-800 sm:inline-flex">⌘K</kbd>
          <div id="hero-search-results" class="absolute left-0 right-0 top-full z-50 mt-2 hidden max-h-80 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-2xl dark:border-slate-700 dark:bg-slate-900"></div>
        </div>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {popular.map((p: string) => <button class="quick-query rounded-full border border-slate-200/80 bg-white dark:border-slate-700 dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-500 dark:text-slate-400 transition-all duration-200 hover:border-slate-300 hover:text-slate-900 dark:hover:border-slate-600 dark:hover:text-white shadow-sm" data-query={p}>{p}</button>)}
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-10 flex flex-wrap justify-center gap-3 animate-in animate-in-delay-2">
        <div class="metric-pill"><div><span class="val">{api.meta.stats.entries}</span> <span class="lbl">jenis tarif</span></div></div>
        <div class="metric-pill"><div><span class="val text-emerald-600 dark:text-emerald-400">{activeEntries.length}</span> <span class="lbl">aktif</span></div></div>
        <div class="metric-pill"><div><span class="val">{api.meta.stats.regulations}</span> <span class="lbl">regulasi</span></div></div>
        <div class="metric-pill"><div><span class="val">{bppuTotal.size}</span> <span class="lbl">kode BPPU</span></div></div>
      </div>
    </div>
  </section>

  <!-- ====== TER FEATURE BANNER ====== -->
  <section class="mt-12 animate-in animate-in-delay-3">
    <a href="/ter-pph-21" class="group block overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 to-slate-800 dark:from-slate-100 dark:to-slate-200 transition-all duration-300 hover:shadow-2xl hover:shadow-slate-900/20">
      <div class="flex items-center justify-between px-6 py-5 sm:px-8 sm:py-6">
        <div class="flex items-center gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/10 dark:bg-slate-900/10 font-mono text-sm font-extrabold text-white dark:text-slate-900 backdrop-blur-sm">TER</div>
          <div>
            <div class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Kalkulator Unggulan</div>
            <h2 class="text-lg sm:text-xl font-extrabold text-white dark:text-slate-900 tracking-tight">TER PPh 21 + Kalkulator Cepat</h2>
            <p class="text-sm text-slate-300 dark:text-slate-500 mt-0.5 hidden sm:block">42 lapisan tarif A/B/C — PP 58/2023</p>
          </div>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-emerald-400 dark:text-emerald-600 shrink-0">
          <span class="hidden sm:inline">Buka</span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </div>
    </a>
  </section>

  <!-- ====== CATEGORY GRID ====== -->
  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <div class="eyebrow">Browse by tax family</div>
        <h2 class="section-title">Kategori Pajak</h2>
      </div>
      <p class="max-w-sm text-sm text-slate-500 dark:text-slate-400">Scan, masuk kategori, lihat dasar hukum dan contoh perhitungan.</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {categories.map((cat: any) => (
        <a href={`/kategori/${cat.slug}`} class="category-card group">
          <div class="mb-3 flex items-center justify-between">
            <div class={`flex h-10 w-10 items-center justify-center rounded-xl ${cat.meta.colorLight}`}>
              <span class="text-base">{cat.meta.icon}</span>
            </div>
            <span class="rounded-lg bg-emerald-50 dark:bg-emerald-950/30 px-2 py-0.5 text-[11px] font-bold text-emerald-700 dark:text-emerald-300">{cat.active} aktif</span>
          </div>
          <h3 class="text-sm font-bold tracking-tight text-slate-900 dark:text-white">{cat.taxType}</h3>
          <p class="mt-1.5 line-clamp-2 text-xs leading-5 text-slate-500 dark:text-slate-400 min-h-[2.5rem]">{cat.description}</p>
          <div class="mt-3 flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-2.5">
            <span class="font-mono text-[11px] text-slate-400">{cat.entries.length} entries</span>
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 transition-all duration-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">Detail →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ====== DATABASE TABLE ====== -->
  <section class="mt-16">
    <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
      <!-- Sidebar Filters -->
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="card p-4">
          <div class="mb-3 px-2 text-xs font-bold uppercase tracking-[.14em] text-slate-400">Filter</div>
          <div class="space-y-1.5">
            <button id="filter-berlaku" class="filter-pill active" data-status="berlaku">
              <span class="flex items-center gap-2">Aktif / berlaku</span>
              <span>{activeEntries.length}</span>
            </button>
            <button id="filter-semua" class="filter-pill" data-status="all">
              <span class="flex items-center gap-2">Semua status</span>
              <span>{entries.length}</span>
            </button>
            <a href="/kode-objek-pajak" class="filter-pill">
              <span class="flex items-center gap-2">Kode BPPU</span>
              <span>{bppuTotal.size}</span>
            </a>
            <a href="/api-docs" class="filter-pill">
              <span class="flex items-center gap-2">API docs</span>
              <span>JSON</span>
            </a>
          </div>
        </div>

        <!-- Trust section -->
        <div class="mt-4 card p-4">
          <div class="mb-3 px-2 text-xs font-bold uppercase tracking-[.14em] text-slate-400">Sumber & trust</div>
          <div class="space-y-2">
            <a href="https://peraturan.bpk.go.id" target="_blank" class="trust-row"><span>JDIH BPK</span><b>regulasi resmi ↗</b></a>
            <a href="https://pasal.id" target="_blank" class="trust-row"><span>Pasal.id</span><b>pasal & naskah ↗</b></a>
            <a href="/api-docs" class="trust-row"><span>Static API</span><b>JSON/CDN ↗</b></a>
          </div>
        </div>
      </aside>

      <!-- Main Table -->
      <div>
        <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
          <div>
            <div class="eyebrow">Database</div>
            <h2 class="section-title">Tarif Pajak Lengkap</h2>
          </div>
          <div id="visible-count" class="rounded-lg bg-slate-100 dark:bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400">Menampilkan {activeEntries.length} tarif aktif</div>
        </div>

        <div class="card overflow-hidden">
          <!-- Desktop Table -->
          <div class="hidden overflow-auto custom-scrollbar md:block" style="max-height:70vh">
            <table class="data-table data-table-pro" id="main-table">
              <thead>
                <tr>
                  <th>Kategori</th>
                  <th>Jenis transaksi</th>
                  <th>Tarif</th>
                  <th>Dasar pengenaan</th>
                  <th class="text-center">BPPU</th>
                  <th>Status</th>
                  <th>Masa berlaku</th>
                </tr>
              </thead>
              <tbody>
                {entries.map((e: FE) => (
                  <tr data-status={e.status}>
                    <td><a href={`/kategori/${e.slug}`} class="category-token">{e.category}</a></td>
                    <td>
                      <a href={`/kategori/${e.slug}`} class="block max-w-xl text-sm font-semibold text-slate-800 hover:text-slate-900 dark:text-slate-200 dark:hover:text-white transition-colors">{e.type}</a>
                      <div class="mt-0.5 font-mono text-[10px] text-slate-400">{e.id}</div>
                    </td>
                    <td><span class="rate-chip">{e.rate}</span></td>
                    <td class="max-w-[200px] text-xs text-slate-500 dark:text-slate-400">{e.basis}</td>
                    <td class="text-center">{e.bppu > 0 ? <a href="/kode-objek-pajak" class="font-mono text-xs font-bold text-slate-700 hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400 hover:underline transition-colors">{e.bppu}</a> : <span class="text-slate-300 dark:text-slate-600">—</span>}</td>
                    <td><span class={`badge ${sb[e.status] || 'badge-belum-berlaku'}`}>{sl[e.status]}</span></td>
                    <td><span class="whitespace-nowrap font-mono text-[11px] text-slate-500">{e.from} → {e.to}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <!-- Mobile Cards -->
          <div class="space-y-2 p-3 md:hidden" id="mobile-list">
            {entries.map((e: FE) => (
              <a href={`/kategori/${e.slug}`} data-status={e.status} class="mobile-card block rounded-xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">
                <div class="mb-2 flex items-center justify-between gap-2">
                  <span class="category-token">{e.category}</span>
                  <span class={`badge ${sb[e.status] || 'badge-belum-berlaku'}`}>{sl[e.status]}</span>
                </div>
                <div class="text-sm font-semibold text-slate-900 dark:text-white">{e.type}</div>
                <div class="mt-3 flex items-center justify-between gap-3">
                  <span class="rate-chip">{e.rate}</span>
                  <span class="font-mono text-[11px] text-slate-400">{e.from} → {e.to}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== DEV SECTION ====== -->
  <section class="mt-16">
    <div class="grid gap-4 md:grid-cols-3">
      <div class="card-hover p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/30 mb-4">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div class="eyebrow">For agents</div>
        <h3 class="mt-1 text-lg font-bold tracking-tight text-slate-900 dark:text-white">LLM-ready context</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed">Gunakan <code class="font-mono text-xs bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded">/llms.txt</code> dan endpoint JSON untuk MCP/agent pajak.</p>
      </div>
      <div class="card-hover p-6 md:col-span-2">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div>
            <div class="eyebrow">API terbuka</div>
            <h3 class="mt-1 text-lg font-bold tracking-tight text-slate-900 dark:text-white">Static JSON, cepat, bisa di-cache</h3>
          </div>
          <a href="/api-docs" class="btn-primary text-xs">Lihat API docs →</a>
        </div>
        <div class="code-block text-xs">curl https://tarif-pajak-id.pages.dev/api/v1/index.json</div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const fb = document.getElementById('filter-berlaku'), fs2 = document.getElementById('filter-semua'), t = document.getElementById('main-table'), vc = document.getElementById('visible-count');
  function setStatus(s: string) {
    let count = 0;
    t?.querySelectorAll('tbody tr').forEach(r => { const show = s === 'all' || r.dataset.status === s; (r as HTMLElement).style.display = show ? '' : 'none'; if (show) count++; });
    document.querySelectorAll('#mobile-list .mobile-card').forEach(c => { const show = s === 'all' || c.dataset.status === s; (c as HTMLElement).style.display = show ? '' : 'none'; });
    document.querySelectorAll('.filter-pill').forEach(el => el.classList.remove('active'));
    (s === 'berlaku' ? fb : fs2)?.classList.add('active');
    if (vc) vc.textContent = s === 'all' ? `Menampilkan ${count} tarif` : `Menampilkan ${count} tarif aktif`;
  }
  fb?.addEventListener('click', () => setStatus('berlaku'));
  fs2?.addEventListener('click', () => setStatus('all'));
  setStatus('berlaku');

  const inp = document.getElementById('hero-search') as HTMLInputElement, res = document.getElementById('hero-search-results');
  let db: ReturnType<typeof setTimeout>;
  function runSearch() {
    clearTimeout(db); db = setTimeout(async () => {
      if (!inp || inp.value.length < 2) { res?.classList.add('hidden'); return; }
      const d = await (await fetch('/api/v1/search-index.json')).json(), q = inp.value.toLowerCase(), m: string[] = [];
      for (const [k, ids] of Object.entries(d.keywords)) { if (k.includes(q)) for (const id of (ids as string[])) if (!m.includes(id)) m.push(id); }
      if (!m.length) { if (res) { res.innerHTML = '<div class="px-5 py-4 text-sm text-slate-500">Tidak ketemu. Coba kata kunci lain.</div>'; res.classList.remove('hidden'); } return; }
      const fmt = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
      if (res) { res.innerHTML = m.slice(0, 8).map(id => `<a href="/kategori/${id.split('-').slice(0,2).join('-')}" class="flex items-center gap-3 border-b border-slate-100 dark:border-slate-800 px-5 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"><div class="h-9 w-9 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex items-center justify-center text-xs font-bold">T</div><div><div class="text-sm font-semibold text-slate-900 dark:text-slate-100">${fmt(id)}</div><div class="mt-0.5 font-mono text-[10px] text-slate-400">${id}</div></div></a>`).join(''); res.classList.remove('hidden'); }
    }, 160);
  }
  inp?.addEventListener('input', runSearch);
  document.querySelectorAll('.quick-query').forEach(btn => btn.addEventListener('click', () => { if (inp) { inp.value = (btn as HTMLElement).dataset.query || ''; inp.focus(); runSearch(); } }));
  inp?.addEventListener('blur', () => setTimeout(() => res?.classList.add('hidden'), 220));
  document.addEventListener('keydown', e => { if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); inp?.focus(); } });
</script>
