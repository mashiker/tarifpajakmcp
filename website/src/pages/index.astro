---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';
import DatabaseToolbar from '../components/database/DatabaseToolbar.astro';
import DatabaseTable from '../components/database/DatabaseTable.astro';
import DatabaseCards from '../components/database/DatabaseCards.astro';
import DeterminationNotice from '../components/database/DeterminationNotice.astro';
import { buildDatabaseDataset } from '../lib/dataset.ts';
import {
  parseDatabaseState,
  filterDatabaseRows,
  summarizeDatabaseRows,
  deriveRowStatus,
  DEFAULT_DATABASE_STATE,
} from '../lib/database-state.ts';

// Load the canonical v2 rules corpus generated by the pipeline. This is the
// single source of truth for the database experience: the v1 aggregate stays
// available for compatibility, but the root surfaces v2.
const corpusPath = path.resolve(process.cwd(), 'public/api/v2/rules-corpus.json');
const corpus = JSON.parse(fs.readFileSync(corpusPath, 'utf-8'));
const dataset = buildDatabaseDataset(corpus);

// Deterministic "today" for the status filter (Task 9 Mn2 fix). The dataset is
// a fixed snapshot anchored to the v2 release generatedAt — using it (not
// `new Date()`) means the status chip counts are reproducible across two
// builds at the same release.
const releaseToday: string = (() => {
  const generatedAt = dataset.release?.generatedAt;
  if (typeof generatedAt === 'string' && generatedAt.length >= 10) {
    return generatedAt.slice(0, 10);
  }
  // Fallback: the latest validFrom across the dataset. Stable per release.
  return dataset.rows
    .map((r) => r.validFrom)
    .sort()
    .reverse()[0]?.slice(0, 10) ?? '2026-08-06';
})();

// Server-render with the default state so the initial HTML is meaningful (no
// FOUC, SEO-readable). The client re-applies the URL state on hydration.
const initialState = DEFAULT_DATABASE_STATE;
const visible = filterDatabaseRows(dataset.rows, initialState, releaseToday);
const summary = summarizeDatabaseRows(dataset.rows, visible);

// Status counts for the toolbar chips. All five chips are now wired (Task 9
// Mn2 fix): berlaku=open-ended in-effect, diubah=superseded-but-visible,
// belum_berlaku=future validFrom, dicabut=non-superseded past end date.
const statusCounts: Record<string, number> = {
  all: dataset.rows.length,
  berlaku: 0,
  diubah: 0,
  belum_berlaku: 0,
  dicabut: 0,
};
for (const r of dataset.rows) {
  const s = deriveRowStatus(r, releaseToday);
  statusCounts[s] = (statusCounts[s] ?? 0) + 1;
}

// Category metadata for pills/dots. Approved palette: deep teal accent, with
// category-specific hues kept soft so the table reads as a reference sheet.
const CATEGORY_COLOR: Record<string, string> = {
  'pph-21': '#2563EB',
  'pph-23': '#6366F1',
  'pph-badan': '#0E5E58',
  'pph-final-umkm': '#059669',
  'pph-special-regimes': '#7C3AED',
  'ppn': '#16A34A',
};
const categoryMeta: Record<string, { name: string; color?: string }> = {};
for (const cat of dataset.categories) {
  categoryMeta[cat.slug] = { name: cat.name, color: CATEGORY_COLOR[cat.slug] };
}

// Pick a sensible default date label for the UI: the latest validFrom so the
// initial view shows currently-applicable rules. The URL state stays empty.
const defaultDateHint = dataset.rows
  .map((r) => r.validFrom)
  .sort()
  .reverse()[0]?.slice(0, 10) ?? '';

const releaseLabel = dataset.release.generatedAt
  ? new Date(dataset.release.generatedAt).toISOString().slice(0, 10)
  : '';

// Dataset JSON-LD for the root page (Task 10). Generated by the pipeline from
// the same v2 corpus + release, embedded here so the root page's JSON-LD never
// drifts from the public/dataset-jsonld.json artifact.
import { CANONICAL_ORIGIN } from '../lib/seo.ts';
const datasetJsonLdPath = path.resolve(process.cwd(), 'public/dataset-jsonld.json');
let datasetJsonLd: Record<string, unknown> = {};
try {
  const raw = JSON.parse(fs.readFileSync(datasetJsonLdPath, 'utf-8'));
  if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
    datasetJsonLd = raw as Record<string, unknown>;
  }
} catch {
  // Fallback: minimal shape so the JSON-LD block is always present. The build
  // contract asserts the artifact exists, so this is a defensive default.
  datasetJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Tarif Pajak ID — Database Tarif Pajak Indonesia',
    url: `${CANONICAL_ORIGIN}/`,
  };
}
---

<BaseLayout
  title="Database Tarif Pajak Indonesia"
  activeNav="home"
  wide={true}
  fullWidth={true}
  canonicalPath="/"
  description="Database tarif pajak Indonesia: PPh, PPN, PPh Final/UMKM. Filter berdasarkan kategori, status, verifikasi, dan tanggal. URL berbagi; sumber primer resmi."
  jsonLd={datasetJsonLd}
>

  <section class="db-hero" aria-labelledby="db-title">
    <div class="db-hero-main">
      <h1 id="db-title" class="db-title">Database Tarif Pajak Indonesia</h1>
      <p class="db-subtitle">
        Sumber regulasi resmi · {dataset.rows.length} aturan · {dataset.categories.length} kategori
        {releaseLabel && <> · diperbarui {releaseLabel}</>}
      </p>
    </div>
    <dl class="db-stats" aria-label="Statistik dataset">
      <div class="db-stat"><dt>Aturan</dt><dd>{dataset.rows.length}</dd></div>
      <div class="db-stat"><dt>Aktif</dt><dd>{statusCounts.berlaku}</dd></div>
      <div class="db-stat"><dt>Konflik</dt><dd>{dataset.conflictCount}</dd></div>
      <div class="db-stat"><dt>Kategori</dt><dd>{dataset.categories.length}</dd></div>
    </dl>
  </section>

  <DatabaseToolbar
    state={initialState}
    categories={dataset.categories}
    statusCounts={statusCounts}
    totalCount={dataset.rows.length}
    conflictCount={dataset.conflictCount}
  />

  <section class="db-results" aria-labelledby="db-results-heading">
    <h2 id="db-results-heading" class="sr-only">Hasil database</h2>
    <p id="db-visible-count" class="db-visible-count" role="status" aria-live="polite" aria-atomic="true">
      {summary.visibleLabel}
    </p>
    {defaultDateHint && (
      <p class="db-default-date-hint">
        Tanpa tanggal terpilih, tabel menampilkan seluruh aturan. Tanggal default yang disarankan:
        <button type="button" class="db-date-suggest" data-date={defaultDateHint}>{defaultDateHint}</button>
      </p>
    )}

    <div id="db-empty-state" class="db-empty-state" hidden>
      <DeterminationNotice kind="empty" />
    </div>

    <div class="db-desktop-table">
      <DatabaseTable rows={visible} categoryMeta={categoryMeta} />
    </div>
    <div class="db-mobile-cards">
      <DatabaseCards rows={visible} categoryMeta={categoryMeta} />
    </div>
  </section>

  <aside class="db-disclaimer" aria-label="Disclaimer">
    <p>
      Database ini adalah referensi bersumber dari regulasi resmi Republik Indonesia, bukan nasihat pajak resmi.
      Konteks fakta transaksi menentukan penerapan tarif. {dataset.conflictCount > 0 && <>Sebanyak {dataset.conflictCount} konflik sumber sedang ditinjau.</>}
    </p>
  </aside>
</BaseLayout>

<script is:inline define:vars={{ RELEASE_TODAY: releaseToday, STATUS_COUNTS: statusCounts }}>
  // Expose the deterministic release anchor and pre-computed status counts so
  // the inline client script below can apply the status filter without needing
  // the corpus embedded twice. The status counts also let the toolbar chips
  // render server-side with accurate counters and stay in sync client-side.
  window.__DB_RELEASE_TODAY__ = RELEASE_TODAY;
  window.__DB_STATUS_COUNTS__ = STATUS_COUNTS;
</script>

<script>
  // Wire the pure helpers to the URL. The page renders server-side with the
  // default state; on load we re-apply the URL so deep links work.
  //
  // CRITICAL: the server-rendered rows already contain the rich timeline +
  // verification cells. The client NEVER rebuilds them; it only toggles the
  // `hidden` attribute based on the pure `isRowVisible` helper. This preserves
  // the timeline signature and verification badges across hydration.
  //
  // Implementation note (Task 11 fix): this script is a Vite-PROCESSED module
  // (no `is:inline`) so the imports below are bundled and served from
  // /_astro/*.js. The previous version used `is:inline` with dynamic
  // `import('/src/lib/*.ts')` calls, which 404 under static hosting because
  // the source modules are never emitted to dist/. That broke every
  // client-side behaviour (URL filters, status chips, sort, deep links) in
  // production; the E2E gate in Task 11 surfaced it.
  import {
    parseDatabaseState,
    serializeDatabaseState,
    filterDatabaseRows,
    summarizeDatabaseRows,
    DEFAULT_DATABASE_STATE,
  } from '../lib/database-state.ts';
  import { isRowVisible } from '../lib/database-markup.ts';

  // Deterministic release anchor + pre-computed status counts. The status
  // filter is reproducible across two builds at the same release because
  // "today" is the v2 release generatedAt, not `new Date()`. These are
  // written to window by the small `is:inline` block above so the processed
  // module can read them without re-bundling the data.
  const RELEASE_TODAY = (window as any).__DB_RELEASE_TODAY__ || '';
  const STATUS_COUNTS = (window as any).__DB_STATUS_COUNTS__ || {};

  // Index the server-rendered DOM nodes. A concept with multiple rules emits
  // multiple <tr>/<li> nodes that share the same data-id (one per rule), so we
  // keep ARRAYS keyed by the underlying RULE node rather than a Map keyed by
  // concept id — the previous Map collapsed multi-rule concepts to a single
  // node and left the other rule rows stranded visible during filtering.
  const tableBody = document.querySelector('#db-table tbody');
  const cardsList = document.getElementById('db-mobile-list');
  const emptyState = document.getElementById('db-empty-state');
  const visibleCount = document.getElementById('db-visible-count');
  const tableRowNodes = [];           // HTMLTableRowElement[] (all rule rows)
  const cardItemNodes = [];           // HTMLLIElement[] (all rule cards' <li>)
  // The full dataset is embedded on the server-rendered rows via data-*.
  // Reconstruct the row records from the DOM so the client never needs
  // the corpus to be embedded twice.
  const allRowRecords = []; // { id, node }
  function readRowFromNode(node) {
    // The server-rendered nodes carry the immutable fields on data-*. The
    // mutable display fields (rate, name, validFrom, validToExclusive,
    // verification, conflict, superseded) are recovered from data attributes
    // added by the shared markup helper. See database-markup.ts.
    const id = node.dataset.id || '';
    const ruleId = node.dataset.rule || '';
    const category = node.dataset.category || '';
    const conflict = node.dataset.conflict === 'true';
    const verification = node.dataset.verification || 'summary_only';
    const name = node.dataset.name || '';
    const rate = node.dataset.rate || '';
    const validFrom = node.dataset.validFrom || '';
    const validToExclusive = node.dataset.validToExclusive || null;
    const superseded = node.dataset.superseded === 'true';
    return {
      id, ruleId, category, conflict, verification, name, rate, validFrom, validToExclusive, superseded,
    };
  }

  if (tableBody) {
    tableBody.querySelectorAll('tr.db-row').forEach((tr) => {
      const id = tr.dataset.id || '';
      tableRowNodes.push(tr);
      allRowRecords.push({ id, node: tr });
    });
  }
  if (cardsList) {
    cardsList.querySelectorAll('.db-card').forEach((a) => {
      const id = a.dataset.id || '';
      const li = a.closest('li');
      if (li) cardItemNodes.push(li);
      // Don't double-add to allRowRecords; the table is the canonical
      // record source. If only cards exist (mobile-only), still capture.
      if (!tableBody) {
        allRowRecords.push({ id, node: a });
      }
    });
  }

  // Helpers to read/write inputs. Form values are the source of truth
  // while the user is interacting; URL is updated from them.
  const form = document.getElementById('db-toolbar');
  const inputQ = document.getElementById('db-input-q');
  const inputDate = document.getElementById('db-input-date');
  const inputCategory = document.getElementById('db-input-category');
  const inputSort = document.getElementById('db-input-sort');
  const statusChips = form ? form.querySelectorAll('[data-status]') : [];
  const verificationChips = form ? form.querySelectorAll('[data-verification]') : [];
  const clearBtn = document.getElementById('db-clear');

  let currentState = parseDatabaseState(window.location.search + window.location.hash);
  let lastSerialized = serializeDatabaseState(currentState);

  function currentStateFromForm() {
    const next = {
      q: (inputQ.value || '').trim().toLowerCase(),
      date: inputDate.value.trim(),
      category: inputCategory.value,
      status: currentState.status,
      verification: currentState.verification,
      sort: inputSort.value,
    };
    return parseDatabaseState(serializeDatabaseState(next));
  }

  // Compute the sticky table-header offset from the toolbar's measured
  // bottom. The toolbar sits beneath the global header (h-14 = 3.5rem);
  // the table header must sit beneath the toolbar. Recompute on resize.
  //
  // PENTING: tinggi toolbar berubah SETELAH `load` — webfont Inter swap
  // membuat chips wrap ulang (357px → 248px) tanpa memicu event resize,
  // sehingga offset hasil ukur awal jadi basi dan thead "melayang" jauh di
  // bawah toolbar. Karena itu: (1) clamp dengan tinggi layout (offsetHeight)
  // yang selalu benar saat toolbar stuck, (2) ukur ulang via ResizeObserver
  // + document.fonts.ready, bukan hanya resize/load.
  function syncStickyOffset() {
    const toolbar = document.getElementById('db-toolbar');
    const root = document.documentElement;
    if (!toolbar || !root) return;
    const headerH = parseFloat(getComputedStyle(root).getPropertyValue('--header-height')) || 56;
    // Posisi bawah toolbar SAAT STUCK = header + tinggi layoutnya. Ini
    // titik tempel thead yang benar, tidak terpengaruh scroll.
    const stuckBottom = headerH + toolbar.offsetHeight;
    const rectBottom = toolbar.getBoundingClientRect().bottom;
    const offsetPx = Math.max(Math.min(rectBottom, stuckBottom), headerH);
    root.style.setProperty('--db-th-top', offsetPx + 'px');
  }
  window.addEventListener('resize', syncStickyOffset);
  window.addEventListener('load', syncStickyOffset);
  // Run after DOMContentLoaded so layout is settled.
  syncStickyOffset();
  // Re-measure once fonts/layout settle.
  setTimeout(syncStickyOffset, 0);
  // Font swap mengubah tinggi chips tanpa event resize — ukur ulang.
  document.fonts?.ready?.then(syncStickyOffset).catch(() => {});
  // Perubahan ukuran toolbar apa pun (wrap, konten, font) memicu ukur ulang.
  if (typeof ResizeObserver !== 'undefined') {
    const toolbarEl = document.getElementById('db-toolbar');
    if (toolbarEl) new ResizeObserver(syncStickyOffset).observe(toolbarEl);
  }

  function applyState(state, opts) {
    // Toggle `hidden` on each row/card based on the pure per-rule test.
    //
    // Visibility is evaluated PER NODE (rule), not per concept id. A concept
    // with multiple rules emits multiple <tr>/<li> nodes, and each rule has its
    // own [validFrom, validToExclusive) interval — a temporal/status filter can
    // include rule-a of a concept while excluding rule-b. The previous logic
    // computed a per-id visibility set, which leaked non-matching rules of a
    // partially-matching concept. Task 11 E2E gate surfaced this on the
    // exact-date filter (a 2022-onward rule stayed visible at date=2010-01-01).
    //
    // `allRowRecords` and the node arrays carry one entry per rule node, so we
    // compute a Set of NODE references that are visible, then toggle each node.
    const visibleNodes = new Set();
    const visibleRecords = [];
    for (const entry of allRowRecords) {
      const record = readRowFromNode(entry.node);
      const show = isRowVisible(record, { ...state, today: RELEASE_TODAY });
      if (show) {
        visibleNodes.add(entry.node);
        visibleRecords.push(record);
      }
    }

    if (tableBody) {
      for (const tr of tableRowNodes) {
        if (visibleNodes.has(tr)) tr.removeAttribute('hidden');
        else tr.setAttribute('hidden', '');
      }
    }
    if (cardsList) {
      // Cards mirror the table's PER-RULE decision, not the per-concept one.
      // Both the table rows and the cards carry `data-rule` (the underlying
      // rule id, unique per rule node) — see database-markup.ts
      // renderDatabaseRow / renderDatabaseCard. A concept with multiple rules
      // emits multiple cards sharing one `data-id` (concept id) but distinct
      // `data-rule` values, so pairing by `data-rule` is what makes a
      // temporal/status filter show only the matching rule's card.
      //
      // Task 11 review (Important): the previous code paired by `data-id`
      // (concept id), so when any rule of a concept matched, EVERY card for
      // that concept stayed visible — leaking non-matching rule cards on
      // mobile (e.g. rule-illustrative-flat-new stayed visible at
      // date=2024-06-01 because rule-...-old matched). Pairing by `data-rule`
      // fixes this; single-rule concepts are unaffected.
      //
      // When the table is absent (cards-only build path), the card node was
      // indexed directly in allRowRecords, so visibleNodes contains it.
      for (const li of cardItemNodes) {
        if (!li) continue;
        const card = li.querySelector('.db-card');
        let show = false;
        if (card) {
          // 1. Cards-only path: the card itself is in visibleNodes.
          if (visibleNodes.has(card)) show = true;
          // 2. Table present: pair this card to its table row by data-rule.
          if (!show && tableBody) {
            const cardRuleId = card.dataset.rule || '';
            if (cardRuleId) {
              show = tableRowNodes.some(
                (tr) => (tr.dataset.rule || '') === cardRuleId && visibleNodes.has(tr),
              );
            }
          }
        }
        if (show) li.removeAttribute('hidden');
        else li.setAttribute('hidden', '');
      }
    }

    // Sort: reorder DOM nodes to match the deterministic filter order.
    // filterDatabaseRows is id-sorted (within a sort key), and the server
    // rendered rows in id-ascending order, so for sort=category the DOM
    // order already matches. For other sort keys we move nodes.
    const ordered = filterDatabaseRows(visibleRecords, state, RELEASE_TODAY);
    const orderIndex = new Map(ordered.map((r, i) => [r.id, i]));
    if (tableBody) {
      const rows = tableRowNodes.filter((tr) => !tr.hasAttribute('hidden'));
      rows.sort((a, b) => (orderIndex.get(a.dataset.id || '') ?? 0) - (orderIndex.get(b.dataset.id || '') ?? 0));
      for (const tr of rows) tableBody.appendChild(tr);
    }
    if (cardsList) {
      const lis = cardItemNodes.filter((li) => li && !li.hasAttribute('hidden'));
      lis.sort((a, b) => {
        const aid = a.querySelector('.db-card')?.dataset.id || '';
        const bid = b.querySelector('.db-card')?.dataset.id || '';
        return (orderIndex.get(aid) ?? 0) - (orderIndex.get(bid) ?? 0);
      });
      for (const li of lis) cardsList.appendChild(li);
    }

    const summary = summarizeDatabaseRows(
      allRowRecords.map((e) => readRowFromNode(e.node)),
      ordered,
    );
    if (visibleCount) visibleCount.textContent = summary.visibleLabel;
    if (emptyState) emptyState.hidden = ordered.length > 0;

    // Sync form controls to the new state.
    if (inputQ && document.activeElement !== inputQ) inputQ.value = state.q;
    if (inputDate && document.activeElement !== inputDate) inputDate.value = state.date;
    if (inputCategory) inputCategory.value = state.category;
    if (inputSort) inputSort.value = state.sort;
    statusChips.forEach((b) => {
      const active = b.dataset.status === state.status;
      b.classList.toggle('db-chip-active', active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    verificationChips.forEach((b) => {
      const active = b.dataset.verification === state.verification;
      b.classList.toggle('db-chip-active', active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    currentState = state;
    const serialized = serializeDatabaseState(state);
    if (serialized !== lastSerialized) {
      if (opts && opts.push) {
        window.history.pushState(null, '', serialized || '/');
      } else {
        window.history.replaceState(null, '', serialized || '/');
      }
      lastSerialized = serialized;
    }
  }

  // Input listeners. Typing into search/date uses replaceState; committed
  // changes (selects, chips, Enter) use pushState.
  let debounceTimer = null;
  function debouncedReplace() {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      applyState(currentStateFromForm(), { push: false });
    }, 150);
  }
  inputQ?.addEventListener('input', debouncedReplace);
  inputDate?.addEventListener('input', debouncedReplace);

  function committedPush() { applyState(currentStateFromForm(), { push: true }); }
  inputCategory?.addEventListener('change', committedPush);
  inputSort?.addEventListener('change', committedPush);
  inputDate?.addEventListener('change', committedPush);
  inputQ?.addEventListener('change', committedPush);

  statusChips.forEach((b) => {
    b.addEventListener('click', () => {
      const next = { ...currentStateFromForm(), status: b.dataset.status };
      applyState(parseDatabaseState(serializeDatabaseState(next)), { push: true });
    });
  });
  verificationChips.forEach((b) => {
    b.addEventListener('click', () => {
      const next = { ...currentStateFromForm(), verification: b.dataset.verification };
      applyState(parseDatabaseState(serializeDatabaseState(next)), { push: true });
    });
  });

  clearBtn?.addEventListener('click', () => {
    applyState({ ...DEFAULT_DATABASE_STATE }, { push: true });
    if (inputQ) inputQ.value = '';
    if (inputDate) inputDate.value = '';
    if (inputCategory) inputCategory.value = 'all';
    if (inputSort) inputSort.value = 'category';
    // Focus management on filter reset (Task 9 a11y): move focus to the
    // search input so keyboard/SR users have an obvious next action and
    // are not stranded on a button whose effect they cannot see.
    if (inputQ) {
      inputQ.focus();
      inputQ.scrollIntoView({ block: 'center' });
    }
  });

  // Date suggestion button (visible default date).
  document.querySelectorAll('.db-date-suggest').forEach((b) => {
    b.addEventListener('click', () => {
      const date = b.dataset.date || '';
      if (inputDate) inputDate.value = date;
      applyState({ ...currentStateFromForm(), date }, { push: true });
    });
  });

  // popstate: re-apply whatever the URL holds.
  window.addEventListener('popstate', () => {
    const next = parseDatabaseState(window.location.search + window.location.hash);
    applyState(next, { push: false });
  });

  // Initial hydration. NOTE: the server already rendered with the default
  // state. If the URL matches the default (the common case), this is a
  // no-op that leaves the rich server-rendered DOM untouched.
  const urlState = parseDatabaseState(window.location.search + window.location.hash);
  const isDefaultUrl = serializeDatabaseState(urlState) === '';
  if (!isDefaultUrl) {
    applyState(urlState, { push: false });
  } else {
    // Still sync form controls to defaults and ensure sticky offset.
    currentState = DEFAULT_DATABASE_STATE;
    syncStickyOffset();
  }
</script>

<style>
  .db-hero {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
    padding-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .db-title { font-size: 1.375rem; font-weight: 700; letter-spacing: -0.01em; color: var(--ink, #132A2A); margin: 0; }
  .db-subtitle { font-size: 0.8125rem; color: var(--ink-secondary, #44545a); margin: 0.25rem 0 0; }
  .db-stats { display: flex; gap: 1rem; margin: 0; }
  .db-stat { display: flex; flex-direction: column; gap: 0; }
  .db-stat dt { font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-tertiary, #8B93A1); font-weight: 600; }
  .db-stat dd { margin: 0; font-family: 'IBM Plex Mono', monospace; font-size: 1rem; font-weight: 700; color: var(--ink, #132A2A); }

  .db-results { padding-top: 0.75rem; }
  .db-visible-count {
    font-size: 0.75rem;
    color: var(--ink-secondary, #44545a);
    margin: 0 0 0.5rem;
  }
  .db-default-date-hint {
    font-size: 0.6875rem;
    color: var(--ink-tertiary, #8B93A1);
    margin: 0 0 0.75rem;
  }
  .db-date-suggest {
    display: inline-block;
    margin-left: 0.25rem;
    padding: 0.0625rem 0.375rem;
    border-radius: 0.25rem;
    border: 1px solid var(--rule, #D9E0DC);
    background: var(--surface, #FFFFFF);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: #0E5E58;
    cursor: pointer;
  }
  .db-date-suggest:hover { border-color: #0E5E58; }

  .db-desktop-table { display: none; }
  .db-mobile-cards { display: block; }
  @media (min-width: 768px) {
    .db-desktop-table { display: block; }
    .db-mobile-cards { display: none; }
  }

  .db-disclaimer {
    margin-top: 1.5rem;
