---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

const categoryIcons: Record<string, string> = {
  'PPh 21': '👤', 'PPh 22': '📦', 'PPh 23': '🔧', 'PPh 26': '🌍',
  'PPh Badan': '🏢', 'PPh UMKM': '🏪', 'PPh 4(2) Final': '💰',
  'PPN': '🧾', 'PPnBM': '💎', 'Bea Meterai': '📋'
};
---

<BaseLayout title="Beranda">
  <!-- Hero -->
  <section class="text-center py-12 mb-8">
    <h1 class="text-4xl sm:text-5xl font-extrabold mb-4 bg-gradient-to-r from-blue-400 via-emerald-400 to-amber-400 bg-clip-text text-transparent">
      Database Tarif Pajak Indonesia
    </h1>
    <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-6">
      Database terbuka berisi tarif pajak Indonesia dari 1983 hingga saat ini. 
      Bersumber dari regulasi resmi, lengkap dengan status berlaku/dicabut, dasar hukum, dan riwayat perubahan.
    </p>
    <div class="flex justify-center gap-4 text-sm">
      <div class="bg-gray-800 rounded-lg px-4 py-2">
        <span class="text-2xl font-bold text-white">{api.meta.stats.entries}</span>
        <span class="text-gray-400 ml-1">Tarif</span>
      </div>
      <div class="bg-gray-800 rounded-lg px-4 py-2">
        <span class="text-2xl font-bold text-white">{api.meta.stats.regulations}</span>
        <span class="text-gray-400 ml-1">Regulasi</span>
      </div>
      <div class="bg-gray-800 rounded-lg px-4 py-2">
        <span class="text-2xl font-bold text-white">{api.meta.stats.categories.length}</span>
        <span class="text-gray-400 ml-1">Kategori</span>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section>
    <h2 class="text-2xl font-bold mb-6">Kategori Pajak</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {api.meta.stats.categories.map((cat: any) => {
        const slug = cat.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-');
        return (
          <a href={`/kategori/${slug}`} 
             class="group block bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-gray-600 hover:bg-gray-800/50 transition-all">
            <div class="flex items-center justify-between mb-3">
              <span class="text-2xl">{categoryIcons[cat.taxType] || '📊'}</span>
              <span class="text-gray-500 text-sm">{cat.count} tarif</span>
            </div>
            <h3 class="font-semibold text-white group-hover:text-blue-400 transition text-lg">{cat.taxType}</h3>
            <p class="text-gray-500 text-sm mt-1">Kategori {cat.taxType}</p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- API Section -->
  <section class="mt-12 bg-gray-900 border border-gray-800 rounded-xl p-8">
    <h2 class="text-2xl font-bold mb-4">🔌 API Terbuka</h2>
    <p class="text-gray-400 mb-4">Akses database tarif pajak Indonesia dalam format JSON. Gratis untuk digunakan oleh chatbot, aplikasi, atau integrasi apapun.</p>
    <div class="bg-gray-950 rounded-lg p-4 font-mono text-sm overflow-x-auto">
      <span class="text-gray-500">$ curl</span> <span class="text-emerald-400">https://tarif-pajak-id.vercel.app/api.json</span>
    </div>
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
      <a href="/api.json" class="bg-gray-800 rounded-lg p-3 hover:bg-gray-700 transition">
        <span class="text-blue-400 font-semibold">/api.json</span>
        <p class="text-gray-500 mt-1">Database lengkap</p>
      </a>
      <a href="/rates.json" class="bg-gray-800 rounded-lg p-3 hover:bg-gray-700 transition">
        <span class="text-emerald-400 font-semibold">/rates.json</span>
        <p class="text-gray-500 mt-1">Tarif ternormalisasi</p>
      </a>
      <a href="/regulations.json" class="bg-gray-800 rounded-lg p-3 hover:bg-gray-700 transition">
        <span class="text-purple-400 font-semibold">/regulations.json</span>
        <p class="text-gray-500 mt-1">Metadata regulasi</p>
      </a>
    </div>
  </section>

  <!-- Data Sources -->
  <section class="mt-8 bg-gray-900 border border-gray-800 rounded-xl p-8">
    <h2 class="text-xl font-bold mb-4">📚 Sumber Data</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <a href="https://pasal.id" target="_blank" class="flex items-center gap-3 bg-gray-800 rounded-lg p-4 hover:bg-gray-700 transition">
        <span class="text-2xl">⚖️</span>
        <div>
          <div class="text-white font-semibold">Pasal.id</div>
          <div class="text-gray-400">40,000+ peraturan Indonesia</div>
        </div>
      </a>
      <a href="https://peraturan.bpk.go.id" target="_blank" class="flex items-center gap-3 bg-gray-800 rounded-lg p-4 hover:bg-gray-700 transition">
        <span class="text-2xl">🏛️</span>
        <div>
          <div class="text-white font-semibold">JDIH BPK</div>
          <div class="text-gray-400">Database peraturan resmi</div>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
