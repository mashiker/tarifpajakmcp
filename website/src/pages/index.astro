---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

// Flatten all entries for the main table
type FlatEntry = {
  category: string;
  categorySlug: string;
  transactionType: string;
  id: string;
  status: string;
  rate: string;
  taxBase: string;
  payer: string;
  effectiveFrom: string;
  effectiveTo: string;
  bppuKode: { kode: string; nama: string; tarif: number }[] | null;
};

const allEntries: FlatEntry[] = [];
api.categories.forEach((cat: any) => {
  const slug = cat.taxType.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-');
  cat.entries.forEach((entry: any) => {
    let rateStr = '';
    if (entry.rate.type === 'percentage') rateStr = `${entry.rate.value}%`;
    else if (entry.rate.type === 'range') rateStr = `${entry.rate.value[0]}%–${entry.rate.value[1]}%`;
    else if (entry.rate.type === 'progressive' && entry.rate.brackets) rateStr = entry.rate.brackets.map((b: any) => `${b.rate}%`).join(' / ');
    else rateStr = String(entry.rate.value);

    allEntries.push({
      category: cat.taxType,
      categorySlug: slug,
      transactionType: entry.transactionType,
      id: entry.id,
      status: entry.status,
      rate: rateStr,
      taxBase: entry.taxBase,
      payer: entry.payer,
      effectiveFrom: entry.effectiveFrom,
      effectiveTo: entry.effectiveTo || 'sekarang',
      bppuKode: entry.bppuKode || null,
    });
  });
});

const statusOrder: Record<string, number> = { berlaku: 0, diubah: 1, belum_berlaku: 2, dicabut: 3 };
allEntries.sort((a, b) => (statusOrder[a.status] ?? 9) - (statusOrder[b.status] ?? 9));

const statusBadge: Record<string, string> = {
  'berlaku': 'badge-berlaku',
  'dicabut': 'badge-dicabut',
  'diubah': 'badge-diubah',
  'belum_berlaku': 'badge-belum-berlaku',
};
const statusLabel: Record<string, string> = {
  'berlaku': '✓ Berlaku',
  'dicabut': '✗ Dicabut',
  'diubah': '⟳ Diubah',
  'belum_berlaku': '○ Belum Berlaku',
};

// Count total unique BPPU codes
const bppuCodeSet = new Set<string>();
allEntries.forEach(e => e.bppuKode?.forEach(b => bppuCodeSet.add(b.kode)));
---

<BaseLayout title="Beranda">
  <!-- Stats bar -->
  <div class="flex items-center gap-6 mb-4 text-sm">
    <div class="flex items-center gap-4 text-gray-500">
      <span><strong class="text-gray-900">{api.meta.stats.entries}</strong> tarif</span>
      <span class="text-gray-300">|</span>
      <span><strong class="text-gray-900">{api.meta.stats.regulations}</strong> regulasi</span>
      <span class="text-gray-300">|</span>
      <span><strong class="text-gray-900">{api.meta.stats.categories.length}</strong> kategori</span>
      <span class="text-gray-300">|</span>
      <span><strong class="text-gray-900">{bppuCodeSet.size}</strong> <a href="/kode-objek-pajak" class="text-blue-600 hover:underline">kode BPPU</a></span>
    </div>
    <div class="flex-1"></div>
    <div class="hidden md:flex items-center gap-2 text-xs">
      <a href="/api.json" class="legal-tag">/api.json</a>
      <a href="/rates.json" class="legal-tag">/rates.json</a>
      <a href="/regulations.json" class="legal-tag">/regulations.json</a>
    </div>
  </div>

  <!-- Main Data Table -->
  <div class="border border-gray-200 rounded-lg overflow-hidden">
    <div class="overflow-x-auto">
      <table class="tax-table" id="main-table">
        <thead>
          <tr>
            <th>Kategori</th>
            <th>Jenis Transaksi</th>
            <th>ID</th>
            <th>Tarif</th>
            <th>Kode BPPU</th>
            <th>Status</th>
            <th>Berlaku</th>
          </tr>
        </thead>
        <tbody>
          {allEntries.map((entry: FlatEntry) => (
            <tr>
              <td>
                <a href={`/kategori/${entry.categorySlug}`} class="cat-link font-medium">{entry.category}</a>
              </td>
              <td class="font-medium text-gray-900">
                <a href={`/kategori/${entry.categorySlug}`} class="hover:text-blue-600 transition">{entry.transactionType}</a>
              </td>
              <td class="mono text-gray-500">{entry.id}</td>
              <td><span class="rate-value">{entry.rate}</span></td>
              <td>
                {entry.bppuKode && entry.bppuKode.length > 0 ? (
                  <a href="/kode-objek-pajak" class="text-blue-600 hover:underline text-xs font-mono">
                    {entry.bppuKode.length === 1 
                      ? entry.bppuKode[0].kode 
                      : `${entry.bppuKode[0].kode.split('-').slice(0,2).join('-')}-xx (${entry.bppuKode.length})`}
                  </a>
                ) : (
                  <span class="text-gray-300 text-xs">—</span>
                )}
              </td>
              <td><span class={`badge ${statusBadge[entry.status] || 'badge-belum-berlaku'}`}>{statusLabel[entry.status] || entry.status}</span></td>
              <td class="mono text-gray-500 text-xs">{entry.effectiveFrom} → {entry.effectiveTo}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- API & Sources -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <h3 class="text-sm font-semibold text-gray-700 mb-2">API Terbuka</h3>
      <div class="code-block">
        <span class="text-gray-400">$</span> curl <span class="text-emerald-600">https://tarif-pajak-id.vercel.app/api.json</span>
      </div>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-gray-700 mb-2">Sumber Data</h3>
      <div class="flex gap-3">
        <a href="https://pasal.id" target="_blank" class="legal-tag py-1.5 px-3 text-xs">⚖️ Pasal.id ↗</a>
        <a href="https://peraturan.bpk.go.id" target="_blank" class="legal-tag py-1.5 px-3 text-xs">🏛️ JDIH BPK ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>
