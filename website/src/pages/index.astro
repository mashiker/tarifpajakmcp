---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, ''); }

const catMeta: Record<string, { icon: string; color: string; colorLight: string }> = {
  'pph-21': { icon: '👤', color: 'text-blue-600 dark:text-blue-400', colorLight: 'bg-blue-50 dark:bg-blue-950/30' },
  'pph-22': { icon: '🏭', color: 'text-violet-600 dark:text-violet-400', colorLight: 'bg-violet-50 dark:bg-violet-950/30' },
  'pph-23': { icon: '📋', color: 'text-indigo-600 dark:text-indigo-400', colorLight: 'bg-indigo-50 dark:bg-indigo-950/30' },
  'pph-26': { icon: '🌍', color: 'text-cyan-600 dark:text-cyan-400', colorLight: 'bg-cyan-50 dark:bg-cyan-950/30' },
  'pph-badan': { icon: '🏢', color: 'text-emerald-600 dark:text-emerald-400', colorLight: 'bg-emerald-50 dark:bg-emerald-950/30' },
  'pph-umkm': { icon: '🏪', color: 'text-amber-600 dark:text-amber-400', colorLight: 'bg-amber-50 dark:bg-amber-950/30' },
  'pph-4-2-final': { icon: '✅', color: 'text-teal-600 dark:text-teal-400', colorLight: 'bg-teal-50 dark:bg-teal-950/30' },
  'ppn': { icon: '💰', color: 'text-emerald-600 dark:text-emerald-400', colorLight: 'bg-emerald-50 dark:bg-emerald-950/30' },
  'ppnbm': { icon: '🏷️', color: 'text-rose-600 dark:text-rose-400', colorLight: 'bg-rose-50 dark:bg-rose-950/30' },
  'bea-meterai': { icon: '📄', color: 'text-orange-600 dark:text-orange-400', colorLight: 'bg-orange-50 dark:bg-orange-950/30' },
  'pbb': { icon: '🏠', color: 'text-sky-600 dark:text-sky-400', colorLight: 'bg-sky-50 dark:bg-sky-950/30' },
  'bphtb': { icon: '🏗️', color: 'text-lime-600 dark:text-lime-400', colorLight: 'bg-lime-50 dark:bg-lime-950/30' },
  'bea-masuk': { icon: '🚢', color: 'text-slate-600 dark:text-slate-400', colorLight: 'bg-slate-100 dark:bg-slate-800' },
  'cukai': { icon: '🍷', color: 'text-fuchsia-600 dark:text-fuchsia-400', colorLight: 'bg-fuchsia-50 dark:bg-fuchsia-950/30' },
  'pajak-daerah': { icon: '🏛️', color: 'text-pink-600 dark:text-pink-400', colorLight: 'bg-pink-50 dark:bg-pink-950/30' },
};

const categories = api.categories.map((cat: any) => {
  const slug = toSlug(cat.taxType);
  const active = cat.entries.filter((e: any) => e.status === 'berlaku').length;
  const meta = catMeta[slug] || { icon: '📊', color: 'text-slate-600 dark:text-slate-400', colorLight: 'bg-slate-100 dark:bg-slate-800' };
  return { ...cat, slug, active, meta };
});

const activeEntries = api.categories.flatMap((cat: any) => cat.entries.filter((e: any) => e.status === 'berlaku'));
const bppuTotal = new Set<string>();
api.categories.forEach((cat: any) => cat.entries.forEach((e: any) => e.bppuKode?.forEach((b: any) => bppuTotal.add(b.kode))));
---

<BaseLayout title="Database Tarif Pajak Indonesia" activeNav="home" description="Database tarif pajak Indonesia terbuka: PPh, PPN, BPPU, TER PPh 21, regulasi resmi, dan API JSON statis untuk developer.">

  <!-- ====== HERO ====== -->
  <section class="hero-gradient relative overflow-hidden -mx-4 -mt-8 px-4 pt-16 pb-20 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 lg:pt-24 lg:pb-28">
    <div class="absolute inset-0 hero-grid-bg pointer-events-none"></div>

    <div class="relative mx-auto max-w-3xl text-center animate-in">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-200/80 bg-emerald-50/80 dark:border-emerald-800/40 dark:bg-emerald-950/30 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-300 backdrop-blur-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Open database · sumber regulasi resmi Indonesia
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl leading-[1.1]">
        Semua tarif pajak Indonesia,<br class="hidden sm:block"/>
        <span class="gradient-text">satu tempat.</span>
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-500 dark:text-slate-400 max-w-xl mx-auto leading-relaxed">
        Database referensi untuk konsultan, developer, dan finance team — tarif aktif, timeline historis, kode BPPU, TER PPh 21, dan API siap pakai.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-8 flex flex-wrap justify-center gap-3 animate-in animate-in-delay-1">
        <a href="/database" class="btn-primary px-6 py-3 text-base">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
          Buka Database
        </a>
        <a href="/api-docs" class="btn-secondary px-6 py-3 text-base">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          API Docs
        </a>
      </div>

      <!-- Stats -->
      <div class="mt-10 flex flex-wrap justify-center gap-3 animate-in animate-in-delay-2">
        <div class="metric-pill"><span class="val">{api.meta.stats.entries}</span> <span class="lbl">jenis tarif</span></div>
        <div class="metric-pill"><span class="val text-emerald-600 dark:text-emerald-400">{activeEntries.length}</span> <span class="lbl">aktif</span></div>
        <div class="metric-pill"><span class="val">{api.meta.stats.regulations}</span> <span class="lbl">regulasi</span></div>
        <div class="metric-pill"><span class="val">{bppuTotal.size}</span> <span class="lbl">kode BPPU</span></div>
      </div>
    </div>
  </section>

  <!-- ====== FEATURES ====== -->
  <section class="mt-16">
    <div class="text-center mb-10">
      <div class="eyebrow">Fitur Utama</div>
      <h2 class="section-title mt-1">Semua yang kamu butuhkan</h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <!-- TER Calculator -->
      <a href="/ter-pph-21" class="group card-hover p-6 flex flex-col">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 dark:bg-blue-950/30 mb-4">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">TER PPh 21 + Kalkulator</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">42 lapisan tarif A/B/C berdasarkan PP 58/2023. Hitung langsung penghasilan bruto bulanan.</p>
        <div class="mt-4 text-xs font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">Buka kalkulator →</div>
      </a>

      <!-- Database -->
      <a href="/database" class="group card-hover p-6 flex flex-col">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 dark:bg-emerald-950/30 mb-4">
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Database Tarif Lengkap</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">{api.meta.stats.entries} jenis tarif dari 15 kategori pajak. Filter berdasarkan status, cari cepat, lihat dasar hukum.</p>
        <div class="mt-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">Browse database →</div>
      </a>

      <!-- BPPU -->
      <a href="/kode-objek-pajak" class="group card-hover p-6 flex flex-col">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-50 dark:bg-violet-950/30 mb-4">
          <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Kode BPPU</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">{bppuTotal.size} kode objek pajak lengkap dengan tarif, nama, dan mapping ke entry terkait.</p>
        <div class="mt-4 text-xs font-semibold text-violet-600 dark:text-violet-400 group-hover:translate-x-1 transition-transform">Lihat kode BPPU →</div>
      </a>

      <!-- API -->
      <a href="/api-docs" class="group card-hover p-6 flex flex-col">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-950/30 mb-4">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Static JSON API</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">Open API tanpa auth. Fetch langsung dari CDN, bisa di-cache, siap dipakai agent dan MCP.</p>
        <div class="mt-4 text-xs font-semibold text-indigo-600 dark:text-indigo-400 group-hover:translate-x-1 transition-transform">Lihat API docs →</div>
      </a>

      <!-- LLM Ready -->
      <a href="/llms.txt" class="group card-hover p-6 flex flex-col">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 dark:bg-amber-950/30 mb-4">
          <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">LLM-Ready Context</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">Gunakan /llms.txt dan endpoint JSON untuk MCP, agent pajak, atau integrasi AI tools lainnya.</p>
        <div class="mt-4 text-xs font-semibold text-amber-600 dark:text-amber-400 group-hover:translate-x-1 transition-transform">Lihat llms.txt →</div>
      </a>

      <!-- Open Source -->
      <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="group card-hover p-6 flex flex-col">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 mb-4">
          <svg class="w-5 h-5 text-slate-600 dark:text-slate-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Open Source</h3>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">Data dan kode terbuka di GitHub. Kontribusi, issue, dan pull request welcome.</p>
        <div class="mt-4 text-xs font-semibold text-slate-600 dark:text-slate-400 group-hover:translate-x-1 transition-transform">GitHub ↗</div>
      </a>
    </div>
  </section>

  <!-- ====== CATEGORY PREVIEW ====== -->
  <section class="mt-16">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <div class="eyebrow">Browse by tax family</div>
        <h2 class="section-title">15 Kategori Pajak</h2>
      </div>
      <a href="/database" class="btn-secondary text-xs">Lihat semua di database →</a>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {categories.slice(0, 10).map((cat: any) => (
        <a href={`/kategori/${cat.slug}`} class="category-card group">
          <div class="mb-2 flex items-center justify-between">
            <div class={`flex h-9 w-9 items-center justify-center rounded-xl ${cat.meta.colorLight}`}>
              <span class="text-sm">{cat.meta.icon}</span>
            </div>
            <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400">{cat.active} aktif</span>
          </div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white truncate">{cat.taxType}</h3>
          <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
            <span class="font-mono">{cat.entries.length} entries</span>
            <span class="font-semibold text-slate-500 dark:text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">→</span>
          </div>
        </a>
      ))}
    </div>
    <!-- Show remaining categories link -->
    {categories.length > 10 && (
      <div class="mt-3 text-center">
        <a href="/database" class="text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
          + {categories.length - 10} kategori lainnya →
        </a>
      </div>
    )}
  </section>

  <!-- ====== TRUST ====== -->
  <section class="mt-16">
    <div class="text-center mb-6">
      <div class="eyebrow">Sumber terpercaya</div>
      <h2 class="section-title mt-1">Bersumber dari regulasi resmi</h2>
    </div>

    <div class="grid gap-3 sm:grid-cols-3 max-w-2xl mx-auto">
      <a href="https://peraturan.bpk.go.id" target="_blank" class="card-hover p-5 text-center group">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 mx-auto mb-3">
          <svg class="w-5 h-5 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <div class="text-sm font-bold text-slate-900 dark:text-white">JDIH BPK</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Regulasi resmi ↗</div>
      </a>
      <a href="https://pasal.id" target="_blank" class="card-hover p-5 text-center group">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 mx-auto mb-3">
          <svg class="w-5 h-5 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div class="text-sm font-bold text-slate-900 dark:text-white">Pasal.id</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Pasal & naskah ↗</div>
      </a>
      <a href="/api-docs" class="card-hover p-5 text-center group">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 dark:bg-slate-800 mx-auto mb-3">
          <svg class="w-5 h-5 text-slate-600 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <div class="text-sm font-bold text-slate-900 dark:text-white">Static API</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">JSON/CDN open ↗</div>
      </a>
    </div>
  </section>

  <!-- ====== QUICK API DEMO ====== -->
  <section class="mt-16">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <div>
          <div class="eyebrow">Coba API</div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">Static JSON, tanpa auth</h3>
        </div>
        <a href="/api-docs" class="btn-secondary text-xs">Semua endpoints →</a>
      </div>
      <div class="code-block text-xs">
        <span class="text-emerald-400">$</span> curl https://tarif-pajak-id.pages.dev/api/v1/index.json<br/>
        <span class='text-slate-500'>&#123;</span><span class='text-slate-400'> "stats": &#123; "entries": {api.meta.stats.entries}, "regulations": {api.meta.stats.regulations} &#125; ...</span>
      </div>
    </div>
  </section>
</BaseLayout>
