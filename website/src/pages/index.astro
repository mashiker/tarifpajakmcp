---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-'); }

// Category colors & labels (no emoji — use solid color dots)
const catColors: Record<string, { bg: string; text: string; dot: string }> = {
  'pph-21':        { bg: 'bg-blue-100 dark:bg-blue-900/40', text: 'text-blue-700 dark:text-blue-300', dot: 'bg-blue-500' },
  'pph-22':        { bg: 'bg-indigo-100 dark:bg-indigo-900/40', text: 'text-indigo-700 dark:text-indigo-300', dot: 'bg-indigo-500' },
  'pph-23':        { bg: 'bg-violet-100 dark:bg-violet-900/40', text: 'text-violet-700 dark:text-violet-300', dot: 'bg-violet-500' },
  'pph-26':        { bg: 'bg-purple-100 dark:bg-purple-900/40', text: 'text-purple-700 dark:text-purple-300', dot: 'bg-purple-500' },
  'pph-badan':     { bg: 'bg-cyan-100 dark:bg-cyan-900/40', text: 'text-cyan-700 dark:text-cyan-300', dot: 'bg-cyan-500' },
  'pph-umkm':      { bg: 'bg-teal-100 dark:bg-teal-900/40', text: 'text-teal-700 dark:text-teal-300', dot: 'bg-teal-500' },
  'pph-4-2-final': { bg: 'bg-emerald-100 dark:bg-emerald-900/40', text: 'text-emerald-700 dark:text-emerald-300', dot: 'bg-emerald-500' },
  'ppn':           { bg: 'bg-green-100 dark:bg-green-900/40', text: 'text-green-700 dark:text-green-300', dot: 'bg-green-500' },
  'ppnbm':         { bg: 'bg-amber-100 dark:bg-amber-900/40', text: 'text-amber-700 dark:text-amber-300', dot: 'bg-amber-500' },
  'bea-meterai':   { bg: 'bg-orange-100 dark:bg-orange-900/40', text: 'text-orange-700 dark:text-orange-300', dot: 'bg-orange-500' },
  'pbb':           { bg: 'bg-rose-100 dark:bg-rose-900/40', text: 'text-rose-700 dark:text-rose-300', dot: 'bg-rose-500' },
  'bphtb':         { bg: 'bg-pink-100 dark:bg-pink-900/40', text: 'text-pink-700 dark:text-pink-300', dot: 'bg-pink-500' },
  'bea-masuk':     { bg: 'bg-sky-100 dark:bg-sky-900/40', text: 'text-sky-700 dark:text-sky-300', dot: 'bg-sky-500' },
  'cukai':         { bg: 'bg-red-100 dark:bg-red-900/40', text: 'text-red-700 dark:text-red-300', dot: 'bg-red-500' },
  'pajak-daerah':  { bg: 'bg-lime-100 dark:bg-lime-900/40', text: 'text-lime-700 dark:text-lime-300', dot: 'bg-lime-500' },
};

const categories = api.categories.map((cat: any) => {
  const slug = toSlug(cat.taxType);
  const active = cat.entries.filter((e: any) => e.status === 'berlaku').length;
  const colors = catColors[slug] || { bg: 'bg-gray-100 dark:bg-gray-800', text: 'text-gray-700 dark:text-gray-300', dot: 'bg-gray-500' };
  return { ...cat, slug, active, colors };
});

type FE = { category: string; slug: string; type: string; id: string; status: string; rate: string; from: string; to: string; bppu: number; };

const entries: FE[] = [];
api.categories.forEach((cat: any) => {
  const slug = toSlug(cat.taxType);
  cat.entries.forEach((e: any) => {
    let r = '';
    if (e.rate.type === 'percentage') r = `${e.rate.value}%`;
    else if (e.rate.type === 'range') r = `${e.rate.value[0]}–${e.rate.value[1]}%`;
    else if (e.rate.type === 'progressive' && e.rate.brackets) r = e.rate.brackets.map((b: any) => `${b.rate}%`).join(' / ');
    else r = String(e.rate.value);
    entries.push({ category: cat.taxType, slug, type: e.transactionType, id: e.id, status: e.status, rate: r, from: e.effectiveFrom, to: e.effectiveTo || '—', bppu: e.bppuKode?.length || 0 });
  });
});

const so: Record<string, number> = { berlaku: 0, diubah: 1, belum_berlaku: 2, dicabut: 3 };
entries.sort((a, b) => (so[a.status] ?? 9) - (so[b.status] ?? 9));

const sb: Record<string, string> = { berlaku: 'badge-berlaku', dicabut: 'badge-dicabut', diubah: 'badge-diubah', belum_berlaku: 'badge-belum-berlaku' };
const sl: Record<string, string> = { berlaku: 'Berlaku', dicabut: 'Dicabut', diubah: 'Diubah', belum_berlaku: 'Belum' };

const activeEntries = entries.filter(e => e.status === 'berlaku');
const bppuTotal = new Set<string>();
api.categories.forEach((cat: any) => cat.entries.forEach((e: any) => e.bppuKode?.forEach((b: any) => bppuTotal.add(b.kode))));
---

<BaseLayout title="Beranda" activeNav="home">
  <!-- Hero -->
  <div class="text-center mb-8 pt-2">
    <h1 class="text-2xl sm:text-4xl font-black text-gray-900 dark:text-gray-50 tracking-tight mb-2">
      Tarif Pajak Indonesia
    </h1>
    <p class="text-gray-500 dark:text-gray-400 max-w-lg mx-auto mb-5 text-sm sm:text-base">
      Referensi lengkap tarif pajak dari <strong class="text-gray-700 dark:text-gray-300">1983</strong> hingga sekarang. Bersumber dari regulasi resmi.
    </p>
    <div class="max-w-md mx-auto relative">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <input id="hero-search" type="text" placeholder="Cari tarif pajak..." class="search-input text-sm" aria-label="Cari tarif pajak" />
      <kbd class="hidden sm:inline-flex absolute right-3 top-1/2 -translate-y-1/2 text-[10px] text-gray-400 bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded px-1.5 py-0.5 font-mono pointer-events-none">⌘K</kbd>
      <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-1 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl shadow-xl max-h-72 overflow-y-auto hidden z-50 custom-scrollbar"></div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-2xl mx-auto mb-8">
    <div class="stat-card"><div class="stat-value">{api.meta.stats.entries}</div><div class="stat-label">Jenis Tarif</div></div>
    <div class="stat-card"><div class="stat-value">{api.meta.stats.regulations}</div><div class="stat-label">Regulasi</div></div>
    <div class="stat-card"><div class="stat-value">{categories.length}</div><div class="stat-label">Kategori</div></div>
    <div class="stat-card"><div class="stat-value">{bppuTotal.size}</div><div class="stat-label">Kode BPPU</div></div>
  </div>

  <!-- Category Grid -->
  <section class="mb-8">
    <h2 class="section-heading mb-3">Kategori Pajak</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      {categories.map((cat: any) => (
        <a href={`/kategori/${cat.slug}`} class="category-card flex items-center gap-3">
          <div class={`w-10 h-10 rounded-xl ${cat.colors.bg} ${cat.colors.text} flex items-center justify-center font-bold text-xs shrink-0`}>
            {cat.taxType.replace(/[^A-Z0-9]/g, '').substring(0, 3) || cat.taxType.substring(0, 3)}
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-gray-900 dark:text-gray-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors truncate">{cat.taxType}</div>
            <div class="text-[11px] text-gray-400 font-mono">{cat.active} aktif · {cat.entries.length} total</div>
          </div>
          <svg class="w-4 h-4 text-gray-300 dark:text-gray-600 group-hover:text-brand-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      ))}
    </div>
  </section>

  <!-- Table -->
  <section class="mb-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="section-heading">Tabel Tarif Lengkap</h2>
      <div class="flex gap-1.5">
        <button id="filter-berlaku" class="chip chip-active" data-status="berlaku"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Aktif ({activeEntries.length})</button>
        <button id="filter-semua" class="chip chip-default" data-status="all">Semua ({entries.length})</button>
      </div>
    </div>
    <div class="card overflow-hidden">
      <div class="overflow-auto custom-scrollbar" style="max-height:70vh">
        <table class="data-table" id="main-table">
          <thead>
            <tr>
              <th>Kategori</th>
              <th>Jenis Transaksi</th>
              <th>Tarif</th>
              <th class="hidden lg:table-cell">Kode BPPU</th>
              <th>Status</th>
              <th class="hidden sm:table-cell">Masa Berlaku</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((e: FE) => {
              const cc = catColors[e.slug] || { bg: 'bg-gray-100', text: 'text-gray-700', dot: 'bg-gray-400' };
              return (
              <tr data-status={e.status}>
                <td>
                  <a href={`/kategori/${e.slug}`} class="inline-flex items-center gap-1.5">
                    <span class={`w-2 h-2 rounded-full ${cc.dot} shrink-0`}></span>
                    <span class="text-sm font-medium text-gray-900 dark:text-gray-100 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">{e.category}</span>
                  </a>
                </td>
                <td>
                  <a href={`/kategori/${e.slug}`} class="text-sm text-gray-700 dark:text-gray-300 hover:text-brand-600 dark:hover:text-brand-400 transition-colors block truncate max-w-[300px]">{e.type}</a>
                  <div class="text-[10px] text-gray-400 font-mono mt-0.5">{e.id}</div>
                </td>
                <td><span class="rate-value text-sm">{e.rate}</span></td>
                <td class="hidden lg:table-cell">
                  {e.bppu > 0
                    ? <a href="/kode-objek-pajak" class="text-xs font-mono text-brand-600 dark:text-brand-400 hover:underline">{e.bppu} kode</a>
                    : <span class="text-gray-300 text-xs">—</span>}
                </td>
                <td><span class={`badge ${sb[e.status] || 'badge-belum-berlaku'}`}>{sl[e.status]}</span></td>
                <td class="hidden sm:table-cell"><span class="text-xs text-gray-500 font-mono whitespace-nowrap">{e.from} → {e.to}</span></td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Bottom links -->
  <div class="grid sm:grid-cols-2 gap-3">
    <div class="card p-4">
      <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-2">API Terbuka</h3>
      <div class="code-block text-xs">curl https://tarif-pajak-id.pages.dev/api.json</div>
      <p class="text-xs text-gray-400 mt-2">JSON statis · Tanpa auth · Tanpa rate limit</p>
    </div>
    <div class="card p-4">
      <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-2">Sumber Regulasi</h3>
      <div class="flex flex-wrap gap-1.5">
        <a href="https://pasal.id" target="_blank" class="tag">Pasal.id ↗</a>
        <a href="https://peraturan.bpk.go.id" target="_blank" class="tag">JDIH BPK ↗</a>
        <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="tag">GitHub ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const fb = document.getElementById('filter-berlaku'), fs2 = document.getElementById('filter-semua'), t = document.getElementById('main-table');
  function setStatus(s: string) {
    t?.querySelectorAll('tbody tr').forEach(r => { (r as HTMLElement).style.display = (s === 'all' || r.dataset.status === s) ? '' : 'none'; });
    if (s === 'berlaku') { fb?.classList.replace('chip-default', 'chip-active'); fs2?.classList.replace('chip-active', 'chip-default'); }
    else { fs2?.classList.replace('chip-default', 'chip-active'); fb?.classList.replace('chip-active', 'chip-default'); }
  }
  fb?.addEventListener('click', () => setStatus('berlaku'));
  fs2?.addEventListener('click', () => setStatus('all'));

  const inp = document.getElementById('hero-search') as HTMLInputElement, res = document.getElementById('hero-search-results');
  let db: ReturnType<typeof setTimeout>;
  inp?.addEventListener('input', () => { clearTimeout(db); db = setTimeout(async () => {
    if (inp.value.length < 2) { res?.classList.add('hidden'); return; }
    const d = await (await fetch('/api/v1/search-index.json')).json(), q = inp.value.toLowerCase(), m: string[] = [];
    for (const [k, ids] of Object.entries(d.keywords)) { if (k.includes(q)) for (const id of (ids as string[])) if (!m.includes(id)) m.push(id); }
    if (!m.length) { res?.classList.add('hidden'); return; }
    const fmt = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    if (res) { res.innerHTML = m.slice(0, 8).map(id => `<a href="/kategori/${id.split('-').slice(0,2).join('-')}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-800 border-b border-gray-100 dark:border-gray-800"><div class="text-sm font-medium text-gray-900 dark:text-gray-100">${fmt(id)}</div><div class="text-[10px] text-gray-400 font-mono ml-auto">${id}</div></a>`).join(''); res.classList.remove('hidden'); }
  }, 200); });
  inp?.addEventListener('blur', () => setTimeout(() => res?.classList.add('hidden'), 200));
  document.addEventListener('keydown', e => { if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); inp?.focus(); } });
</script>
