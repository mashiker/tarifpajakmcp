---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

function toSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, ''); }

const catColor: Record<string, string> = {
  'pph-21': '#3b82f6', 'pph-22': '#8b5cf6', 'pph-23': '#6366f1', 'pph-26': '#06b6d4',
  'pph-badan': '#0d9488', 'pph-umkm': '#d97706', 'pph-4-2-final': '#059669', 'ppn': '#16a34a',
  'ppnbm': '#e11d48', 'bea-meterai': '#ea580c', 'pbb': '#0284c7', 'bphtb': '#65a30d',
  'bea-masuk': '#475569', 'cukai': '#a21caf', 'pajak-daerah': '#db2777',
};

const categories = api.categories.map((cat: any) => {
  const slug = toSlug(cat.taxType);
  const active = cat.entries.filter((e: any) => e.status === 'berlaku').length;
  const color = catColor[slug] || '#475569';
  return { ...cat, slug, active, color };
});

type FE = { category: string; slug: string; type: string; id: string; status: string; rate: string; from: string; to: string; basis: string; };
const entries: FE[] = [];
api.categories.forEach((cat: any) => {
  const slug = toSlug(cat.taxType);
  cat.entries.forEach((e: any) => {
    let r = '';
    if (e.rate.type === 'percentage') r = `${e.rate.value}%`;
    else if (e.rate.type === 'range') r = `${e.rate.value[0]}–${e.rate.value[1]}%`;
    else if (e.rate.type === 'progressive' && e.rate.brackets) {
      const rates = e.rate.brackets.map((b: any) => b.rate);
      r = e.rate.brackets.length > 8 ? `${Math.min(...rates)}–${Math.max(...rates)}%` : rates.map((x: number) => `${x}%`).join('/');
    }
    else r = String(e.rate.value);
    entries.push({ category: cat.taxType, slug, type: e.transactionType, id: e.id, status: e.status, rate: r, from: e.effectiveFrom, to: e.effectiveTo || 'sekarang', basis: e.taxBase || '—' });
  });
});

const so: Record<string, number> = { berlaku: 0, diubah: 1, belum_berlaku: 2, dicabut: 3 };
entries.sort((a, b) => (so[a.status] ?? 9) - (so[b.status] ?? 9));
const sb: Record<string, string> = { berlaku: 'badge-berlaku', dicabut: 'badge-dicabut', diubah: 'badge-diubah', belum_berlaku: 'badge-belum-berlaku' };
const sl: Record<string, string> = { berlaku: 'Berlaku', dicabut: 'Dicabut', diubah: 'Diubah', belum_berlaku: 'Belum' };

const activeEntries = entries.filter(e => e.status === 'berlaku');
const bppuTotal = new Set<string>();
api.categories.forEach((cat: any) => cat.entries.forEach((e: any) => e.bppuKode?.forEach((b: any) => bppuTotal.add(b.kode))));
---

<BaseLayout title="Database Tarif Pajak Indonesia" activeNav="home" wide={true} description="Database tarif pajak Indonesia terbuka: PPh, PPN, BPPU, TER PPh 21, regulasi resmi, dan API JSON statis untuk developer.">

  <!-- Compact Header -->
  <section class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-4">
      <div>
        <h1 class="text-xl font-bold tracking-tight text-[var(--text)]">Database Tarif Pajak Indonesia</h1>
        <p class="text-sm text-[var(--text-secondary)] mt-0.5">Sumber regulasi resmi · data terbuka</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <div class="metric-pill"><span class="val">{api.meta.stats.entries}</span><span class="lbl">tarif</span></div>
        <div class="metric-pill"><span class="val text-[var(--status-active)]">{activeEntries.length}</span><span class="lbl">aktif</span></div>
        <div class="metric-pill"><span class="val">{api.meta.stats.regulations}</span><span class="lbl">regulasi</span></div>
        <div class="metric-pill"><span class="val">{bppuTotal.size}</span><span class="lbl">BPPU</span></div>
      </div>
    </div>

    <!-- Search -->
    <div class="relative mb-4">
      <input id="home-search" type="text" placeholder="Cari tarif pajak, kategori, atau kode BPPU..." class="w-full h-11 pl-11 pr-4 rounded-lg border border-[var(--border)] bg-[var(--surface)] text-sm text-[var(--text)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/10 transition-all" />
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4.5 h-4.5 text-[var(--text-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    </div>

    <!-- Status Filter Chips -->
    <div class="flex flex-wrap gap-1.5 mb-4" id="status-filters">
      <button class="chip chip-active" data-status="berlaku">Berlaku <span class="ml-1 font-mono text-[11px] opacity-70">{activeEntries.length}</span></button>
      <button class="chip chip-default" data-status="all">Semua <span class="ml-1 font-mono text-[11px] opacity-70">{entries.length}</span></button>
      <button class="chip chip-default" data-status="diubah">Diubah <span class="ml-1 font-mono text-[11px] opacity-70">{entries.filter(e => e.status === 'diubah').length}</span></button>
      <button class="chip chip-default" data-status="dicabut">Dicabut <span class="ml-1 font-mono text-[11px] opacity-70">{entries.filter(e => e.status === 'dicabut').length}</span></button>
    </div>

    <!-- Category Tabs -->
    <div class="flex gap-1.5 overflow-x-auto pb-2 custom-scrollbar" id="category-tabs">
      <button class="chip chip-active shrink-0" data-cat="all">Semua</button>
      {categories.map((cat: any) => (
        <button class="chip chip-default shrink-0" data-cat={cat.slug}>
          <span class="inline-block w-2 h-2 rounded-full shrink-0" style={`background:${cat.color}`}></span>
          {cat.taxType}
          <span class="font-mono text-[11px] opacity-60">{cat.active}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Full Data Table -->
  <section>
    <div class="card overflow-hidden">
      <div class="hidden overflow-auto custom-scrollbar md:block" style="max-height:calc(100vh - 340px)">
        <table class="data-table" id="main-table">
          <thead>
            <tr>
              <th class="w-[130px]">Kategori</th>
              <th>Jenis transaksi</th>
              <th class="w-[100px] text-right">Tarif</th>
              <th class="w-[170px]">Dasar pengenaan</th>
              <th class="w-[80px] text-center">Status</th>
              <th class="w-[160px]">Masa berlaku</th>
            </tr>
          </thead>
          <tbody>
            {entries.map((e: FE) => (
              <tr data-status={e.status} data-cat={e.slug} data-search={`${e.category} ${e.type} ${e.rate} ${e.basis} ${e.id}`.toLowerCase()}>
                <td>
                  <a href={`/kategori/${e.slug}`} class="inline-flex items-center gap-1.5 rounded-md bg-[var(--surface-alt)] px-2 py-0.5 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text)] transition-colors">
                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${catColor[e.slug] || '#475569'}`}></span>
                    {e.category}
                  </a>
                </td>
                <td>
                  <a href={`/kategori/${e.slug}`} class="block max-w-xl text-sm font-medium text-[var(--text)] hover:text-[var(--accent)] transition-colors">{e.type}</a>
                  <div class="mt-0.5 font-mono text-[10px] text-[var(--text-tertiary)]">{e.id}</div>
                </td>
                <td class="text-right"><span class="rate-value text-sm">{e.rate}</span></td>
                <td class="text-xs text-[var(--text-secondary)] truncate max-w-[170px]">{e.basis}</td>
                <td class="text-center"><span class={`badge ${sb[e.status] || 'badge-belum-berlaku'}`}>{sl[e.status]}</span></td>
                <td><span class="whitespace-nowrap font-mono text-[11px] text-[var(--text-tertiary)]">{e.from} → {e.to}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="space-y-2 p-3 md:hidden" id="mobile-list">
        {entries.map((e: FE) => (
          <a href={`/kategori/${e.slug}`} data-status={e.status} data-cat={e.slug} data-search={`${e.category} ${e.type} ${e.rate} ${e.basis}`.toLowerCase()} class="mobile-card block rounded-lg border border-[var(--border)] bg-[var(--surface)] p-3 hover:bg-[var(--surface-alt)] transition-colors">
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-md bg-[var(--surface-alt)] px-1.5 py-0.5 text-[11px] font-semibold text-[var(--text-secondary)]">
                <span class="w-1.5 h-1.5 rounded-full" style={`background:${catColor[e.slug] || '#475569'}`}></span>
                {e.category}
              </span>
              <span class={`badge ${sb[e.status] || 'badge-belum-berlaku'}`}>{sl[e.status]}</span>
            </div>
            <div class="text-sm font-medium text-[var(--text)]">{e.type}</div>
            <div class="mt-2 flex items-center justify-between gap-3">
              <span class="rate-value text-sm">{e.rate}</span>
              <span class="font-mono text-[10px] text-[var(--text-tertiary)]">{e.from} → {e.to}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="mt-3 text-center">
      <span id="visible-count" class="text-xs text-[var(--text-tertiary)]">Menampilkan {activeEntries.length} tarif aktif dari {entries.length} total</span>
    </div>
  </section>

  <!-- Quick Access -->
  <section class="mt-8 grid gap-3 sm:grid-cols-3">
    <a href="/ter-pph-21" class="group card-hover p-4 flex items-center gap-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/30">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
      </div>
      <div>
        <div class="text-sm font-semibold text-[var(--text)]">TER PPh 21</div>
        <div class="text-xs text-[var(--text-tertiary)]">Kalkulator tarif efektif</div>
      </div>
    </a>
    <a href="/kode-objek-pajak" class="group card-hover p-4 flex items-center gap-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-violet-50 dark:bg-violet-950/30">
        <svg class="w-4 h-4 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
      </div>
      <div>
        <div class="text-sm font-semibold text-[var(--text)]">Kode BPPU</div>
        <div class="text-xs text-[var(--text-tertiary)]">{bppuTotal.size} kode objek pajak</div>
      </div>
    </a>
    <a href="/api-docs" class="group card-hover p-4 flex items-center gap-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--accent-soft)]">
        <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
      </div>
      <div>
        <div class="text-sm font-semibold text-[var(--text)]">API Reference</div>
        <div class="text-xs text-[var(--text-tertiary)]">Static JSON, tanpa auth</div>
      </div>
    </a>
  </section>
</BaseLayout>

<script>
  // Status filter
  let currentStatus = 'berlaku';
  let currentCat = 'all';
  let searchQuery = '';

  function filterEntries() {
    let visible = 0;
    const rows = document.querySelectorAll('#main-table tbody tr');
    rows.forEach(r => {
      const status = (r as HTMLElement).dataset.status || '';
      const cat = (r as HTMLElement).dataset.cat || '';
      const search = ((r as HTMLElement).dataset.search || '').toLowerCase();
      const showStatus = currentStatus === 'all' || status === currentStatus;
      const showCat = currentCat === 'all' || cat === currentCat;
      const showSearch = !searchQuery || search.includes(searchQuery);
      const show = showStatus && showCat && showSearch;
      (r as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
    });

    document.querySelectorAll('#mobile-list .mobile-card').forEach(c => {
      const status = (c as HTMLElement).dataset.status || '';
      const cat = (c as HTMLElement).dataset.cat || '';
      const search = ((c as HTMLElement).dataset.search || '').toLowerCase();
      const showStatus = currentStatus === 'all' || status === currentStatus;
      const showCat = currentCat === 'all' || cat === currentCat;
      const showSearch = !searchQuery || search.includes(searchQuery);
      const show = showStatus && showCat && showSearch;
      (c as HTMLElement).style.display = show ? '' : 'none';
    });

    const total = document.querySelectorAll('#main-table tbody tr').length;
    const vc = document.getElementById('visible-count');
    if (vc) vc.textContent = `Menampilkan ${visible} tarif` + (currentStatus !== 'all' ? ' aktif' : '') + ` dari ${total} total`;
  }

  // Status chips
  document.querySelectorAll('#status-filters .chip').forEach(btn => {
    btn.addEventListener('click', () => {
      currentStatus = (btn as HTMLElement).dataset.status || 'all';
      document.querySelectorAll('#status-filters .chip').forEach(b => { b.classList.remove('chip-active'); b.classList.add('chip-default'); });
      btn.classList.remove('chip-default');
      btn.classList.add('chip-active');
      filterEntries();
    });
  });

  // Category tabs
  document.querySelectorAll('#category-tabs .chip').forEach(btn => {
    btn.addEventListener('click', () => {
      currentCat = (btn as HTMLElement).dataset.cat || 'all';
      document.querySelectorAll('#category-tabs .chip').forEach(b => { b.classList.remove('chip-active'); b.classList.add('chip-default'); });
      btn.classList.remove('chip-default');
      btn.classList.add('chip-active');
      filterEntries();
    });
  });

  // Search
  document.getElementById('home-search')?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    filterEntries();
  });

  // Initial filter
  filterEntries();
</script>
