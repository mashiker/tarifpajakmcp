    font-size: 0.6875rem;
    color: var(--ink-tertiary, #8B93A1);
    text-align: left;
    margin-bottom: 0.375rem;
    caption-side: top;
  }
  .ter-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--rule, #D9E0DC);
    border-radius: 0.5rem;
    overflow: hidden;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    background: var(--surface, #FFFFFF);
