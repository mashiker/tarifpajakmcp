---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

const pph21 = api.categories.find((c: any) => c.taxType === 'PPh 21');
if (!pph21) throw new Error('PPh 21 category not found in api.json');

const terA = pph21.entries.find((e: any) => e.id === 'pph-21-ter-a-detail') ?? { rate: { brackets: [] } };
const terB = pph21.entries.find((e: any) => e.id === 'pph-21-ter-b-detail') ?? { rate: { brackets: [] } };
const terC = pph21.entries.find((e: any) => e.id === 'pph-21-ter-c-detail') ?? { rate: { brackets: [] } };

function fmtRp(n: number | null): string {
  if (n === null) return '∞';
  if (n >= 1e9) return `Rp ${(n / 1e9).toLocaleString('id-ID')} miliar`;
  if (n >= 1e6) return `Rp ${(n / 1e6).toLocaleString('id-ID')} juta`;
  return `Rp ${n.toLocaleString('id-ID')}`;
}
---

<BaseLayout title="Tabel TER PPh 21" activeNav="ter">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-1.5 text-xs mb-8 text-[var(--text-tertiary)]">
    <a href="/" class="hover:text-[var(--text)] transition-colors">Beranda</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <a href="/kategori/pph-21" class="hover:text-[var(--text)] transition-colors">PPh 21</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-[var(--text)] font-medium">Tabel TER</span>
  </nav>

  <!-- Page Header -->
  <div class="mb-8">
    <div class="flex items-start gap-4 mb-5">
      <div class="w-12 h-12 rounded-2xl bg-[var(--accent-soft)] flex items-center justify-center text-[var(--accent)] text-lg font-bold shadow-sm shrink-0">T</div>
      <div>
        <h1 class="text-xl font-bold text-[var(--text)] tracking-tight">Tarif Efektif Rata-rata (TER)</h1>
        <p class="text-sm text-[var(--text-secondary)] mt-1">Pemotongan PPh Pasal 21 bulanan berdasarkan PP 58/2023 dan PMK 168/2023</p>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="card p-3">
        <div class="text-[11px] text-[var(--text-secondary)] font-semibold uppercase mb-0.5">Berlaku Sejak</div>
        <div class="text-sm font-bold text-[var(--text)]">1 Januari 2024</div>
      </div>
      <div class="card p-3">
        <div class="text-[11px] text-[var(--accent)] font-semibold uppercase mb-0.5">Menggantikan</div>
        <div class="text-sm font-bold text-[var(--text)]">Metode Progresif</div>
      </div>
      <div class="card p-3">
        <div class="text-[11px] text-[var(--text-secondary)] font-semibold uppercase mb-0.5">Kategori</div>
        <div class="text-sm font-bold text-[var(--text)]">A / B / C</div>
      </div>
      <div class="card p-3">
        <div class="text-[11px] text-[var(--text-secondary)] font-semibold uppercase mb-0.5">Lapisan Tarif</div>
        <div class="text-sm font-bold text-[var(--text)]">42 per kategori</div>
      </div>
    </div>
  </div>

  <!-- Calculator -->
  <div class="card mb-8 overflow-hidden">
    <div class="px-6 py-5 bg-[var(--surface)] border-b border-[var(--border)]">
      <div class="flex items-center gap-2.5 mb-4">
        <div class="flex h-8 w-8 items-center justify-center rounded-[var(--radius)] bg-[var(--accent-soft)]">
          <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <h2 class="text-sm font-bold text-[var(--text)]">Kalkulator Cepat TER PPh 21</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label for="calc-income" class="text-xs text-[var(--text-secondary)] font-medium mb-1.5 block">Penghasilan Bruto Bulanan</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[var(--text-tertiary)] font-mono">Rp</span>
            <input id="calc-income" type="text" placeholder="10.000.000" class="w-full pl-10 pr-3 py-2.5 text-sm bg-[var(--surface)] border border-[var(--border)] rounded-xl focus:ring-2 focus:ring-[var(--accent)]/15 focus:border-[var(--accent)] outline-none font-mono transition-all" />
          </div>
        </div>
        <div>
          <label for="calc-bpjs" class="text-xs text-[var(--text-secondary)] font-medium mb-1.5 block">Iuran Pensiun / BPJS</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-[var(--text-tertiary)] font-mono">Rp</span>
            <input id="calc-bpjs" type="text" placeholder="0" value="0" class="w-full pl-10 pr-3 py-2.5 text-sm bg-[var(--surface)] border border-[var(--border)] rounded-xl focus:ring-2 focus:ring-[var(--accent)]/15 focus:border-[var(--accent)] outline-none font-mono transition-all" />
          </div>
        </div>
        <div>
          <label for="calc-category" class="text-xs text-[var(--text-secondary)] font-medium mb-1.5 block">Status PTKP</label>
          <select id="calc-category" class="w-full py-2.5 px-3 text-sm bg-[var(--surface)] border border-[var(--border)] rounded-xl focus:ring-2 focus:ring-[var(--accent)]/15 focus:border-[var(--accent)] outline-none transition-all">
            <option value="a">TER A — TK/0 (Tidak Kawin, tanpa tanggungan)</option>
            <option value="b">TER B — TK/1-2 atau K/0-2</option>
            <option value="c">TER C — K/3 (Kawin, 3+ tanggungan)</option>
          </select>
        </div>
      </div>
    </div>
    <div id="calc-result" class="px-6 py-5 hidden">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <div class="text-[11px] text-[var(--text-tertiary)] font-medium uppercase">Penghasilan Bruto</div>
          <div id="res-bruto" class="text-sm font-bold text-[var(--text)] font-mono mt-1">—</div>
        </div>
        <div>
          <div class="text-[11px] text-[var(--text-tertiary)] font-medium uppercase">Dasar Pengenaan</div>
          <div id="res-dasar" class="text-sm font-bold text-[var(--text)] font-mono mt-1">—</div>
        </div>
        <div>
          <div class="text-[11px] text-[var(--text-tertiary)] font-medium uppercase">Tarif TER</div>
          <div id="res-rate" class="text-sm font-bold text-[var(--text-secondary)] font-mono mt-1">—</div>
        </div>
        <div>
          <div class="text-[11px] text-[var(--text-tertiary)] font-medium uppercase">PPh 21 / Bulan</div>
          <div id="res-pph" class="text-base font-extrabold text-[var(--accent)] font-mono mt-1">—</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="flex gap-2 mb-6">
    <button id="tab-a" class="ter-tab active">
      <span class="font-bold">TER A</span>
      <span class="text-[10px] opacity-70 block">TK/0</span>
    </button>
    <button id="tab-b" class="ter-tab">
      <span class="font-bold">TER B</span>
      <span class="text-[10px] opacity-70 block">TK/1-2, K/0-2</span>
    </button>
    <button id="tab-c" class="ter-tab">
      <span class="font-bold">TER C</span>
      <span class="text-[10px] opacity-70 block">K/3</span>
    </button>
  </div>

  <!-- TER Tables -->
  {[
    { id: 'a', label: 'TER A — TK/0 (Tidak Kawin, Tanpa Tanggungan)', data: terA },
    { id: 'b', label: 'TER B — TK/1-2 atau K/0-2', data: terB },
    { id: 'c', label: 'TER C — K/3 (Kawin, 3+ Tanggungan)', data: terC },
  ].map((tab: any) => (
    <div id={`table-${tab.id}`} class:list={[tab.id !== 'a' ? 'hidden' : '']}>
      <div class="card overflow-hidden">
        <div class="px-5 py-3 bg-[var(--surface)] border-b border-[var(--border)] flex items-center justify-between">
          <h3 class="text-sm font-bold text-[var(--text)]">{tab.label}</h3>
          <span class="text-[11px] text-[var(--text-tertiary)] font-mono">{tab.data.rate.brackets.length} lapisan</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm" aria-label={`Tabel ${tab.label}`}>
            <thead>
              <tr class="border-b border-[var(--border)] bg-[var(--surface)]">
                <th scope="col" class="text-left px-4 py-3 text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider w-12">No</th>
                <th scope="col" class="text-right px-4 py-3 text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider">Batas Bawah</th>
                <th scope="col" class="text-right px-4 py-3 text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider">Batas Atas</th>
                <th scope="col" class="text-right px-4 py-3 text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider w-20">Tarif</th>
              </tr>
            </thead>
            <tbody>
              {tab.data.rate.brackets.map((b: any, i: number) => {
                const isZero = b.rate === 0;
                const isHigh = b.rate >= 10;
                return (
                  <tr class="border-b border-[var(--border)] hover:bg-[var(--surface-alt)] transition-colors">
                    <td class="px-4 py-2.5 text-[var(--text-tertiary)] font-mono text-xs">{i + 1}</td>
                    <td class="px-4 py-2.5 text-right font-mono text-xs text-[var(--text-secondary)]">{fmtRp(b.min)}</td>
                    <td class="px-4 py-2.5 text-right font-mono text-xs text-[var(--text-secondary)]">
                      {b.max ? fmtRp(b.max) : <span class="text-[var(--text-secondary)] font-semibold">di atas {fmtRp(b.min)}</span>}
                    </td>
                    <td class="px-4 py-2.5 text-right font-mono text-sm">
                      {isZero
                        ? <span class="inline-block bg-[var(--accent-soft)] text-[var(--accent)] px-2.5 py-0.5 rounded-lg text-xs font-semibold ring-1 ring-[var(--accent)]/20">0%</span>
                        : isHigh
                          ? <span class="inline-block bg-red-50 text-red-700 px-2.5 py-0.5 rounded-lg text-xs font-semibold ring-1 ring-red-200/60">{b.rate}%</span>
                          : <span class="text-[var(--text)] font-semibold">{b.rate}%</span>
                      }
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  ))}

  <!-- Guide -->
  <div class="mt-10 card overflow-hidden">
    <div class="px-5 py-3 bg-[var(--highlight-soft)] border-b border-[var(--status-changed)]/20">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[var(--highlight)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <h3 class="text-sm font-bold text-[var(--text)]">Panduan Kategori TER</h3>
      </div>
    </div>
    <div class="p-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-[var(--text)] text-[var(--surface)] text-xs font-bold px-2.5 py-1 rounded-lg">A</span>
            <span class="text-sm font-bold text-[var(--text)]">TK/0</span>
          </div>
          <ul class="text-xs text-[var(--text-secondary)] space-y-1">
            <li>&#8226; Tidak Kawin (TK), 0 tanggungan</li>
            <li>&#8226; PTKP Rp 54.000.000/tahun</li>
            <li>&#8226; Termasuk ditinggal meninggal/cerai tanpa tanggungan</li>
          </ul>
        </div>
        <div class="card p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-[var(--accent)] text-[var(--surface)] text-xs font-bold px-2.5 py-1 rounded-md">B</span>
            <span class="text-sm font-bold text-[var(--text)]">TK/1-2 atau K/0-2</span>
          </div>
          <ul class="text-xs text-[var(--text-secondary)] space-y-1">
            <li>&#8226; Tidak Kawin 1-2 tanggungan (TK/1, TK/2)</li>
            <li>&#8226; Kawin 0-2 tanggungan (K/0, K/1, K/2)</li>
            <li>&#8226; PTKP Rp 58,5–67,5 juta/tahun</li>
          </ul>
        </div>
        <div class="card p-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-[var(--accent)] text-[var(--surface)] text-xs font-bold px-2.5 py-1 rounded-md">C</span>
            <span class="text-sm font-bold text-[var(--text)]">K/3</span>
          </div>
          <ul class="text-xs text-[var(--text-secondary)] space-y-1">
            <li>&#8226; Kawin dengan 3 atau lebih tanggungan (K/3)</li>
            <li>&#8226; PTKP Rp 72.000.000/tahun (tertinggi)</li>
            <li>&#8226; Tarif TER paling ringan di penghasilan sama</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 text-xs text-[var(--text-secondary)] card p-4">
        <strong class="text-[var(--text)]">Dasar Pengenaan TER:</strong> Penghasilan bruto bulanan dikurangi iuran pensiun/BPJS yang dibayar oleh pegawai.
        Tidak lagi diperlukan perhitungan PTKP dan annualisasi seperti metode lama.
        <br/><br/>
        <strong class="text-[var(--text)]">Dasar hukum:</strong> PP 58 Tahun 2023 dan PMK 168/PMK.010/2023.
        Berlaku efektif sejak 1 Januari 2024.
      </div>
    </div>
  </div>

  <!-- Nav -->
  <div class="mt-8 flex items-center justify-between">
    <a href="/kategori/pph-21" class="btn-secondary">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Semua entry PPh 21
    </a>
    <a href="/api/v1/entries/pph-21-ter-a-detail.json" target="_blank" rel="noopener noreferrer" class="tag text-xs">
      API <span class="text-[var(--text-tertiary)]">JSON</span> <span class="text-[var(--text-tertiary)]">&#8599;</span>
    </a>
  </div>
</BaseLayout>

<script define:vars={{ terABrackets: terA.rate.brackets, terBBrackets: terB.rate.brackets, terCBrackets: terC.rate.brackets }}>
  const brackets = { a: terABrackets, b: terBBrackets, c: terCBrackets };
  let activeTab = 'a';

  function parseRp(str) {
    if (!str) return 0;
    return parseInt(str.replace(/\D/g, ''), 10) || 0;
  }

  function formatRp(n) {
    if (n === 0) return 'Rp 0';
    return 'Rp ' + n.toLocaleString('id-ID');
  }

  function switchTab(tab) {
    activeTab = tab;
    document.querySelectorAll('.ter-tab').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + tab)?.classList.add('active');
    ['a', 'b', 'c'].forEach(t => {
      const el = document.getElementById('table-' + t);
      if (el) el.classList.toggle('hidden', t !== tab);
    });
    const sel = document.getElementById('calc-category');
    if (sel) sel.value = tab;
    calculateTER();
  }

  function calculateTER() {
    const income = parseRp(document.getElementById('calc-income')?.value || '');
    const bpjs = parseRp(document.getElementById('calc-bpjs')?.value || '0');
    const dasar = Math.max(0, income - bpjs);
    const resultEl = document.getElementById('calc-result');

    if (income <= 0) { resultEl?.classList.add('hidden'); return; }
    resultEl?.classList.remove('hidden');

    const bracket = brackets[activeTab];
    let rate = 0;
    for (const b of bracket) {
      if (b.max === null) { rate = b.rate; break; }
      if (dasar >= b.min && dasar <= b.max) { rate = b.rate; break; }
    }
    // Fallback: if no bracket matched, use last bracket rate
    if (rate === 0 && bracket.length > 0) {
      rate = bracket[bracket.length - 1].rate;
    }

    const pph = Math.round(dasar * rate / 100);

    const brutoEl = document.getElementById('res-bruto');
    const dasarEl = document.getElementById('res-dasar');
    const rateEl = document.getElementById('res-rate');
    const pphEl = document.getElementById('res-pph');
    if (brutoEl) brutoEl.textContent = formatRp(income);
    if (dasarEl) dasarEl.textContent = formatRp(dasar);
    if (rateEl) rateEl.textContent = rate + '%';
    if (pphEl) pphEl.textContent = formatRp(pph);
  }

  // Add event listeners (no inline handlers)
  document.getElementById('calc-income')?.addEventListener('input', calculateTER);
  document.getElementById('calc-bpjs')?.addEventListener('input', calculateTER);
  document.getElementById('calc-category')?.addEventListener('change', (e) => {
    switchTab(e.target.value);
  });
  document.getElementById('tab-a')?.addEventListener('click', () => switchTab('a'));
  document.getElementById('tab-b')?.addEventListener('click', () => switchTab('b'));
  document.getElementById('tab-c')?.addEventListener('click', () => switchTab('c'));
</script>
