  .ter-table-hidden { display: none; }
  .ter-table-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }
  .ter-table-title { font-size: 0.875rem; font-weight: 700; color: var(--ink, #132A2A); margin: 0; }
  .ter-table-count { font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; color: var(--ink-tertiary, #8B93A1); }
