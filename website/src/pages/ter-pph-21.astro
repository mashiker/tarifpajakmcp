  .ter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .ter-tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.5rem 0.875rem;
