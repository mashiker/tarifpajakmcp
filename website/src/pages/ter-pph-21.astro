  .ter-calc-result-label {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-tertiary, #8B93A1);
  }
  .ter-calc-result-value {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink, #132A2A);
    margin-top: 0.25rem;
  }
