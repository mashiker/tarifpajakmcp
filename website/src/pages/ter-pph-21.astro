---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

const apiPath = path.resolve(process.cwd(), 'public/api.json');
const api = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));

const pph21 = api.categories.find((c: any) => c.taxType === 'PPh 21');
const terA = pph21.entries.find((e: any) => e.id === 'pph-21-ter-a-detail');
const terB = pph21.entries.find((e: any) => e.id === 'pph-21-ter-b-detail');
const terC = pph21.entries.find((e: any) => e.id === 'pph-21-ter-c-detail');

function fmtRp(n: number | null): string {
  if (n === null) return '∞';
  if (n >= 1e9) return `Rp ${(n / 1e9).toLocaleString('id-ID')} miliar`;
  if (n >= 1e6) return `Rp ${(n / 1e6).toLocaleString('id-ID')} juta`;
  return `Rp ${n.toLocaleString('id-ID')}`;
}
---

<BaseLayout title="Tabel TER PPh 21" activeNav="home">
  <nav class="flex items-center gap-1.5 text-xs mb-6 text-slate-400">
    <a href="/" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Beranda</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <a href="/kategori/pph-21" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">PPh 21</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-slate-700 dark:text-slate-300 font-medium">Tabel TER</span>
  </nav>

  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-start gap-4 mb-4">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-sm shadow-blue-600/20 shrink-0">T</div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Tarif Efektif Rata-rata (TER)</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Pemotongan PPh Pasal 21 bulanan berdasarkan PP 58/2023 dan PMK 168/2023</p>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200/60 dark:border-blue-800/40 rounded-2xl px-4 py-3">
        <div class="text-[11px] text-blue-600 font-semibold uppercase mb-0.5">Berlaku Sejak</div>
        <div class="text-sm font-bold text-blue-900 dark:text-blue-100">1 Januari 2024</div>
      </div>
      <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200/60 dark:border-emerald-800/40 rounded-2xl px-4 py-3">
        <div class="text-[11px] text-emerald-600 font-semibold uppercase mb-0.5">Menggantikan</div>
        <div class="text-sm font-bold text-emerald-900 dark:text-emerald-100">Metode Progresif</div>
      </div>
      <div class="bg-violet-50 dark:bg-violet-900/20 border border-violet-200/60 dark:border-violet-800/40 rounded-2xl px-4 py-3">
        <div class="text-[11px] text-violet-600 font-semibold uppercase mb-0.5">Kategori</div>
        <div class="text-sm font-bold text-violet-900 dark:text-violet-100">A / B / C</div>
      </div>
      <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200/60 dark:border-amber-800/40 rounded-2xl px-4 py-3">
        <div class="text-[11px] text-amber-600 font-semibold uppercase mb-0.5">Lapisan Tarif</div>
        <div class="text-sm font-bold text-amber-900 dark:text-amber-100">42 per kategori</div>
      </div>
    </div>
  </div>

  <!-- Quick Lookup Calculator -->
  <div class="card mb-6">
    <div class="px-5 py-5 bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border-b border-blue-200/60 dark:border-blue-800/40 rounded-t-2xl">
      <div class="flex items-center gap-2 mb-4">
        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        <h2 class="text-sm font-bold text-blue-900 dark:text-blue-100">Kalkulator Cepat TER PPh 21</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="text-xs text-slate-500 font-medium mb-1.5 block">Penghasilan Bruto Bulanan</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400 font-mono">Rp</span>
            <input id="calc-income" type="text" placeholder="10.000.000" class="w-full pl-10 pr-3 py-2.5 text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none font-mono" oninput="calculateTER()" />
          </div>
        </div>
        <div>
          <label class="text-xs text-slate-500 font-medium mb-1.5 block">Iuran Pensiun / BPJS (per bulan)</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400 font-mono">Rp</span>
            <input id="calc-bpjs" type="text" placeholder="0" value="0" class="w-full pl-10 pr-3 py-2.5 text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none font-mono" oninput="calculateTER()" />
          </div>
        </div>
        <div>
          <label class="text-xs text-slate-500 font-medium mb-1.5 block">Status PTKP</label>
          <select id="calc-category" class="w-full py-2.5 px-3 text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none" onchange="switchTab(this.value); calculateTER()">
            <option value="a">TER A — Tidak Kawin</option>
            <option value="b">TER B — Kawin, 0-2 Tanggungan</option>
            <option value="c">TER C — Kawin, 3+ Tanggungan</option>
          </select>
        </div>
      </div>
    </div>
    <div id="calc-result" class="px-5 py-5 hidden">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <div class="text-[11px] text-slate-400 font-medium uppercase">Penghasilan Bruto</div>
          <div id="res-bruto" class="text-sm font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">—</div>
        </div>
        <div>
          <div class="text-[11px] text-slate-400 font-medium uppercase">Dasar Pengenaan</div>
          <div id="res-dasar" class="text-sm font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">—</div>
        </div>
        <div>
          <div class="text-[11px] text-slate-400 font-medium uppercase">Tarif TER</div>
          <div id="res-rate" class="text-sm font-bold text-blue-600 dark:text-blue-400 font-mono mt-1">—</div>
        </div>
        <div>
          <div class="text-[11px] text-slate-400 font-medium uppercase">PPh 21 / Bulan</div>
          <div id="res-pph" class="text-base font-black text-emerald-600 dark:text-emerald-400 font-mono mt-1">—</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab Selector -->
  <div class="flex gap-2 mb-5">
    <button id="tab-a" onclick="switchTab('a')" class="ter-tab active">
      <span class="font-bold">TER A</span>
      <span class="text-[10px] opacity-70 block">Tidak Kawin</span>
    </button>
    <button id="tab-b" onclick="switchTab('b')" class="ter-tab">
      <span class="font-bold">TER B</span>
      <span class="text-[10px] opacity-70 block">Kawin 0-2 Tanggungan</span>
    </button>
    <button id="tab-c" onclick="switchTab('c')" class="ter-tab">
      <span class="font-bold">TER C</span>
      <span class="text-[10px] opacity-70 block">Kawin 3+ Tanggungan</span>
    </button>
  </div>

  <!-- TER Tables -->
  {[
    { id: 'a', label: 'TER A — Tidak Kawin / Tidak Punya Tanggungan', data: terA },
    { id: 'b', label: 'TER B — Kawin, Tanggungan 0-2', data: terB },
    { id: 'c', label: 'TER C — Kawin, Tanggungan 3+', data: terC },
  ].map((tab: any) => (
    <div id={`table-${tab.id}`} class:list={[tab.id !== 'a' ? 'hidden' : '']}>
      <div class="card overflow-hidden">
        <div class="px-5 py-3 bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">{tab.label}</h3>
          <span class="text-[11px] text-slate-400 font-mono">{tab.data.rate.brackets.length} lapisan</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30">
                <th class="text-left px-4 py-3 text-[11px] font-semibold text-slate-500 uppercase tracking-wider w-12">No</th>
                <th class="text-right px-4 py-3 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Batas Bawah</th>
                <th class="text-right px-4 py-3 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">Batas Atas</th>
                <th class="text-right px-4 py-3 text-[11px] font-semibold text-slate-500 uppercase tracking-wider w-20">Tarif</th>
              </tr>
            </thead>
            <tbody>
              {tab.data.rate.brackets.map((b: any, i: number) => {
                const isZero = b.rate === 0;
                const isHigh = b.rate >= 10;
                return (
                  <tr class="border-b border-slate-100 dark:border-slate-800/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                    <td class="px-4 py-2.5 text-slate-400 font-mono text-xs">{i + 1}</td>
                    <td class="px-4 py-2.5 text-right font-mono text-xs text-slate-600 dark:text-slate-400">{fmtRp(b.min)}</td>
                    <td class="px-4 py-2.5 text-right font-mono text-xs text-slate-600 dark:text-slate-400">
                      {b.max ? fmtRp(b.max) : <span class="text-blue-600 dark:text-blue-400 font-semibold">di atas {fmtRp(b.min)}</span>}
                    </td>
                    <td class="px-4 py-2.5 text-right font-mono text-sm">
                      {isZero
                        ? <span class="inline-block bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 px-2.5 py-0.5 rounded-lg text-xs font-semibold ring-1 ring-emerald-200/60 dark:ring-emerald-800">0%</span>
                        : isHigh
                          ? <span class="inline-block bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 px-2.5 py-0.5 rounded-lg text-xs font-semibold ring-1 ring-red-200/60 dark:ring-red-800">{b.rate}%</span>
                          : <span class="text-slate-900 dark:text-slate-100">{b.rate}%</span>
                      }
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  ))}

  <!-- Category Guide -->
  <div class="mt-8 card">
    <div class="px-5 py-3 bg-amber-50 dark:bg-amber-900/20 border-b border-amber-200/60 dark:border-amber-800/40 rounded-t-2xl">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <h3 class="text-sm font-bold text-amber-900 dark:text-amber-100">Panduan Kategori TER</h3>
      </div>
    </div>
    <div class="p-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-2xl p-4 border border-blue-200/60 dark:border-blue-800/40">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-blue-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg">A</span>
            <span class="text-sm font-bold text-slate-900 dark:text-slate-100">Tidak Kawin</span>
          </div>
          <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-1">
            <li>&#8226; Tidak menikah / belum menikah</li>
            <li>&#8226; Tidak memiliki tanggungan</li>
            <li>&#8226; Atau ditinggal meninggal</li>
          </ul>
        </div>
        <div class="bg-violet-50 dark:bg-violet-900/20 rounded-2xl p-4 border border-violet-200/60 dark:border-violet-800/40">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-violet-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg">B</span>
            <span class="text-sm font-bold text-slate-900 dark:text-slate-100">Kawin 0-2 Tanggungan</span>
          </div>
          <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-1">
            <li>&#8226; Menikah (kawin)</li>
            <li>&#8226; 0, 1, atau 2 tanggungan</li>
            <li>&#8226; Termasuk menikah lalu bercerai</li>
          </ul>
        </div>
        <div class="bg-emerald-50 dark:bg-emerald-900/20 rounded-2xl p-4 border border-emerald-200/60 dark:border-emerald-800/40">
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-emerald-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg">C</span>
            <span class="text-sm font-bold text-slate-900 dark:text-slate-100">Kawin 3+ Tanggungan</span>
          </div>
          <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-1">
            <li>&#8226; Menikah (kawin)</li>
            <li>&#8226; 3 atau lebih tanggungan</li>
            <li>&#8226; Maksimal PTKP paling tinggi</li>
          </ul>
        </div>
      </div>

      <div class="mt-4 text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/50 rounded-2xl p-4">
        <strong class="text-slate-700 dark:text-slate-300">Dasar pengenaan TER:</strong> Penghasilan bruto bulanan dikurangi iuran pensiun/BPJS yang dibayar oleh pegawai.
        Tidak lagi diperlukan perhitungan PTKP dan annualisasi seperti metode lama.
        <br/><br/>
        <strong class="text-slate-700 dark:text-slate-300">Dasar hukum:</strong> PP 58 Tahun 2023 tentang Perubahan atas PP 16 Tahun 2009, dan PMK 168/PMK.010/2023.
        Berlaku efektif sejak 1 Januari 2024 menggantikan metode tarif progresif Pasal 17 dengan annualisasi.
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-between">
    <a href="/kategori/pph-21" class="btn-secondary">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Semua entry PPh 21
    </a>
    <a href="/api/v1/entries/pph-21-ter-a-detail.json" target="_blank" class="tag text-xs">
      <span class="text-blue-600 dark:text-blue-400">API</span>
      <span class="text-slate-400">JSON</span>
      <span class="text-slate-300">&#8599;</span>
    </a>
  </div>
</BaseLayout>

<style>
  .ter-tab {
    @apply flex flex-col items-center px-5 py-3 rounded-2xl text-sm border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all cursor-pointer;
  }
  .ter-tab.active {
    @apply bg-blue-600 text-white border-blue-600 shadow-md shadow-blue-600/20;
  }
</style>

<script define:vars={{ terABrackets: terA.rate.brackets, terBBrackets: terB.rate.brackets, terCBrackets: terC.rate.brackets }}>
  const brackets = { a: terABrackets, b: terBBrackets, c: terCBrackets };
  let activeTab = 'a';

  function parseRp(str) {
    if (!str) return 0;
    return parseInt(str.replace(/\D/g, ''), 10) || 0;
  }

  function formatRp(n) {
    if (n === 0) return 'Rp 0';
    return 'Rp ' + n.toLocaleString('id-ID');
  }

  window.switchTab = function(tab) {
    activeTab = tab;
    document.querySelectorAll('.ter-tab').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + tab)?.classList.add('active');
    ['a', 'b', 'c'].forEach(t => {
      const el = document.getElementById('table-' + t);
      if (el) el.classList.toggle('hidden', t !== tab);
    });
    const sel = document.getElementById('calc-category');
    if (sel) sel.value = tab;
    calculateTER();
  };

  window.calculateTER = function() {
    const income = parseRp(document.getElementById('calc-income')?.value || '');
    const bpjs = parseRp(document.getElementById('calc-bpjs')?.value || '0');
    const dasar = Math.max(0, income - bpjs);
    const resultEl = document.getElementById('calc-result');

    if (income <= 0) { resultEl?.classList.add('hidden'); return; }
    resultEl?.classList.remove('hidden');

    const bracket = brackets[activeTab];
    let rate = 0;
    for (const b of bracket) {
      if (b.max === null) { rate = b.rate; break; }
      if (dasar >= b.min && dasar <= b.max) { rate = b.rate; break; }
    }

    const pph = Math.round(dasar * rate / 100);

    const brutoEl = document.getElementById('res-bruto');
    const dasarEl = document.getElementById('res-dasar');
    const rateEl = document.getElementById('res-rate');
    const pphEl = document.getElementById('res-pph');
    if (brutoEl) brutoEl.textContent = formatRp(income);
    if (dasarEl) dasarEl.textContent = formatRp(dasar);
    if (rateEl) rateEl.textContent = rate + '%';
    if (pphEl) pphEl.textContent = formatRp(pph);
  };
</script>
