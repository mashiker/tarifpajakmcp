    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-secondary, #44545a);
    margin-bottom: 0.25rem;
  }
  .ter-calc-input-wrap { position: relative; }
  .ter-calc-prefix {
    position: absolute;
    left: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--ink-tertiary, #8B93A1);
  }
  .ter-calc-input, .ter-calc-select {
    width: 100%;
    height: 2.25rem;
    padding: 0 0.625rem;
    border-radius: 0.375rem;
    border: 1px solid var(--rule, #D9E0DC);
    background: var(--surface, #FFFFFF);
    color: var(--ink, #132A2A);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
  }
  .ter-calc-input { padding-left: 1.75rem; }
  .ter-calc-input:focus, .ter-calc-select:focus { outline: none; border-color: #0E5E58; box-shadow: 0 0 0 3px rgba(14, 94, 88, 0.18); }
  .ter-calc-select { font-family: 'Inter', sans-serif; cursor: pointer; }
  .ter-calc-result {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
