---
import BaseLayout from '../layouts/Base.astro';
import fs from 'fs';
import path from 'path';

// Task 9 rewiring: read the canonical v2 TER rules (PP 58/2023 Lampiran A/B/C)
// instead of the v1 aggregate. The v1 aggregate carried the WRONG pre-HPP table
// (42 layers, top 25%, single 6.6M 0% bound for all categories). The v2 rules
// carry the correct values: 44/40/41 layers, 0% bounds 5.4M/6.2M/6.6M, top 34%.
//
// The calculator and tables below project directly from the v2 brackets so the
// page can never drift back to the v1 numbers.
const readJson = (rel: string) => JSON.parse(fs.readFileSync(path.resolve(process.cwd(), rel), 'utf-8'));
const terA = readJson('public/api/v2/rules/rule-pph-21-ter-monthly-a.json').data;
const terB = readJson('public/api/v2/rules/rule-pph-21-ter-monthly-b.json').data;
const terC = readJson('public/api/v2/rules/rule-pph-21-ter-monthly-c.json').data;

interface Bracket { upTo: string | null; rate: string; }
interface TerRule {
  id: string;
  rate: { type: string; brackets: Bracket[] };
  // v2 TER rules carry an `in` condition on `ptkpClass`. TER A/B/C is set as
  // an array; TER C is currently a scalar "K/3" in the source data, so the
  // label derivation must normalize both shapes.
  conditions: { value: string | string[] };
  verification: { status: string };
  notes?: string;
}

// Task 9 review C2: PTKP labels are driven from the canonical v2 condition
// value (normalized scalar/array -> comma-joined string) so the page never
// drifts from the rule data. Previously TER B was hardcoded with the wrong
// "TK/1" instead of the canonical "K/1".
function ptkpLabelFrom(rule: TerRule): string {
  const v = rule.conditions?.value;
  const arr = Array.isArray(v) ? v : v === undefined || v === null ? [] : [String(v)];
  return `PTKP ${arr.join(', ')}`;
}

const TABS: { id: 'a' | 'b' | 'c'; label: string; data: TerRule }[] = [
  { id: 'a', label: 'TER A', data: terA },
  { id: 'b', label: 'TER B', data: terB },
  { id: 'c', label: 'TER C', data: terC },
];
// Precompute per-tab PTKP labels (used in stat cards, tabs, table titles, captions).
const TAB_PTKP: Record<'a' | 'b' | 'c', string> = {
  a: ptkpLabelFrom(terA),
  b: ptkpLabelFrom(terB),
  c: ptkpLabelFrom(terC),
};

// Per-tab derived values for the header stat cards.
function fmtRp(n: number | null): string {
  if (n === null) return '∞';
  if (n >= 1e9) return `Rp ${(n / 1e9).toLocaleString('id-ID')} miliar`;
  if (n >= 1e6) return `Rp ${(n / 1e6).toLocaleString('id-ID', { maximumFractionDigits: 1 })} juta`;
  return `Rp ${n.toLocaleString('id-ID')}`;
}

function bracketToLower(b: Bracket, prevUpTo: number | null) {
  // Convert v2 cumulative upTo brackets to {min, max, rate} for the table view.
  const max = b.upTo === null ? null : Number(b.upTo);
  const min = prevUpTo === null ? 0 : prevUpTo;
  return { min, max, rate: Math.round(Number(b.rate) * 10000) / 100, rateRaw: b.rate };
}

function tabLayers(t: TerRule) {
  return t.rate.brackets.map((b, i) => {
    const prev = i === 0 ? null : Number(t.rate.brackets[i - 1].upTo ?? '0');
    return bracketToLower(b, prev);
  });
}

function topRatePercent(t: TerRule): number {
  const last = t.rate.brackets[t.rate.brackets.length - 1];
  return Math.round(Number(last.rate) * 10000) / 100;
}

function zeroBound(t: TerRule): number {
  return Number(t.rate.brackets[0].upTo ?? '0');
}

const DETAIL_HREF = '/tarif/concept-pph-21-ter-monthly';
---

<BaseLayout title="Tabel TER PPh 21" activeNav="ter" canonicalPath="/ter-pph-21">
  <nav class="ter-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Database</a>
    <span aria-hidden="true">›</span>
    <a href="/kategori/pph-21">PPh 21</a>
    <span aria-hidden="true">›</span>
    <span class="ter-breadcrumb-current">Tabel TER</span>
  </nav>

  <header class="ter-header">
    <div>
      <h1 class="ter-title">Tarif Efektif Rata-rata (TER)</h1>
      <p class="ter-subtitle">
        Pemotongan PPh Pasal 21 bulanan berdasarkan PP 58/2023 Lampiran A/B/C dan PMK 168/2023.
        Tabel di bawah dibaca langsung dari aturan kanonik v2 (lihat <a href={DETAIL_HREF}>detail konsep</a>).
      </p>
    </div>
    <a href={DETAIL_HREF} class="ter-detail-link">Lihat detail konsep &rarr;</a>
  </header>

  <section class="ter-stats" aria-label="Statistik kategori TER">
    {TABS.map((tab) => (
      <div class:list={['ter-stat-card', `ter-stat-card-${tab.id}`]}>
        <div class="ter-stat-name">{tab.label}</div>
        <div class="ter-stat-ptkp">{TAB_PTKP[tab.id]}</div>
        <div class="ter-stat-layers">{tab.data.rate.brackets.length} lapisan</div>
        <div class="ter-stat-bounds">0% s/d {fmtRp(zeroBound(tab.data))}</div>
        <div class="ter-stat-top">Tarif tertinggi {topRatePercent(tab.data)}%</div>
      </div>
    ))}
  </section>

  {terA.verification.status !== 'verified_primary' && (
    <aside class="ter-verification-note" role="note">
      <strong>Catatan verifikasi:</strong> lapisan tengah direntusksi ulang dari sumber sekunder dan berstatus
      <span class="ter-verification-status">{terA.verification.status}</span>. Interval dan kelas PTKP didukung sumber primer (PP 58/2023).
      Lihat detail untuk locator klaim.
    </aside>
  )}

  <section class="ter-calculator" aria-labelledby="ter-calc-title">
    <h2 id="ter-calc-title" class="ter-calc-title">Kalkulator Cepat TER PPh 21</h2>
    <div class="ter-calc-grid">
      <div>
        <label for="calc-income" class="ter-calc-label">Penghasilan Bruto Bulanan</label>
        <div class="ter-calc-input-wrap">
          <span class="ter-calc-prefix">Rp</span>
          <input id="calc-income" type="text" placeholder="10.000.000" class="ter-calc-input" inputmode="numeric" />
        </div>
      </div>
      <div>
        <label for="calc-bpjs" class="ter-calc-label">Iuran Pensiun / BPJS</label>
        <div class="ter-calc-input-wrap">
          <span class="ter-calc-prefix">Rp</span>
          <input id="calc-bpjs" type="text" placeholder="0" value="0" class="ter-calc-input" inputmode="numeric" />
        </div>
      </div>
      <div>
        <label for="calc-category" class="ter-calc-label">Status PTKP</label>
        <select id="calc-category" class="ter-calc-select">
          {TABS.map((tab) => (
            <option value={tab.id}>{tab.label} — {TAB_PTKP[tab.id].replace(/^PTKP /, '')}</option>
          ))}
        </select>
      </div>
    </div>
    <div id="calc-result" class="ter-calc-result" hidden>
      <div>
        <div class="ter-calc-result-label">Penghasilan Bruto</div>
        <div id="res-bruto" class="ter-calc-result-value">—</div>
      </div>
      <div>
        <div class="ter-calc-result-label">Dasar Pengenaan</div>
        <div id="res-dasar" class="ter-calc-result-value">—</div>
      </div>
      <div>
        <div class="ter-calc-result-label">Tarif TER</div>
        <div id="res-rate" class="ter-calc-result-value ter-calc-result-rate">—</div>
      </div>
      <div>
        <div class="ter-calc-result-label">PPh 21 / Bulan</div>
        <div id="res-pph" class="ter-calc-result-value ter-calc-result-pph">—</div>
      </div>
    </div>
  </section>

  <div class="ter-tabs" role="tablist" aria-label="Kategori TER">
    {TABS.map((tab, i) => (
      <button
        id={`tab-${tab.id}`}
        class:list={['ter-tab', i === 0 && 'ter-tab-active']}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`table-${tab.id}`}
        data-tab={tab.id}
      >
        <span class="ter-tab-name">{tab.label}</span>
        <span class="ter-tab-ptkp">{TAB_PTKP[tab.id]}</span>
      </button>
    ))}
  </div>

  {TABS.map((tab, i) => {
    const layers = tabLayers(tab.data);
    return (
      <section
        id={`table-${tab.id}`}
        class:list={['ter-table-wrap', i !== 0 && 'ter-table-hidden']}
        role="tabpanel"
        aria-labelledby={`tab-${tab.id}`}
      >
        <div class="ter-table-header">
          <h3 class="ter-table-title">{tab.label} — {TAB_PTKP[tab.id]}</h3>
          <span class="ter-table-count">{layers.length} lapisan</span>
        </div>
        <table class="ter-table">
          <caption class="ter-table-caption">
            Tarif Efektif Rata-rata {tab.label} menurut PP 58/2023 Lampiran {tab.label.slice(4)}. Berlaku {TAB_PTKP[tab.id]}.
          </caption>
          <thead>
            <tr>
              <th scope="col" class="ter-col-no">No</th>
              <th scope="col" class="ter-col-min">Batas Bawah</th>
              <th scope="col" class="ter-col-max">Batas Atas</th>
              <th scope="col" class="ter-col-rate">Tarif</th>
            </tr>
          </thead>
          <tbody>
            {layers.map((b, j) => {
              const isZero = b.rate === 0;
              const isTop = b.rate >= 30;
              return (
                <tr>
                  <td class="ter-cell-no">{j + 1}</td>
                  <td class="ter-cell-min">{fmtRp(b.min)}</td>
                  <td class="ter-cell-max">
                    {b.max === null ? <span class="ter-cell-open">di atas {fmtRp(b.min)}</span> : fmtRp(b.max)}
                  </td>
                  <td class:list={['ter-cell-rate', isZero && 'ter-cell-zero', isTop && 'ter-cell-top']}>
                    {b.rate}%
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    );
  })}

  <section class="ter-guide" aria-labelledby="ter-guide-title">
    <h2 id="ter-guide-title" class="ter-guide-title">Dasar pengenaan & dasar hukum</h2>
    <p class="ter-guide-text">
      <strong>Dasar pengenaan:</strong> penghasilan bruto bulanan dikurangi iuran pensiun/BPJS yang dibayar pegawai.
      Tidak lagi diperlukan perhitungan PTKP dan annualisasi seperti metode lama.
    </p>
    <p class="ter-guide-text">
      <strong>Dasar hukum:</strong> PP 58 Tahun 2023 Lampiran A/B/C dan PMK 168/PMK.010/2023. Berlaku efektif sejak 1 Januari 2024.
    </p>
    <p class="ter-guide-warning">
      Lapisan tengah direntusksi dari sumber sekunder dan berstatus <code>{terA.verification.status}</code>; lapisan terbawah (0%), batas atas,
      kelas PTKP, dan tarif puncak ({topRatePercent(terA)}%) didukung sumber primer.
    </p>
  </section>

  <nav class="ter-footer-nav" aria-label="Navigasi">
    <a href="/kategori/pph-21" class="ter-footer-link">&larr; Semua entry PPh 21</a>
    <a href={DETAIL_HREF} class="ter-footer-link">Detail konsep TER &rarr;</a>
  </nav>
</BaseLayout>

<script is:inline define:vars={{ TER_A_BRACKETS: terA.rate.brackets, TER_B_BRACKETS: terB.rate.brackets, TER_C_BRACKETS: terC.rate.brackets }}>
  // Calculator wires directly to the v2 canonical TER brackets (passed in at
  // build time), so the client never reads the v1 aggregate.
  const BRACKETS = { a: TER_A_BRACKETS, b: TER_B_BRACKETS, c: TER_C_BRACKETS };
  let activeTab = 'a';

  function parseRp(str) {
    if (!str) return 0;
    return parseInt(String(str).replace(/\D/g, ''), 10) || 0;
  }
  function formatRp(n) {
    if (n === 0) return 'Rp 0';
    return 'Rp ' + n.toLocaleString('id-ID');
  }
  function rateFor(brackets, dasar) {
    // v2 brackets are cumulative {upTo, rate}; upTo === null is the open top band.
    for (const b of brackets) {
      if (b.upTo === null) return Number(b.rate) * 100;
      if (dasar <= Number(b.upTo)) return Number(b.rate) * 100;
    }
    return 0;
  }

  function setTab(tab) {
    activeTab = tab;
    document.querySelectorAll('.ter-tab').forEach((b) => {
      const isActive = b.getAttribute('data-tab') === tab;
      b.classList.toggle('ter-tab-active', isActive);
      b.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
    document.querySelectorAll('.ter-table-wrap').forEach((w) => {
      const wrapId = w.getAttribute('id');
      w.classList.toggle('ter-table-hidden', wrapId !== 'table-' + tab);
    });
    const sel = document.getElementById('calc-category');
    if (sel) sel.value = tab;
    calculate();
  }

  function calculate() {
    const income = parseRp(document.getElementById('calc-income')?.value || '');
    const bpjs = parseRp(document.getElementById('calc-bpjs')?.value || '0');
    const dasar = Math.max(0, income - bpjs);
    const resultEl = document.getElementById('calc-result');
    if (income <= 0) { resultEl?.setAttribute('hidden', ''); return; }
    resultEl?.removeAttribute('hidden');
    const rate = rateFor(BRACKETS[activeTab], dasar);
    const pph = Math.round(dasar * rate / 100);
    const setText = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };
    setText('res-bruto', formatRp(income));
    setText('res-dasar', formatRp(dasar));
    setText('res-rate', rate.toFixed(2) + '%');
    setText('res-pph', formatRp(pph));
  }

  document.querySelectorAll('.ter-tab').forEach((b) => {
    b.addEventListener('click', () => setTab(b.getAttribute('data-tab')));
  });
  document.getElementById('calc-income')?.addEventListener('input', calculate);
  document.getElementById('calc-bpjs')?.addEventListener('input', calculate);
  document.getElementById('calc-category')?.addEventListener('change', (e) => setTab(e.target.value));
  // Expose for any keyboard shortcut wiring.
  window.__ter_set_tab = setTab;
</script>

<style>
  .ter-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: var(--ink-tertiary, #8B93A1);
    margin-bottom: 0.75rem;
  }
  .ter-breadcrumb a { color: var(--ink-secondary, #44545a); text-decoration: none; }
  .ter-breadcrumb a:hover { color: #0E5E58; text-decoration: underline; }
  .ter-breadcrumb-current { color: var(--ink, #132A2A); font-weight: 600; }

  .ter-header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule, #D9E0DC);
  }
  .ter-title { font-size: 1.375rem; font-weight: 700; color: var(--ink, #132A2A); margin: 0; letter-spacing: -0.01em; }
  .ter-subtitle { font-size: 0.8125rem; color: var(--ink-secondary, #44545a); margin: 0.25rem 0 0; max-width: 60ch; line-height: 1.5; }
  .ter-subtitle a, .ter-detail-link { color: #0E5E58; }
  /* Inline links inside the subtitle must be visually distinct beyond colour
     alone (WCAG 1.4.1 / axe link-in-text-block). Underline signals the link. */
  .ter-subtitle a { text-decoration: underline; text-underline-offset: 2px; }
  .ter-subtitle a:hover { text-decoration: underline; }
  .ter-detail-link {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--rule, #D9E0DC);
    border-radius: 0.5rem;
    background: var(--surface, #FFFFFF);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  .ter-detail-link:hover { border-color: #0E5E58; }

  .ter-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .ter-stat-card {
    padding: 0.75rem;
    border: 1px solid var(--rule, #D9E0DC);
    border-radius: 0.5rem;
    background: var(--surface, #FFFFFF);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .ter-stat-name { font-weight: 700; font-size: 0.875rem; color: var(--ink, #132A2A); }
  .ter-stat-ptkp { font-size: 0.6875rem; color: var(--ink-tertiary, #8B93A1); font-family: 'IBM Plex Mono', monospace; }
  .ter-stat-layers { font-family: 'IBM Plex Mono', monospace; font-size: 0.8125rem; color: var(--ink-secondary, #44545a); margin-top: 0.25rem; }
  .ter-stat-bounds { font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; color: var(--ink-tertiary, #8B93A1); }
  .ter-stat-top { font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: #0E5E58; font-weight: 600; }

  .ter-verification-note {
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--highlight-soft, #FBF3E3);
    border: 1px solid rgba(183, 121, 31, 0.30);
    font-size: 0.75rem;
    color: var(--ink-secondary, #44545a);
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .ter-verification-status {
    display: inline-block;
    padding: 0.0625rem 0.375rem;
    border-radius: 9999px;
    background: rgba(183, 121, 31, 0.18);
    color: #7A4F10;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    font-weight: 700;
    margin: 0 0.125rem;
  }

  .ter-calculator {
    padding: 0.875rem 1rem;
    border: 1px solid var(--rule, #D9E0DC);
    border-radius: 0.5rem;
    background: var(--surface, #FFFFFF);
    margin-bottom: 1rem;
  }
  .ter-calc-title { font-size: 0.875rem; font-weight: 700; color: var(--ink, #132A2A); margin: 0 0 0.75rem; }
  .ter-calc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
  }
  .ter-calc-label {
