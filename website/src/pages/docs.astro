---
import BaseLayout from '../layouts/Base.astro';
---

<BaseLayout title="Panduan & Dokumentasi" activeNav="docs" description="Panduan pemakaian Tarif Pajak ID untuk user, developer, dan AI agent. Tutorial integrasi API, contoh kode, dan skill Hermes.">
  <!-- Breadcrumb -->
  <nav class="flex items-center gap-1.5 text-xs mb-8 text-[var(--text-tertiary)]">
    <a href="/" class="hover:text-[var(--text)] transition-colors">Beranda</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    <span class="text-[var(--text)] font-medium">Panduan</span>
  </nav>

  <!-- Header -->
  <div class="mb-10">
    <div class="flex items-center gap-3 mb-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-[var(--radius)] bg-[var(--accent-soft)]">
        <svg class="w-5 h-5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-[var(--text)] tracking-tight">Panduan & Dokumentasi</h1>
      </div>
    </div>
    <p class="text-sm text-[var(--text-secondary)] max-w-lg">Cara pakai database tarif pajak Indonesia — untuk user awam, developer, dan AI agent.</p>
  </div>

  <!-- TOC -->
  <div class="card p-4 mb-8">
    <div class="text-xs font-semibold text-[var(--text-tertiary)] uppercase tracking-wide mb-2">Daftar Isi</div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-sm">
      <a href="#user" class="flex items-center gap-2 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
        <span class="font-mono text-xs bg-[var(--accent-soft)] text-[var(--accent)] px-1.5 py-0.5 rounded">01</span> Untuk User
      </a>
      <a href="#developer" class="flex items-center gap-2 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
        <span class="font-mono text-xs bg-[var(--accent-soft)] text-[var(--accent)] px-1.5 py-0.5 rounded">02</span> Untuk Developer
      </a>
      <a href="#agent" class="flex items-center gap-2 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
        <span class="font-mono text-xs bg-[var(--accent-soft)] text-[var(--accent)] px-1.5 py-0.5 rounded">03</span> Untuk AI Agent
      </a>
    </div>
  </div>

  <!-- ============ 01: UNTUK USER ============ -->
  <section id="user" class="mb-12">
    <h2 class="section-heading mb-4">01 — Untuk User Awam</h2>

    <div class="space-y-4">
      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Cara membaca tarif di tabel database</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-3">Setiap baris di database menunjukkan 1 jenis transaksi pajak dengan:</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="bg-[var(--surface-alt)] rounded-[var(--radius)] p-3">
            <div class="font-mono text-[10px] text-[var(--text-tertiary)] uppercase mb-1">Tarif</div>
            <div class="font-bold" style="color: var(--accent)">11 persen</div>
          </div>
          <div class="bg-[var(--surface-alt)] rounded-[var(--radius)] p-3">
            <div class="font-mono text-[10px] text-[var(--text-tertiary)] uppercase mb-1">Status</div>
            <div><span class="badge badge-berlaku" style="font-size:10px;">Berlaku</span></div>
          </div>
          <div class="bg-[var(--surface-alt)] rounded-[var(--radius)] p-3">
            <div class="font-mono text-[10px] text-[var(--text-tertiary)] uppercase mb-1">Masa Berlaku</div>
            <div class="text-[var(--text)] font-mono">2025-02-01 → sekarang</div>
          </div>
          <div class="bg-[var(--surface-alt)] rounded-[var(--radius)] p-3">
            <div class="font-mono text-[10px] text-[var(--text-tertiary)] uppercase mb-1">Sumber</div>
            <div class="text-[var(--text-secondary)]">PMK 131/2024</div>
          </div>
        </div>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Arti badge status</h3>
        <div class="space-y-2">
          <div class="flex items-center gap-3 text-sm">
            <span class="badge badge-berlaku" style="min-width:80px; justify-content:center;">Berlaku</span>
            <span class="text-[var(--text-secondary)]">Tarif ini sedang berlaku saat ini.</span>
          </div>
          <div class="flex items-center gap-3 text-sm">
            <span class="badge badge-diubah" style="min-width:80px; justify-content:center;">Diubah</span>
            <span class="text-[var(--text-secondary)]">Telah diamandemen oleh regulasi yang lebih baru — lihat rantai supersedes.</span>
          </div>
          <div class="flex items-center gap-3 text-sm">
            <span class="badge badge-dicabut" style="min-width:80px; justify-content:center;">Dicabut</span>
            <span class="text-[var(--text-secondary)]">Sudah tidak berlaku. Untuk histori saja.</span>
          </div>
          <div class="flex items-center gap-3 text-sm">
            <span class="badge badge-belum_berlaku" style="min-width:80px; justify-content:center;">Belum</span>
            <span class="text-[var(--text-secondary)]">Sudah diundangkan tapi belum berlaku (lihat effectiveFrom).</span>
          </div>
        </div>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">3 skenario paling umum</h3>
        <div class="space-y-3 text-sm text-[var(--text-secondary)]">
          <div>
            <div class="font-semibold text-[var(--text)] mb-0.5">① Cek tarif terkini</div>
            Buka <a href="/database" class="text-[var(--accent)] hover:underline">/database</a> → filter "Berlaku" → cari kategori pajak Anda.
          </div>
          <div>
            <div class="font-semibold text-[var(--text)] mb-0.5">② Hitung PPh 21 gaji</div>
            Buka <a href="/ter-pph-21" class="text-[var(--accent)] hover:underline">/ter-pph-21</a> → masukkan bruto bulanan + status PTKP → dapatkan tarif TER instan.
          </div>
          <div>
            <div class="font-semibold text-[var(--text)] mb-0.5">③ Cari Kode Objek Pajak (BPPU)</div>
            Buka <a href="/kode-objek-pajak" class="text-[var(--accent)] hover:underline">/kode-objek-pajak</a> → search nama usaha atau kode 6-digit.
          </div>
        </div>
      </div>

      <div class="flex gap-3 bg-[var(--status-changed-soft)] border border-[var(--status-changed)]/20 rounded-[var(--radius-lg)] p-4">
        <svg class="w-5 h-5 text-[var(--status-changed)] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div class="text-sm text-[var(--text-secondary)]">
          <strong class="text-[var(--text)]">Disclaimer:</strong> Database ini untuk referensi cepat. Untuk keputusan pajak resmi, selalu rujuk ke teks regulasi asli (link tersedia di setiap entry) atau konsultasi dengan konsultan pajak.
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 02: UNTUK DEVELOPER ============ -->
  <section id="developer" class="mb-12">
    <h2 class="section-heading mb-4">02 — Untuk Developer</h2>

    <div class="space-y-4">
      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Base URL & Format</h3>
        <pre class="code-block"><code>Base URL : https://tarif-pajak-id.pages.dev/api/v1
Format   : JSON static (Cloudflare Pages CDN)
Auth     : Tidak ada
Limit    : Tidak ada (fair use)</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">cURL — Contoh query</h3>
        <pre class="code-block"><code><span class="text-[#54C7BB]">#</span> <span class="text-[#9CA3AF]">Semua tarif berlaku di 2025</span>
curl https://tarif-pajak-id.pages.dev/api/v1/by-year/2025.json

<span class="text-[#54C7BB]">#</span> <span class="text-[#9CA3AF]">Detail 1 entry lengkap</span>
curl https://tarif-pajak-id.pages.dev/api/v1/entries/ppn-12pct-mewah-2025.json

<span class="text-[#54C7BB]">#</span> <span class="text-[#9CA3AF]">Search index (untuk client-side search)</span>
curl https://tarif-pajak-id.pages.dev/api/v1/search-index.json</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">JavaScript (fetch)</h3>
        <pre class="code-block"><code><span class="text-[#9CA3AF]">// Ambil semua entries berlaku di tahun 2025</span>
const res = await fetch(
  'https://tarif-pajak-id.pages.dev/api/v1/by-year/2025.json'
);
const &#123; entries &#125; = await res.json();

<span class="text-[#9CA3AF]">// Filter hanya yang status 'berlaku'</span>
const aktif = entries.filter(e => e.status === 'berlaku');
console.log(aktif.map(e => (&#123; id: e.id, tarif: e.rate &#125;)));</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Python (requests)</h3>
        <pre class="code-block"><code>import requests

BASE = "https://tarif-pajak-id.pages.dev/api/v1"

<span class="text-[#9CA3AF]"># Cari tarif PPh 23 jasa</span>
r = requests.get(f"&#123;BASE&#125;/categories/pph-23.json")
data = r.json()

for entry in data["entries"]:
    if entry["status"] == "berlaku":
        print(f"&#123;entry['transactionType']&#125;: &#123;entry['rate']['value']&#125;%")
        print(f"  Sumber: &#123;entry['legalBasis'][0]['regulation']&#125;")</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Struktur response (entry detail)</h3>
        <pre class="code-block"><code>&#123;
  "id": "ppn-12pct-mewah-2025",
  "taxType": "PPN",
  "transactionType": "Penyerahan Barang/Jasa Mewah Tertentu",
  "rate": &#123; "type": "percentage", "value": 12 &#125;,
  "effectiveFrom": "2025-02-01",
  "effectiveTo": null,
  "status": "berlaku",
  "legalBasis": [&#123;
    "regulation": "PMK 131/2024",
    "article": "Pasal 3",
    "sourceUrl": "https://peraturan.bpk.go.id/..."
  &#125;],
  "examples": [&#123; "scenario": "...", "calculation": "...", "result": "..." &#125;],
  "supersedes": ["ppn-11pct-2022"],
  "supersededBy": []
&#125;</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Embed di website Anda</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-3">Karena API ini static JSON tanpa CORS restriction, bisa langsung di-fetch dari browser client:</p>
        <pre class="code-block"><code><span class="text-[#9CA3AF]">&lt;!-- Widget tarif PPN terkini --&gt;</span>
&lt;div id="ppn-rate"&gt;Loading...&lt;/div&gt;
&lt;script&gt;
  fetch('https://tarif-pajak-id.pages.dev/api/v1/by-year/2025.json')
    .then(r =&gt; r.json())
    .then((&#123; entries &#125;) =&gt; &#123;
      const ppn = entries.find(e =&gt; e.id === 'ppn-11pct-effective-2025');
      document.getElementById('ppn-rate').textContent = ppn?.rate.value + '%';
    &#125;);
&lt;/script&gt;</code></pre>
      </div>

      <div class="card p-4">
        <div class="flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          <span>Endpoint lengkap dengan parameter + response schema:</span>
          <a href="/api-docs" class="font-semibold text-[var(--accent)] hover:underline">API Reference →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03: UNTUK AI AGENT ============ -->
  <section id="agent" class="mb-12">
    <h2 class="section-heading mb-4">03 — Untuk AI Agent / LLM</h2>

    <div class="space-y-4">
      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Opsi A: llms.txt (paling mudah)</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-3">Manifest untuk LLM — import ke NotebookLM, ChatGPT custom GPT, atau agent apapun yang support llms.txt:</p>
        <pre class="code-block"><code>https://tarif-pajak-id.pages.dev/llms.txt</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Opsi B: Direct API call dari agent</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-3">Untuk agent dengan tool use (Claude, GPT-4 dengan function calling, Cursor, Continue, dll):</p>
        <pre class="code-block"><code><span class="text-[#9CA3AF]">// Function calling spec</span>
&#123;
  "name": "lookup_tax_rate",
  "description": "Cari tarif pajak Indonesia",
  "parameters": &#123;
    "query": &#123; "type": "string", "desc": "keyword atau ID entry" &#125;
  &#125;
&#125;

<span class="text-[#9CA3AF]">// Implementation</span>
async function lookup_tax_rate(&#123; query &#125;) &#123;
  const url = `https://tarif-pajak-id.pages.dev/api/v1/search-index.json`;
  const index = await (await fetch(url)).json();
  <span class="text-[#9CA3AF]">// ... filter by query, return entries</span>
&#125;</code></pre>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Opsi C: Hermes / OpenClaw Skill</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-3">Skill <code class="bg-[var(--surface-alt)] px-1.5 py-0.5 rounded text-xs font-mono">tarif-pajak-lookup</code> sudah tersedia. Pakai dari Hermes:</p>
        <pre class="code-block"><code><span class="text-[#9CA3AF]"># Dari Hermes chat</span>
&gt; berapa tarif PPh 23 jasa tahun 2024?

<span class="text-[#9CA3AF]"># Atau panggil langsung script</span>
bash ~/.agents/skills/tarif-pajak-lookup/scripts/lookup.sh year 2024
bash ~/.agents/skills/tarif-pajak-lookup/scripts/lookup.sh entry pph-23-jasa-lain-2pct
bash ~/.agents/skills/tarif-pajak-lookup/scripts/lookup.sh search "pph 21 ter"</code></pre>
        <p class="text-xs text-[var(--text-tertiary)] mt-2">Lihat <code class="font-mono">~/.agents/skills/tarif-pajak-lookup/SKILL.md</code> untuk panduan lengkap.</p>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Opsi D: MCP Server (Model Context Protocol)</h3>
        <p class="text-sm text-[var(--text-secondary)] mb-3">Untuk integrasi dengan Claude Desktop, Cursor, atau MCP-compatible client:</p>
        <pre class="code-block"><code><span class="text-[#9CA3AF]"># claude_desktop_config.json</span>
&#123;
  "mcpServers": &#123;
    "tarif-pajak": &#123;
      "command": "node",
      "args": ["/path/to/tarif-pajakmcp/mcp-server/index.js"]
    &#125;
  &#125;
&#125;</code></pre>
        <p class="text-xs text-[var(--text-tertiary)] mt-2">MCP server ada di repo: <code class="font-mono">mcp-server/</code> directory.</p>
      </div>

      <div class="card p-5">
        <h3 class="text-sm font-bold text-[var(--text)] mb-2">Tips untuk agent</h3>
        <ul class="text-sm text-[var(--text-secondary)] space-y-2">
          <li class="flex gap-2"><span class="text-[var(--accent)]">→</span> <span><strong class="text-[var(--text)]">Selalu kutip sumber:</strong> sertakan <code class="font-mono text-xs bg-[var(--surface-alt)] px-1 rounded">legalBasis[].regulation</code> + link di jawaban.</span></li>
          <li class="flex gap-2"><span class="text-[var(--accent)]">→</span> <span><strong class="text-[var(--text)]">Cek status:</strong> kalau <code class="font-mono text-xs bg-[var(--surface-alt)] px-1 rounded">status != 'berlaku'</code>, tag jawaban dengan tanggal dicabut/diubah.</span></li>
          <li class="flex gap-2"><span class="text-[var(--accent)]">→</span> <span><strong class="text-[var(--text)]">Verifikasi tanggal:</strong> bandingkan <code class="font-mono text-xs bg-[var(--surface-alt)] px-1 rounded">effectiveFrom</code> dengan tanggal kasus user.</span></li>
          <li class="flex gap-2"><span class="text-[var(--accent)]">→</span> <span><strong class="text-[var(--text)]">Untuk regulasi terbaru</strong> yang belum masuk DB, fallback ke <code class="font-mono text-xs bg-[var(--surface-alt)] px-1 rounded">regulasi-pajak-id</code> skill (RSS JDIH).</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER NAV ============ -->
  <section class="grid sm:grid-cols-2 gap-3 mt-12">
    <a href="/api-docs" class="card p-4 group hover:border-[var(--accent)] transition-colors">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-xs text-[var(--text-tertiary)] font-mono uppercase mb-1">Selanjutnya</div>
          <div class="text-sm font-semibold text-[var(--text)]">API Reference →</div>
          <div class="text-xs text-[var(--text-secondary)]">Endpoint detail + response schema</div>
        </div>
        <svg class="w-4 h-4 text-[var(--accent)] group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    </a>
    <a href="/database" class="card p-4 group hover:border-[var(--accent)] transition-colors">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-xs text-[var(--text-tertiary)] font-mono uppercase mb-1">Atau coba langsung</div>
          <div class="text-sm font-semibold text-[var(--text)]">Database →</div>
          <div class="text-xs text-[var(--text-secondary)]">137 entries, search & filter</div>
        </div>
        <svg class="w-4 h-4 text-[var(--accent)] group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </div>
    </a>
  </section>
</BaseLayout>
