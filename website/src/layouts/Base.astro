---
interface Props { title: string; description?: string; activeNav?: string; }
const { title, description = 'Database tarif pajak Indonesia yang terbuka dan bersumber dari regulasi resmi.', activeNav = '' } = Astro.props;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Tarif Pajak ID</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@300..900&display=swap" rel="stylesheet" />
  <meta property="og:title" content={title + ' — Tarif Pajak ID'} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
</head>
<body class="min-h-screen bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <header class="sticky top-0 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-lg border-b border-slate-200/60 dark:border-slate-800/60">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-[60px]">
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 dark:from-slate-200 dark:to-slate-300 flex items-center justify-center text-white dark:text-slate-900 font-bold text-sm shadow-sm">T</div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-base font-bold text-slate-900 dark:text-slate-100">Tarif Pajak</span>
          <span class="text-[10px] font-mono font-bold text-slate-700 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-md">ID</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-1" aria-label="Main">
        <a href="/" class:list={["nav-link", activeNav === "home" && "active"]}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Beranda
        </a>
        <a href="/ter-pph-21" class:list={["nav-link", activeNav === "ter" && "active"]}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          TER PPh 21
        </a>
        <a href="/kode-objek-pajak" class:list={["nav-link", activeNav === "bppu" && "active"]}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          BPPU
        </a>
        <a href="/api-docs" class:list={["nav-link", activeNav === "api" && "active"]}>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
          API
        </a>
        <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="nav-link" aria-label="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"></path></svg>
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <button id="dark-toggle" class="btn-ghost p-2 rounded-lg" aria-label="Toggle dark mode">
          <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
        <button id="mobile-menu-btn" class="md:hidden btn-ghost p-2 rounded-lg" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
      <div class="max-w-[1600px] mx-auto px-4 py-3 space-y-1">
        <a href="/" class:list={["nav-link w-full", activeNav === "home" && "active"]}>Beranda</a>
        <a href="/ter-pph-21" class:list={["nav-link w-full", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link w-full", activeNav === "bppu" && "active"]}>Kode BPPU</a>
        <a href="/api-docs" class:list={["nav-link w-full", activeNav === "api" && "active"]}>API Reference</a>
      </div>
    </div>
  </header>

  <main id="main-content" class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 w-full">
    <slot />
  </main>

  <footer class="border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-slate-800 to-slate-900 dark:from-slate-200 dark:to-slate-300 flex items-center justify-center text-white dark:text-slate-900 font-bold text-[10px]">T</div>
          <span class="text-sm text-slate-500 dark:text-slate-400">Tarif Pajak ID</span>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <span class="text-xs text-slate-400">Bukan nasihat pajak</span>
        </div>
        <div class="flex items-center gap-4 flex-wrap justify-center">
          <a href="/" class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">Beranda</a>
          <a href="/ter-pph-21" class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">TER PPh 21</a>
          <a href="/api-docs" class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">API</a>
          <a href="/kode-objek-pajak" class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">BPPU</a>
          <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">GitHub ↗</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function() {
      const s = localStorage.getItem('darkMode');
      const d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (s === 'true' || (s === null && d)) document.documentElement.classList.add('dark');
    })();
  </script>
</body>
</html>

<script>
  document.getElementById('dark-toggle')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('darkMode', String(document.documentElement.classList.contains('dark')));
  });
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
