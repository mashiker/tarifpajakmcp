---
// The component-layer stylesheet. WITHOUT this import the `@layer components`
// rules (nav-link, skip-link, badges, data-table, ...) never reach the Vite
// graph — @astrojs/tailwind only injects Tailwind's own directives — which is
// what left the nav links squished and the skip-link permanently visible.
import '../styles/global.css';
import { serializeJsonLd, CANONICAL_ORIGIN } from '../lib/seo.ts';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  wide?: boolean;
  fullWidth?: boolean;
  /** Canonical path on the site (e.g. "/", "/tarif/concept-x"). When provided,
   * the layout emits an absolute canonical URL on the canonical origin and
   * matching og:url. */
  canonicalPath?: string;
  /** Optional OG/Twitter image (absolute URL or site-relative path). */
  image?: string;
  /** Optional JSON-LD object to inline in the head. The layout serializes it
   * with HTML-safe escaping. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** When true, the page emits a noindex meta tag (e.g. the 404 page). */
  noindex?: boolean;
}

const DEFAULT_IMAGE = `${CANONICAL_ORIGIN}/favicon.svg`;

const {
  title,
  description = 'Database tarif pajak Indonesia yang terbuka dan bersumber dari regulasi resmi.',
  activeNav = '',
  wide = false,
  fullWidth = false,
  canonicalPath,
  image = DEFAULT_IMAGE,
  jsonLd,
  noindex = false,
} = Astro.props;

const fullTitle = title.endsWith('Tarif Pajak ID') ? title : `${title} — Tarif Pajak ID`;
const canonicalUrl = canonicalPath
  ? `${CANONICAL_ORIGIN}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`
  : CANONICAL_ORIGIN;

const jsonLdBlocks: Record<string, unknown>[] = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:opsz,wght@14..32,300..900&display=swap" rel="stylesheet" />
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <link rel="canonical" href={canonicalUrl} />
  )}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Tarif Pajak ID" />
  <meta property="og:locale" content="id_ID" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  {jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={serializeJsonLd(block)} />
  ))}
  <script is:inline>
    (function() {
      const s = localStorage.getItem('darkMode');
      const d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (s === 'true' || (s === null && d)) document.documentElement.classList.add('dark');
    })();
  </script>
  <style is:inline>
    /* Approved tokens (Task 8 / design spec):
       ink #132A2A, deep teal #0E5E58, paper #F7F8F4, surface #FFFFFF,
       rule #D9E0DC, warning #B7791F, conflict #B64545.
       Inter + IBM Plex Mono. WCAG AA on paper/surface. */
    :root {
      --bg:              #F7F8F4;   /* paper */
      --surface:         #FFFFFF;
      --surface-alt:     #EFF1EC;
      --border:          #D9E0DC;   /* rule */
      --border-subtle:   #E6EBE7;
      --text:            #132A2A;   /* ink */
      --text-secondary:  #44545A;
      --text-tertiary:   #5A6670;   /* AA: 5.2:1 on paper, 5.9:1 on surface (Task 11 a11y gate) */
      --accent:          #0E5E58;   /* deep teal */
      --accent-hover:    #0A4A45;
      --accent-soft:     #EAF2F0;
      --accent-text:     #0E5E58;
      --highlight:       #B7791F;   /* warning */
      --highlight-soft:  #FBF3E3;
      --status-active:   #0E5E58;
      --status-revoked:  #B64545;   /* conflict */
      --status-revoked-strong: #932F2F; /* badge text di atas revoked-soft: AA 4.5:1 */
      --status-revoked-soft: rgba(182, 69, 69, 0.10);
      --status-changed:  #B7791F;
      --status-changed-strong: #8A5A13; /* badge text di atas highlight-soft: AA 4.5:1 */
      --status-pending:  #5A6670;
      /* Warna statistik hero — AA pada bg terang (bold 16px ≥4.5:1). */
      --stat-info:       #1D5FBF;
      --stat-ok:         #1E8E5A;
      --stat-warn:       #B45309;
      /* Konten di dalam .code-block (selalu background gelap, light & dark). */
      --code-muted:      #97A3AF;
      --code-soft:       #C2CBD4;
      --header-height:   56px;
      --font-mono:       "IBM Plex Mono", monospace;
      /* Aliases used by the new database components. */
      --ink:             #132A2A;
      --ink-secondary:   #44545A;
      --ink-tertiary:    #5A6670;
      --rule:            #D9E0DC;
      --paper:           #F7F8F4;
    }
    /* Dark mode CSS variables — teal-tinted (bukan abu netral) supaya dark
       mode ikut "berwarna" dan nyambung dengan accent. AA-tested. */
    html.dark {
      --bg:              #0C1B1A;
      --surface:         #132826;
      --surface-alt:     #1C3835;
      --border:          #27504C;
      --border-subtle:   #1E3F3C;
      --text:            #E8F1EF;
      --text-secondary:  #B7CBC7;
      --text-tertiary:   #8FA8A3;
      --accent:          #3BD8C2;
      --accent-hover:    #6BE5D4;
      --accent-soft:     rgba(59, 216, 194, 0.10);
      --accent-text:     #3BD8C2;
      --highlight:       #FBBF24;
      --highlight-soft:  rgba(251, 191, 36, 0.10);
      --status-active:   #34D399;
      --status-revoked:  #F87171;
      --status-revoked-strong: #FCA5A5;
      --status-revoked-soft: rgba(248, 113, 113, 0.12);
      --status-changed:  #FBBF24;
      --status-changed-strong: #FCD34D;
      --status-pending:  #94A3B8;
      /* Warna statistik hero (light-safe padanan di :root bawah). */
      --stat-info:       #60A5FA;
      --stat-ok:         #4ADE80;
      --stat-warn:       #FBBF24;
      --code-muted:      #97A3AF;
      --code-soft:       #C2CBD4;
      --ink:             #E8F1EF;
      --ink-secondary:   #B7CBC7;
      --ink-tertiary:    #8FA8A3;
      --rule:            #27504C;
      --paper:           #0C1B1A;
    }
    body {
      color: var(--text);
      background: var(--bg);
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body class="min-h-screen">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-[var(--bg)]/80 backdrop-blur-xl border-b border-[var(--border)]">
    <div class="mx-auto flex h-14 max-w-8xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">

      <!-- Logo -->
      <a href="/" class="group flex shrink-0 items-center gap-2" aria-label="Tarif Pajak ID home">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#111318] dark:bg-white transition-transform duration-200 group-hover:scale-105">
          <svg class="h-4 w-4" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect x="14" y="16" width="36" height="32" rx="3" stroke="var(--accent)" stroke-width="3.5" fill="none"/>
            <line x1="14" y1="26" x2="50" y2="26" stroke="var(--accent)" stroke-width="2.5"/>
            <line x1="32" y1="16" x2="32" y2="48" stroke="var(--accent)" stroke-width="2.5"/>
            <text x="41" y="23.5" font-family="monospace" font-size="8" font-weight="800" fill="var(--accent)" text-anchor="middle">%</text>
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-sm font-bold tracking-tight text-[var(--text)]">Tarif Pajak</span>
          <span class="rounded bg-[var(--accent-soft)] px-1.5 py-0.5 font-mono text-[10px] font-bold text-[var(--accent)]">ID</span>
        </div>
      </a>

      <!-- Search Bar (Desktop) -->
      <div class="hidden md:flex flex-1 max-w-sm">
        <button id="search-trigger" class="w-full flex items-center gap-2 h-9 px-3 rounded-lg border border-[var(--border)] bg-[var(--surface)] text-[var(--text-tertiary)] text-sm hover:border-[var(--accent)] transition-colors duration-200 cursor-pointer" aria-label="Search">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span class="flex-1 text-left">Cari tarif, kategori, kode...</span>
          <kbd class="hidden lg:inline-flex items-center gap-0.5 rounded border border-[var(--border)] bg-[var(--surface-alt)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-tertiary)]">⌘K</kbd>
        </button>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Main">
        <a href="/" class:list={["nav-link", activeNav === "home" && "active"]}>Database</a>
        <a href="/kalkulator" class:list={["nav-link", activeNav === "kalkulator" && "active"]}>Kalkulator</a>
        <a href="/ter-pph-21" class:list={["nav-link", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link", activeNav === "bppu" && "active"]}>BPPU</a>
        <a href="/api-docs" class:list={["nav-link", activeNav === "api" && "active"]}>API</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-1">
        <button id="dark-toggle" class="btn-ghost p-2 rounded-lg" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </button>
        <button id="mobile-menu-btn" class="btn-ghost p-2 rounded-lg lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden border-t border-[var(--border)] bg-[var(--bg)]/95 backdrop-blur-xl lg:hidden">
      <div class="mx-auto max-w-8xl px-4 py-3 space-y-1">
        <!-- Mobile Search -->
        <div class="relative mb-2">
          <input id="mobile-search-input" type="text" placeholder="Cari tarif pajak..." class="w-full h-10 pl-9 pr-4 rounded-lg border border-[var(--border)] bg-[var(--surface)] text-sm text-[var(--text)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--accent)]" />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--text-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <a href="/" class:list={["nav-link w-full", activeNav === "home" && "active"]}>Database</a>
        <a href="/kalkulator" class:list={["nav-link w-full", activeNav === "kalkulator" && "active"]}>Kalkulator</a>
        <a href="/ter-pph-21" class:list={["nav-link w-full", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link w-full", activeNav === "bppu" && "active"]}>BPPU</a>
        <a href="/api-docs" class:list={["nav-link w-full", activeNav === "api" && "active"]}>API</a>
      </div>
    </div>
  </header>

  <!-- Main -->
  <main id="main-content" class:list={[
    "mx-auto w-full px-4 py-6 sm:px-6 sm:py-8 lg:px-8",
    fullWidth ? "max-w-screen-2xl" : wide ? "max-w-8xl" : "max-w-4xl"
  ]}>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-auto border-t border-[var(--border)]">
    <div class="mx-auto max-w-8xl px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <!-- Left -->
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#111318] dark:bg-white mt-0.5">
            <svg class="h-3.5 w-3.5" viewBox="0 0 64 64" fill="none"><rect x="14" y="16" width="36" height="32" rx="3" stroke="var(--accent)" stroke-width="3.5" fill="none"/><line x1="14" y1="26" x2="50" y2="26" stroke="var(--accent)" stroke-width="2.5"/><line x1="32" y1="16" x2="32" y2="48" stroke="var(--accent)" stroke-width="2.5"/><text x="41" y="23.5" font-family="monospace" font-size="8" font-weight="800" fill="var(--accent)" text-anchor="middle">%</text></svg>
          </div>
          <div>
            <span class="text-xs font-bold text-[var(--text)]">Tarif Pajak ID</span>
            <span class="mx-1.5 text-[var(--text-tertiary)]">·</span>
            <span class="text-xs text-[var(--text-secondary)]">Open database, sumber regulasi resmi.</span>
            <div class="mt-1 inline-flex items-center gap-1 rounded bg-[var(--highlight-soft)] px-1.5 py-0.5 text-[10px] font-semibold text-[#8A5A13]">
              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Bukan nasihat pajak resmi
            </div>
          </div>
        </div>

        <!-- Right -->
        <div class="flex items-center gap-4 text-xs text-[var(--text-tertiary)]">
          <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text)] transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="/api-docs" class="hover:text-[var(--text)] transition-colors">API</a>
          <a href="https://peraturan.bpk.go.id" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text)] transition-colors">JDIH BPK ↗</a>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-[var(--border-subtle)]">
        <p class="text-[11px] text-[var(--text-tertiary)]">© 2024–2026 Tarif Pajak ID. Data bersumber dari regulasi resmi Republik Indonesia.</p>
      </div>
    </div>
  </footer>
</body>
</html>

<script>
  // Dark mode toggle
  const darkToggle = document.getElementById('dark-toggle');
  function syncDarkAria() {
    if (darkToggle) darkToggle.setAttribute('aria-pressed', document.documentElement.classList.contains('dark') ? 'true' : 'false');
  }
  syncDarkAria();
  darkToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('darkMode', String(document.documentElement.classList.contains('dark')));
    syncDarkAria();
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  function syncMobileMenuAria() {
    if (!mobileMenuBtn || !mobileMenu) return;
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  }
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    syncMobileMenuAria();
  });

  // Search trigger — focus the root database search input on desktop, mobile input on mobile.
  // The database experience is now at /, so the home input is always the canonical search.
  document.getElementById('search-trigger')?.addEventListener('click', () => {
    const dbInput = document.querySelector<HTMLInputElement>('#db-input-q');
    const mobileInput = document.querySelector<HTMLInputElement>('#mobile-search-input');
    if (dbInput) {
      dbInput.focus();
      dbInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else if (mobileInput) {
      if (mobileMenu?.classList.contains('hidden')) mobileMenu.classList.remove('hidden');
      syncMobileMenuAria();
      mobileInput.focus();
    }
  });

  // ⌘K dan "/" shortcut — fokus ke search database (jika ada di halaman).
  const isTypingTarget = (el) =>
    el instanceof HTMLElement && (el.tagName === 'INPUT' || el.tagName === 'SELECT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
  function focusSearch() {
    const dbInput = document.querySelector<HTMLInputElement>('#db-input-q');
    const mobileInput = document.querySelector<HTMLInputElement>('#mobile-search-input');
    if (dbInput) {
      dbInput.focus();
      dbInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      if (mobileMenu?.classList.contains('hidden')) mobileMenu.classList.remove('hidden');
      syncMobileMenuAria();
      if (mobileInput) mobileInput.focus();
    }
  }
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      focusSearch();
      return;
    }
    // "/" fokus search — hanya saat user tidak sedang mengetik di field lain.
    if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey && !isTypingTarget(document.activeElement)) {
      e.preventDefault();
      focusSearch();
    }
  });
</script>
