---
interface Props { title: string; description?: string; activeNav?: string; }
const { title, description = 'Database tarif pajak Indonesia yang terbuka dan bersumber dari regulasi resmi.', activeNav = '' } = Astro.props;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Tarif Pajak ID</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:opsz,wght@14..32,300..900&display=swap" rel="stylesheet" />
  <meta property="og:title" content={title + ' — Tarif Pajak ID'} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    (function() {
      const s = localStorage.getItem('darkMode');
      const d = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (s === 'true' || (s === null && d)) document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="min-h-screen">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-2xl border-b border-slate-200/60 dark:border-slate-800/60">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <!-- Logo -->
      <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label="Tarif Pajak ID home">
        <div class="relative flex h-9 w-9 items-center justify-center rounded-xl bg-slate-900 shadow-sm transition-transform duration-200 group-hover:scale-105 dark:bg-white">
          <svg class="h-5 w-5 text-white dark:text-slate-900" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7 3.5h7.5L19 8v12.5H7V3.5Z" fill="currentColor" opacity="0.9"/>
            <path d="M14.5 3.5V8H19" fill="currentColor" opacity="0.5"/>
            <path d="M9 15.5L15.5 9" stroke="#10B981" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="9.7" cy="9.8" r="1.4" fill="#10B981"/>
            <circle cx="15" cy="15.2" r="1.4" fill="#10B981"/>
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-[15px] font-extrabold tracking-tight text-slate-900 dark:text-white">Tarif Pajak</span>
          <span class="rounded-md bg-emerald-50 px-1.5 py-0.5 font-mono text-[10px] font-bold text-emerald-700 ring-1 ring-emerald-200/80 dark:bg-emerald-950/50 dark:text-emerald-300 dark:ring-emerald-800/60">ID</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        <a href="/" class:list={["nav-link", activeNav === "home" && "active"]}>Beranda</a>
        <a href="/database" class:list={["nav-link", activeNav === "database" && "active"]}>Database</a>
        <a href="/ter-pph-21" class:list={["nav-link", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link", activeNav === "bppu" && "active"]}>BPPU</a>
        <a href="/api-docs" class:list={["nav-link", activeNav === "api" && "active"]}>API</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <a href="/api-docs" class="hidden sm:inline-flex items-center gap-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors duration-200">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          API Docs
        </a>
        <button id="dark-toggle" class="btn-ghost p-2 rounded-xl" aria-label="Toggle dark mode">
          <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
        <button id="mobile-menu-btn" class="btn-ghost p-2 rounded-xl md:hidden" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden border-t border-slate-200/60 bg-white/95 backdrop-blur-xl md:hidden dark:border-slate-800/60 dark:bg-slate-950/95">
      <div class="mx-auto max-w-6xl px-4 py-3 space-y-1">
        <a href="/" class:list={["nav-link w-full", activeNav === "home" && "active"]}>Beranda</a>
        <a href="/database" class:list={["nav-link w-full", activeNav === "database" && "active"]}>Database</a>
        <a href="/ter-pph-21" class:list={["nav-link w-full", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link w-full", activeNav === "bppu" && "active"]}>Kode BPPU</a>
        <a href="/api-docs" class:list={["nav-link w-full", activeNav === "api" && "active"]}>API Reference</a>
      </div>
    </div>
  </header>

  <!-- Main -->
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-16 border-t border-slate-200/60 dark:border-slate-800/60">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Brand -->
        <div class="lg:col-span-1">
          <div class="flex items-center gap-2 mb-3">
            <div class="h-8 w-8 rounded-xl bg-slate-900 dark:bg-white flex items-center justify-center">
              <svg class="h-4 w-4 text-white dark:text-slate-900" viewBox="0 0 24 24" fill="none"><path d="M7 3.5h7.5L19 8v12.5H7V3.5Z" fill="currentColor" opacity="0.9"/><path d="M14.5 3.5V8H19" fill="currentColor" opacity="0.5"/><path d="M9 15.5L15.5 9" stroke="#10B981" stroke-width="1.8" stroke-linecap="round"/><circle cx="9.7" cy="9.8" r="1.4" fill="#10B981"/><circle cx="15" cy="15.2" r="1.4" fill="#10B981"/></svg>
            </div>
            <span class="text-sm font-extrabold text-slate-900 dark:text-white">Tarif Pajak ID</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed max-w-xs">Database tarif pajak Indonesia yang terbuka. Dibangun untuk konsultan pajak, developer, dan finance team.</p>
          <div class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-amber-50 dark:bg-amber-950/30 px-2.5 py-1.5 text-[11px] font-semibold text-amber-700 dark:text-amber-400 ring-1 ring-amber-200/60 dark:ring-amber-800/40">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Bukan nasihat pajak resmi
          </div>
        </div>

        <!-- Database -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">Database</h4>
          <ul class="space-y-2">
            <li><a href="/ter-pph-21" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">TER PPh 21</a></li>
            <li><a href="/kode-objek-pajak" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">Kode BPPU</a></li>
            <li><a href="/kategori/ppn" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">Tarif PPN</a></li>
            <li><a href="/kategori/pph-21" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">Tarif PPh 21</a></li>
          </ul>
        </div>

        <!-- Developer -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">Developer</h4>
          <ul class="space-y-2">
            <li><a href="/api-docs" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">API Reference</a></li>
            <li><a href="/api/v1/openapi.json" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">OpenAPI Spec</a></li>
            <li><a href="/llms.txt" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">LLMs.txt</a></li>
            <li><a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">GitHub ↗</a></li>
          </ul>
        </div>

        <!-- Sumber -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">Sumber Hukum</h4>
          <ul class="space-y-2">
            <li><a href="https://peraturan.bpk.go.id" target="_blank" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">JDIH BPK ↗</a></li>
            <li><a href="https://pasal.id" target="_blank" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">Pasal.id ↗</a></li>
            <li><a href="https://pajak.go.id" target="_blank" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">DJP Kemenkeu ↗</a></li>
          </ul>
        </div>
      </div>

      <div class="mt-10 pt-6 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-xs text-slate-400 dark:text-slate-500">© 2024–2026 Tarif Pajak ID. Open database, data bersumber dari regulasi resmi.</p>
        <div class="flex items-center gap-4">
          <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" class="text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition-colors" aria-label="GitHub">
            <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>

<script>
  document.getElementById('dark-toggle')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('darkMode', String(document.documentElement.classList.contains('dark')));
  });
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
