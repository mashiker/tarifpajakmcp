---
import '../styles/global.css';
interface Props { title: string; description?: string; activeNav?: string; wide?: boolean; }
const { title, description = 'Database tarif pajak Indonesia yang terbuka dan bersumber dari regulasi resmi.', activeNav = '', wide = false } = Astro.props;
const canonicalURL = Astro.url.href;
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Tarif Pajak ID</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:opsz,wght@14..32,300..900&display=swap" rel="stylesheet" />
  <meta name="theme-color" content="#0E5E58" />
  <meta property="og:title" content={title + ' — Tarif Pajak ID'} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="id_ID" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title + ' — Tarif Pajak ID'} />
  <meta name="twitter:description" content={description} />
  <style is:inline>
    :root {
      /* ── Surfaces — warm neutral "paper" ─────────────────── */
      --bg:              #F7F5F0;
      --bg-rgb:          247, 245, 240;
      --surface:         #FFFFFF;
      --surface-alt:     #F0EDE6;
      --surface-sunken:  #ECE8E0;

      /* ── Borders — hairline, low-contrast ────────────────── */
      --border:          #E2DED5;
      --border-subtle:   #EDE9E1;

      /* ── Text — ink, not pure black ──────────────────────── */
      --text:            #1A1714;
      --text-secondary:  #57514A;
      --text-tertiary:   #6B6358;   /* darkened for WCAG AA */

      /* ── Accent — single resolved teal ───────────────────── */
      --accent:          #0E5E58;
      --accent-hover:    #0A4843;
      --accent-soft:     #E6EFEE;
      --accent-text:     #0E5E58;

      /* ── Status — Stripe-style callout quartet ───────────── */
      --status-active:        #157F4B; --status-active-soft:   #E8F4EC;
      --status-revoked:       #C2362F; --status-revoked-soft:  #FAEAE8;
      --status-changed:       #9A6A04; --status-changed-soft:  #FBF1DC;
      --status-pending:       #57514A; --status-pending-soft:  #ECEAE5;
      --highlight:            #9A6A04; --highlight-soft:       #FBF1DC;

      /* ── Code ────────────────────────────────────────────── */
      --code-bg:         #1F1B17;
      --code-text:       #ECE6DC;

      /* ── Scale ───────────────────────────────────────────── */
      --header-height:   56px;
      --content-max:     1120px;
      --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px;
      --s-5: 24px; --s-6: 32px; --s-7: 48px; --s-8: 64px;
      --radius-sm: 4px; --radius: 6px; --radius-lg: 8px;

      /* ── Type ────────────────────────────────────────────── */
      --font-sans: "Inter", system-ui, -apple-system, sans-serif;
      --font-mono: "IBM Plex Mono", monospace;
    }
  </style>
</head>
<body class="min-h-screen">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Header -->
  <header class="sticky top-0 z-50 backdrop-blur-xl border-b border-[var(--border)]" style="background: rgba(var(--bg-rgb), 0.85);">
    <div class="mx-auto flex h-14 max-w-[var(--content-max)] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">

      <!-- Logo -->
      <a href="/" class="group flex shrink-0 items-center gap-2" aria-label="Tarif Pajak ID home">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--text)] transition-transform duration-200 group-hover:scale-105">
          <svg class="h-4 w-4" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect x="14" y="16" width="36" height="32" rx="3" stroke="var(--accent)" stroke-width="3.5" fill="none"/>
            <line x1="14" y1="26" x2="50" y2="26" stroke="var(--accent)" stroke-width="2.5"/>
            <line x1="32" y1="16" x2="32" y2="48" stroke="var(--accent)" stroke-width="2.5"/>
            <text x="41" y="23.5" font-family="monospace" font-size="8" font-weight="800" fill="var(--accent)" text-anchor="middle">%</text>
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-sm font-bold tracking-tight text-[var(--text)]">Tarif Pajak</span>
          <span class="rounded bg-[var(--accent-soft)] px-1.5 py-0.5 font-mono text-[10px] font-bold text-[var(--accent)]">ID</span>
        </div>
      </a>

      <!-- Search Bar (Desktop) -->
      <div class="hidden md:flex flex-1 max-w-sm">
        <button id="search-trigger" class="w-full flex items-center gap-2 h-9 px-3 rounded-lg border border-[var(--border)] bg-[var(--surface)] text-[var(--text-tertiary)] text-sm hover:border-[var(--accent)] transition-colors duration-200 cursor-pointer" aria-label="Cari tarif pajak">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span class="flex-1 text-left">Cari tarif, kategori, kode...</span>
          <kbd class="hidden lg:inline-flex items-center gap-0.5 rounded border border-[var(--border)] bg-[var(--surface-alt)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--text-tertiary)]">⌘K</kbd>
        </button>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Main">
        <a href="/database" class:list={["nav-link", activeNav === "database" && "active"]}>Database</a>
        <a href="/ter-pph-21" class:list={["nav-link", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link", activeNav === "bppu" && "active"]}>BPPU</a>
        <a href="/api-docs" class:list={["nav-link", activeNav === "api" && "active"]}>API</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-1">
        <button id="mobile-menu-btn" class="btn-ghost p-2 rounded-lg lg:hidden" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden border-t border-[var(--border)] backdrop-blur-xl lg:hidden" style="background: rgba(var(--bg-rgb), 0.97);">
      <div class="mx-auto max-w-[var(--content-max)] px-4 py-3 space-y-1">
        <!-- Mobile Search -->
        <div class="relative mb-2">
          <input id="mobile-search-input" type="text" placeholder="Cari tarif pajak..." aria-label="Cari tarif pajak" class="w-full h-10 pl-9 pr-4 rounded-lg border border-[var(--border)] bg-[var(--surface)] text-sm text-[var(--text)] placeholder:text-[var(--text-tertiary)] focus:outline-none focus:border-[var(--accent)]" />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--text-tertiary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
        <a href="/" class:list={["nav-link w-full", activeNav === "home" && "active"]}>Beranda</a>
        <a href="/database" class:list={["nav-link w-full", activeNav === "database" && "active"]}>Database</a>
        <a href="/ter-pph-21" class:list={["nav-link w-full", activeNav === "ter" && "active"]}>TER PPh 21</a>
        <a href="/kode-objek-pajak" class:list={["nav-link w-full", activeNav === "bppu" && "active"]}>BPPU</a>
        <a href="/api-docs" class:list={["nav-link w-full", activeNav === "api" && "active"]}>API</a>
      </div>
    </div>
  </header>

  <!-- Main -->
  <main id="main-content" tabindex="-1" class:list={[
    "mx-auto w-full px-4 py-6 sm:px-6 sm:py-8 lg:px-8",
    wide ? "max-w-[var(--content-max)]" : "max-w-4xl"
  ]}>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-auto border-t border-[var(--border)]">
    <div class="mx-auto max-w-[var(--content-max)] px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <!-- Left -->
        <div class="flex items-start gap-3">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[var(--text)] mt-0.5">
            <svg class="h-3.5 w-3.5" viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="14" y="16" width="36" height="32" rx="3" stroke="var(--accent)" stroke-width="3.5" fill="none"/><line x1="14" y1="26" x2="50" y2="26" stroke="var(--accent)" stroke-width="2.5"/><line x1="32" y1="16" x2="32" y2="48" stroke="var(--accent)" stroke-width="2.5"/><text x="41" y="23.5" font-family="monospace" font-size="8" font-weight="800" fill="var(--accent)" text-anchor="middle">%</text></svg>
          </div>
          <div>
            <span class="text-xs font-bold text-[var(--text)]">Tarif Pajak ID</span>
            <span class="mx-1.5 text-[var(--text-tertiary)]">·</span>
            <span class="text-xs text-[var(--text-secondary)]">Open database, sumber regulasi resmi.</span>
            <div class="mt-1 inline-flex items-center gap-1 rounded bg-[var(--highlight-soft)] px-1.5 py-0.5 text-[10px] font-semibold text-[var(--highlight)]">
              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Bukan nasihat pajak resmi
            </div>
          </div>
        </div>

        <!-- Right -->
        <div class="flex items-center gap-4 text-xs text-[var(--text-tertiary)]">
          <a href="https://github.com/mashiker/tarifpajakmcp" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text)] transition-colors flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
          <a href="/api-docs" class="hover:text-[var(--text)] transition-colors">API</a>
          <a href="https://peraturan.bpk.go.id" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text)] transition-colors">JDIH BPK ↗</a>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-[var(--border-subtle)]">
        <p class="text-[11px] text-[var(--text-tertiary)]">© 2024–{new Date().getFullYear()} Tarif Pajak ID. Data bersumber dari regulasi resmi Republik Indonesia.</p>
      </div>
    </div>
  </footer>
</body>
</html>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Click outside to close mobile menu
  document.addEventListener('click', (e) => {
    if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
      if (!mobileMenu.contains(e.target as Node) && !mobileMenuBtn?.contains(e.target as Node)) {
        mobileMenu.classList.add('hidden');
      }
    }
  });

  // Search trigger
  document.getElementById('search-trigger')?.addEventListener('click', () => {
    const homeInput = document.querySelector<HTMLInputElement>('#home-search');
    const dbInput = document.querySelector<HTMLInputElement>('#db-search');
    const mobileInput = document.querySelector<HTMLInputElement>('#mobile-search-input');
    const target = homeInput || dbInput;
    if (target) {
      target.focus();
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else if (mobileInput) {
      if (mobileMenu?.classList.contains('hidden')) mobileMenu.classList.remove('hidden');
      mobileInput.focus();
    }
  });

  // ⌘K shortcut — only activate when a search input exists on the page
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      const homeInput = document.querySelector<HTMLInputElement>('#home-search');
      const dbInput = document.querySelector<HTMLInputElement>('#db-search');
      const mobileInput = document.querySelector<HTMLInputElement>('#mobile-search-input');
      if (homeInput || dbInput) {
        e.preventDefault();
        const target = homeInput || dbInput;
        target?.focus();
        target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else if (mobileInput) {
        e.preventDefault();
        if (mobileMenu?.classList.contains('hidden')) mobileMenu.classList.remove('hidden');
        mobileInput.focus();
      }
    }
  });
</script>
